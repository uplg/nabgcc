+#
+# Nabaztag V2 - JTAG recovery via Raspberry Pi 1 GPIO
+#
+# Usage:
+#   sudo openocd -f openocd/nabaztagv2-rpi.cfg
+#
+# Then in another terminal:
+#   arm-none-eabi-gdb bin/Nab.elf -x gdb_load
+#
+# Or to flash directly via OpenOCD:
+#   sudo openocd -f openocd/nabaztagv2-rpi.cfg \
+#     -c "init" \
+#     -c "reset halt" \
+#     -c "flash write_image erase bin/Nab.bin 0x08000000" \
+#     -c "verify_image bin/Nab.bin 0x08000000" \
+#     -c "reset run" \
+#     -c "shutdown"
+#
+
+source [file join [file dirname [info script]] interface/rpi1-gpio.cfg]
+
+# Working area in internal RAM
+set WORKAREASIZE 0x2000
+
+source [file join [file dirname [info script]] target/ml67q4051.cfg]
