 ;@==============================================================================
+;@ DIAG: crash black boxes. On the first undef/prefetch/data trap, dump
+;@ r0-r12, the faulting lr and the originating spsr to a fixed IntRAM
+;@ mailbox, then park. Readable over JTAG:
+;@   undef    @ 0x10003F00 (magic 0xDEADBAD1 at +60)
+;@   prefetch @ 0x10003F40 (magic 0xDEADFE7C at +60)
+;@   data     @ 0x10003FA0 (magic 0xDEADDA7A at +60)
+;@ Layout: +0..+48 r0-r12, +52 lr(fault addr), +56 spsr, +60 magic
 undef_handler:
-  b undef_handler
+  ldr   sp, =0x10003F00
+  stmia sp, {r0-r12}
+  str   lr, [sp, #52]
+  mrs   r0, spsr
+  str   r0, [sp, #56]
+  ldr   r0, =0xDEADBAD1
+  str   r0, [sp, #60]
+1:
+  b 1b
 
 prefetch_handler:
