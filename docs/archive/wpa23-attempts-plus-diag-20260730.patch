+++ b/openocd/interface/rpi1-gpio.cfg
@@ -0,0 +1,47 @@
+#
+# Raspberry Pi 1 Model B - GPIO bit-bang JTAG interface
+# For Nabaztag V2 (ML67Q4051) JTAG recovery
+#
+# Compatible with OpenOCD 0.10+ (Raspbian default) and 0.12+
+#
+# RPi 1 Model B: 26-pin P1 header, bcm2835 SoC
+# Peripheral base: 0x20000000 (RPi 1 only; RPi 2/3 = 0x3F000000)
+#
+# GPIO assignments (active pins on RPi 1 P1 header):
+#
+#   Signal  GPIO  P1 pin  Direction (from RPi perspective)
+#   ------  ----  ------  ---------------------------------
+#   TCK     11    23      Output  - JTAG Clock
+#   TMS     25    22      Output  - JTAG Mode Select
+#   TDI     10    19      Output  - JTAG Data In (RPi -> target)
+#   TDO      9    21      Input   - JTAG Data Out (target -> RPi)
+#   nTRST    7    26      Output  - JTAG TAP Reset (active low)
+#   nSRST    8    24      Output  - System Reset (active low)
+#   GND     --    25      --      - Ground reference
+#
+# These GPIOs avoid UART0 (14/15), I2C (2/3), and SPI0 CE pins.
+#
+# VOLTAGE: ML67Q4051 is 3.3V, RPi GPIO is 3.3V. Direct connection OK.
+#
+
+adapter driver bcm2835gpio
+
+# BCM2835 peripheral base (RPi 1 Model B)
+bcm2835gpio peripheral_base 0x20000000
+
+# Speed coefficients for bcm2835gpio bit-bang timing
+# Format: speed_coeffs <speed_coeff> <speed_offset>
+# These are approximate for RPi 1 (~700MHz ARM11).
+# Actual JTAG clock will be ~100-500 kHz depending on adapter speed setting.
+bcm2835gpio speed_coeffs 113714 28
+
+# Start conservatively slow - can increase after confirming connection
+adapter speed 100
+
+# JTAG signal GPIO assignments
+bcm2835gpio tck_num 11
+bcm2835gpio tms_num 25
+bcm2835gpio tdi_num 10
+bcm2835gpio tdo_num 9
+bcm2835gpio trst_num 7
+bcm2835gpio srst_num 8
