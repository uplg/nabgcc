+/**
+ * @file app_config.c
+ * @brief Configuration system — 208-byte persistent storage in flash
+ */
+#include <stdint.h>
+#include <string.h>
+
+#include "app/app_config.h"
+#include "utils/mem.h"
+#include "utils/debug.h"
+
+/* ---- Private state ---- */
+
+static uint8_t conf_buf[CONF_LENGTH];
+
+/* Shared temp buffer for flash writes — also used by fw_flash.c */
+uint8_t conf_flash_temp[4096] __attribute__((section(".extram")));
+
+/* Factory defaults */
+static const uint8_t conf_defaults[CONF_LENGTH] = {
+    /* 0-40: CONF_SERVERURL = "r.nabaztag.com/vl" */
+    'r','.','n','a','b','a','z','t','a','g','.','c','o','m','/','v','l',0,
+    [18 ... 40] = 0,
+    /* 41: CONF_NETDHCP = 1 */
+    1,
+    /* 42-45: CONF_NETIP = 0.0.0.0 */
+    0, 0, 0, 0,
+    /* 46-49: CONF_NETMASK = 255.255.255.0 */
+    255, 255, 255, 0,
+    /* 50-53: CONF_NETGATEWAY = 0.0.0.0 */
+    0, 0, 0, 0,
+    /* 54-57: CONF_NETDNS = 0.0.0.0 */
+    0, 0, 0, 0,
+    /* 58-89: CONF_WIFISSID (empty) */
+    [58 ... 89] = 0,
+    /* 90: CONF_WIFIAUTH = 0 (open) */
+    0,
+    /* 91: CONF_WIFICRYPT = 0 (none) */
+    0,
+    /* 92-155: CONF_WIFIKEY0 (empty) */
+    [92 ... 155] = 0,
+    /* 156: CONF_PROXYENABLE = 0 */
+    0,
+    /* 157-160: CONF_PROXYIP = 0.0.0.0 */
+    0, 0, 0, 0,
+    /* 161-162: CONF_PROXYPORT = 0 */
+    0, 0,
+    /* 163-168: CONF_LOGIN */
+    [163 ... 168] = 0,
+    /* 169-174: CONF_PWD */
+    [169 ... 174] = 0,
+    /* 175-206: CONF_WIFIPMK */
+    [175 ... 206] = 0,
+    /* 207: CONF_MAGIC */
+    CONF_MAGIC_VAL
+};
+
+/* ---- Implementation ---- */
+
+void conf_init(void)
+{
+    read_uc_flash(0, conf_buf, CONF_LENGTH);
+
+    if (conf_buf[CONF_MAGIC] != CONF_MAGIC_VAL) {
+        DBG_MAIN("conf: invalid magic, resetting to defaults\r\n");
+        conf_reset();
+    }
+}
+
+void conf_save(void)
+{
+    __disable_interrupt();
+    write_uc_flash(0, conf_buf, CONF_LENGTH, conf_flash_temp);
+    __enable_interrupt();
+}
+
+void conf_reset(void)
+{
+    memcpy(conf_buf, conf_defaults, CONF_LENGTH);
+    conf_save();
+}
+
+const uint8_t *conf_get(int32_t i, int32_t len)
+{
+    if (i < 0 || i + len > CONF_LENGTH)
+        return NULL;
+    return &conf_buf[i];
+}
+
+const char *conf_get_str(int32_t i, int32_t max_len)
+{
+    if (i < 0 || i + max_len > CONF_LENGTH)
+        return "";
+    /* Ensure null termination */
+    conf_buf[i + max_len - 1] = '\0';
+    return (const char *)&conf_buf[i];
+}
+
+uint8_t conf_get_byte(int32_t i)
+{
+    if (i < 0 || i >= CONF_LENGTH)
+        return 0;
+    return conf_buf[i];
+}
+
+void conf_get_ip(int32_t i, uint8_t *out)
+{
+    if (i < 0 || i + 4 > CONF_LENGTH) {
+        memset(out, 0, 4);
+        return;
+    }
+    memcpy(out, &conf_buf[i], 4);
+}
+
+uint16_t conf_get_port(int32_t i)
+{
+    if (i < 0 || i + 2 > CONF_LENGTH)
+        return 0;
+    return ((uint16_t)conf_buf[i] << 8) | conf_buf[i + 1];
+}
+
+void conf_set(int32_t i, const uint8_t *val, int32_t len)
+{
+    if (i < 0 || i + len > CONF_LENGTH || !val)
+        return;
+    memcpy(&conf_buf[i], val, len);
+}
+
+void conf_set_str(int32_t i, const char *val, int32_t max_len)
+{
+    if (i < 0 || i + max_len > CONF_LENGTH || !val)
+        return;
+    int32_t slen = strlen(val);
+    if (slen >= max_len)
+        slen = max_len - 1;
+    memcpy(&conf_buf[i], val, slen);
+    memset(&conf_buf[i + slen], 0, max_len - slen);
+}
+
+void conf_set_byte(int32_t i, uint8_t val)
+{
+    if (i < 0 || i >= CONF_LENGTH)
+        return;
+    conf_buf[i] = val;
+}
+
+void conf_set_ip(int32_t i, const uint8_t *ip)
+{
+    if (i < 0 || i + 4 > CONF_LENGTH || !ip)
+        return;
+    memcpy(&conf_buf[i], ip, 4);
+}
+
+void conf_set_port(int32_t i, uint16_t port)
+{
+    if (i < 0 || i + 2 > CONF_LENGTH)
+        return;
+    conf_buf[i]     = (port >> 8) & 0xFF;
+    conf_buf[i + 1] = port & 0xFF;
+}
+
+uint8_t *conf_raw(void)
+{
+    return conf_buf;
+}
