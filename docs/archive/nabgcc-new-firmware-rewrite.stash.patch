diff --git a/src/utils/debug.c b/src/utils/debug.c
index afbeb9e..9a8397a 100644
--- a/src/utils/debug.c
+++ b/src/utils/debug.c
@@ -1,6 +1,98 @@
 #include <string.h>
 
+#include <stdint.h>
+#include <stdio.h>
+
 #include "common.h"
 #include "utils/debug.h"
 
 char dbg_buffer[DBG_BUFFER_LENGTH];
+
+static uint8_t dbg_ring_buffer[DBG_RING_BUFFER_LENGTH];
+static uint32_t dbg_ring_head;
+static uint32_t dbg_ring_len;
+
+static void debug_log_append_byte(uint8_t value)
+{
+  if(dbg_ring_len < DBG_RING_BUFFER_LENGTH) {
+    dbg_ring_buffer[(dbg_ring_head + dbg_ring_len) % DBG_RING_BUFFER_LENGTH] = value;
+    dbg_ring_len++;
+  } else {
+    dbg_ring_buffer[dbg_ring_head] = value;
+    dbg_ring_head = (dbg_ring_head + 1) % DBG_RING_BUFFER_LENGTH;
+  }
+}
+
+static void debug_log_append_raw(const uint8_t *data, uint32_t len)
+{
+  uint32_t i;
+
+  if(data == NULL) return;
+  for(i=0;i<len;i++)
+    debug_log_append_byte(data[i]);
+}
+
+void debug_log_emit(const char *str)
+{
+  if(str == NULL) return;
+  debug_log_append_raw((const uint8_t *)str, strlen(str));
+}
+
+void debug_log_emit_uart(const char *str)
+{
+  debug_log_emit(str);
+  if(str != NULL)
+    putst_uart((uint8_t *)str);
+}
+
+void debug_log_text_buffer(const uint8_t *data, uint32_t len)
+{
+  uint32_t i;
+
+  if(data == NULL) return;
+  for(i=0;i<len;i++) {
+    uint8_t c = data[i];
+    if((c >= 32) && (c <= 126))
+      debug_log_append_byte(c);
+    else if((c == '\r') || (c == '\n') || (c == '\t'))
+      debug_log_append_byte(c);
+    else
+      debug_log_append_byte('.');
+  }
+}
+
+void debug_log_emit_int(int32_t value)
+{
+  char buffer[16];
+
+  sprintf(buffer, "%ld", (long)value);
+  debug_log_emit(buffer);
+}
+
+void debug_log_emit_hex(int32_t value)
+{
+  char buffer[16];
+
+  sprintf(buffer, "%08lx", (unsigned long)value);
+  debug_log_emit(buffer);
+}
+
+void debug_log_reset(void)
+{
+  dbg_ring_head = 0;
+  dbg_ring_len = 0;
+}
+
+uint32_t debug_log_read(uint8_t *dst, uint32_t offset, uint32_t len)
+{
+  uint32_t i;
+
+  if((dst == NULL) || (offset >= dbg_ring_len)) return 0;
+  if(offset + len > dbg_ring_len)
+    len = dbg_ring_len - offset;
+
+  for(i=0;i<len;i++)
+    dst[i] = dbg_ring_buffer[(dbg_ring_head + offset + i) % DBG_RING_BUFFER_LENGTH];
+
+  return len;
+}
