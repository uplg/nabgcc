+    "<input type=file name=fw>"
+    "<button type=submit class=btn>Upload</button>"
+    "</form>"
+    "<script>"
+    "fetch('/api/scan').then(r=>r.json()).then(d=>{"
+    "var s=document.querySelector('select[name=w]');"
+    "d.forEach(n=>{var o=document.createElement('option');"
+    "o.value=n.s;o.textContent=n.s+' ('+n.r+'dBm)';s.appendChild(o)})"
+    "}).catch(e=>{})"
+    "</script>"
+    "</body></html>";
+
+/* ---- Static pages ---- */
+
+const char page_done[] =
+    "<!DOCTYPE html><html><head><meta charset=utf-8>"
+    "<meta name=viewport content='width=device-width,initial-scale=1'>"
+    "<title>Nabaztag</title></head><body>"
+    "<h2>Settings Applied</h2>"
+    "<p>The device is reconnecting with new settings.</p>"
+    "<p>If you lose connection, reconnect to the new network.</p>"
+    "</body></html>";
+
+const char page_firmware[] =
+    "<!DOCTYPE html><html><head><meta charset=utf-8>"
+    "<meta name=viewport content='width=device-width,initial-scale=1'>"
+    "<title>Firmware Upload</title></head><body>"
+    "<h2>Firmware Upload</h2>"
+    "<form method=post action=/c enctype=multipart/form-data>"
+    "<input type=file name=fw>"
+    "<button type=submit>Upload</button>"
+    "</form></body></html>";
+
+const char page_error[] =
+    "<!DOCTYPE html><html><head><meta charset=utf-8>"
+    "<title>Error</title></head><body>"
+    "<h2>Error</h2><p>Bad request.</p>"
+    "</body></html>";
+
+const char page_debug[] =
+    "<!DOCTYPE html><html><head><meta charset=utf-8>"
+    "<meta name=viewport content='width=device-width,initial-scale=1'>"
+    "<title>Debug</title>"
+    "<style>pre{background:#222;color:#0f0;padding:8px;font-size:11px;overflow:auto;max-height:80vh}</style>"
+    "</head><body>"
+    "<h2>Debug Log</h2><pre id=log>Loading...</pre>"
+    "<script>"
+    "fetch('/api/status').then(r=>r.json()).then(d=>{"
+    "document.getElementById('log').textContent=JSON.stringify(d,null,1)"
+    "}).catch(e=>{document.getElementById('log').textContent='Error'})"
+    "</script></body></html>";
+
+/* ---- Template substitution engine ---- */
+
+/**
+ * Replace first occurrence of marker in src with value, writing to dst.
+ * Returns bytes written. Does NOT null-terminate (caller handles).
+ */
+static int32_t tpl_replace(char *dst, int32_t dstsize,
+                           const char *src, int32_t srclen,
+                           const char *marker, const char *value)
+{
+    const char *pos;
+    int32_t mlen, vlen, before, after, total;
+
+    mlen = (int32_t)strlen(marker);
+    vlen = (int32_t)strlen(value);
+    pos = strstr(src, marker);
+
+    if (!pos) {
+        /* No match — copy src as-is */
+        if (srclen > dstsize)
+            srclen = dstsize;
+        memcpy(dst, src, srclen);
+        return srclen;
+    }
+
+    before = (int32_t)(pos - src);
+    after = srclen - before - mlen;
+    total = before + vlen + after;
+    if (total > dstsize)
+        return -1; /* won't fit */
+
+    memcpy(dst, src, before);
+    memcpy(dst + before, value, vlen);
+    memcpy(dst + before + vlen, pos + mlen, after);
+    return total;
+}
+
+/**
+ * Apply all substitutions. Uses double-buffering between buf and tmp.
+ */
+static int32_t tpl_apply(char *buf, int32_t bufsize, char *tmp,
+                         const char *src, int32_t srclen,
+                         const char **markers, const char **values,
+                         int32_t count)
+{
+    int32_t i, len;
+    const char *in;
+    char *out;
+
+    /* Copy src into buf initially */
+    if (srclen >= bufsize)
+        srclen = bufsize - 1;
+    memcpy(buf, src, srclen);
+    len = srclen;
+
+    for (i = 0; i < count; i++) {
+        /* Replace all occurrences of markers[i] */
+        in = buf;
+        out = tmp;
+        len = tpl_replace(tmp, bufsize, buf, len, markers[i], values[i]);
+        if (len < 0) {
+            /* Overflow — truncate */
+            len = srclen;
+            break;
+        }
+        /* Swap: copy tmp back to buf */
+        memcpy(buf, tmp, len);
+    }
+
+    buf[len] = '\0';
+    return len;
+}
+
+/* ---- Public: render index page ---- */
+
+/* Temp buffer for template rendering. Shared with response — caller
+ * must ensure no concurrent use. Placed in ExtRAM region. */
+static char render_buf[3072] __attribute__((section(".extram")));
+static char render_tmp[3072] __attribute__((section(".extram")));
+
+int32_t http_page_render_index(char *buf, int32_t bufsize)
+{
+    char ip_str[16], mask_str[16], gw_str[16], dns_str[16];
+    char mac_str[20], proxy_str[24];
+    uint8_t ip[4];
+    int32_t len;
+
+    /* Format IP strings from config */
+    conf_get_ip(CONF_NETIP, ip);
+    snprintf(ip_str, sizeof(ip_str), "%u.%u.%u.%u", ip[0], ip[1], ip[2], ip[3]);
+
+    conf_get_ip(CONF_NETMASK, ip);
+    snprintf(mask_str, sizeof(mask_str), "%u.%u.%u.%u", ip[0], ip[1], ip[2], ip[3]);
+
+    conf_get_ip(CONF_NETGATEWAY, ip);
+    snprintf(gw_str, sizeof(gw_str), "%u.%u.%u.%u", ip[0], ip[1], ip[2], ip[3]);
+
+    conf_get_ip(CONF_NETDNS, ip);
+    snprintf(dns_str, sizeof(dns_str), "%u.%u.%u.%u", ip[0], ip[1], ip[2], ip[3]);
+
+    snprintf(mac_str, sizeof(mac_str), "%02X:%02X:%02X:%02X:%02X:%02X",
+             net_mac[0], net_mac[1], net_mac[2],
+             net_mac[3], net_mac[4], net_mac[5]);
+
+    /* Proxy string */
+    if (conf_get_byte(CONF_PROXYENABLE)) {
+        conf_get_ip(CONF_PROXYIP, ip);
+        snprintf(proxy_str, sizeof(proxy_str), "%u.%u.%u.%u:%u",
+                 ip[0], ip[1], ip[2], ip[3], conf_get_port(CONF_PROXYPORT));
+    } else {
+        proxy_str[0] = '\0';
+    }
+
+    /* Radio button checked attributes */
+    uint8_t crypt = conf_get_byte(CONF_WIFICRYPT);
+    const char *cn = (crypt == 0) ? "checked" : "";
+    const char *cw = (crypt == IEEE80211_CRYPT_WEP) ? "checked" : "";
+    const char *cp = (crypt >= IEEE80211_CRYPT_WPA) ? "checked" : "";
+
+    uint8_t dhcp = conf_get_byte(CONF_NETDHCP);
+    const char *don = dhcp ? "checked" : "";
+    const char *doff = dhcp ? "" : "checked";
+
+    const char *markers[] = {
+        "{{SSID}}", "{{IP}}", "{{MASK}}", "{{GW}}", "{{DNS}}",
+        "{{SERVER}}", "{{MAC}}", "{{VER}}", "{{PROXY}}",
+        "{{CRYPT_NONE}}", "{{CRYPT_WEP}}", "{{CRYPT_WPA}}",
+        "{{DHCP_ON}}", "{{DHCP_OFF}}"
+    };
+    const char *values[] = {
+        conf_wifi_ssid(), ip_str, mask_str, gw_str, dns_str,
+        conf_server_url(), mac_str, FW_VERSION, proxy_str,
+        cn, cw, cp, don, doff
+    };
+
+    int32_t use_size = bufsize;
+    if (use_size > (int32_t)sizeof(render_buf))
+        use_size = (int32_t)sizeof(render_buf);
+
+    len = tpl_apply(render_buf, use_size, render_tmp,
+                    page_index_tpl, (int32_t)sizeof(page_index_tpl) - 1,
+                    markers, values, 14);
+
+    if (len > 0 && len < bufsize) {
+        memcpy(buf, render_buf, len);
+        buf[len] = '\0';
+    } else {
+        /* Fallback: copy template as-is */
+        len = (int32_t)sizeof(page_index_tpl) - 1;
+        if (len >= bufsize)
+            len = bufsize - 1;
+        memcpy(buf, page_index_tpl, len);
+        buf[len] = '\0';
+    }
+
+    return len;
+}
diff --git a/src/app/http/http_server.c b/src/app/http/http_server.c
new file mode 100644
index 0000000..69da4bb
--- /dev/null
+++ b/src/app/http/http_server.c
@@ -0,0 +1,470 @@
+/**
+ * @file http_server.c
+ * @brief HTTP/1.0 server — parse requests, dispatch to handler
+ *
+ * Max 2 concurrent connections. 2048-byte rx buffer per slot.
+ * All static allocation (no malloc). ExtRAM-resident buffers.
+ */
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "app/http/http_server.h"
+#include "app/net/net_tcp.h"
+#include "app/net/net_core.h"
+#include "utils/debug.h"
+
+/* ---- Constants ---- */
+
+#define HTTP_MAX_CONN    2
+#define HTTP_BUF_SIZE    2048
+#define HTTP_HDR_END     "\r\n\r\n"
+
+/* ---- Per-connection state ---- */
+
+enum {
+    SLOT_FREE = 0,
+    SLOT_HEADER,       /* accumulating header */
+    SLOT_BODY,         /* accumulating body   */
+    SLOT_DONE          /* request dispatched  */
+};
+
+struct http_slot {
+    struct tcp_conn *conn;
+    uint8_t  buf[HTTP_BUF_SIZE];
+    uint32_t rx_len;
+    uint32_t content_len;
+    uint32_t header_len;
+    int32_t  state;
+};
+
+/* ---- Static state ---- */
+
+static struct http_slot slots[HTTP_MAX_CONN] __attribute__((section(".extram")));
+static struct tcp_conn *srv_conn;
+static http_handler_t   srv_handler;
+static uint16_t         srv_port;
+
+/* Large body buffer (registered externally, e.g. for firmware uploads) */
+static uint8_t  *large_body_buf;
+static uint32_t  large_body_bufsize;
+static uint32_t  large_body_rx_len;      /* bytes written into large_body_buf */
+static int32_t   large_body_slot = -1;   /* slot index using the large body, or -1 */
+
+/* ---- Helpers ---- */
+
+static int32_t hex_digit(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    return -1;
+}
+
+void http_url_decode(char *str)
+{
+    char *r = str, *w = str;
+    while (*r) {
+        if (*r == '+') {
+            *w++ = ' ';
+            r++;
+        } else if (*r == '%' && r[1] && r[2]) {
+            int32_t hi = hex_digit(r[1]);
+            int32_t lo = hex_digit(r[2]);
+            if (hi >= 0 && lo >= 0) {
+                *w++ = (char)((hi << 4) | lo);
+                r += 3;
+            } else {
+                *w++ = *r++;
+            }
+        } else {
+            *w++ = *r++;
+        }
+    }
+    *w = '\0';
+}
+
+int32_t http_parse_query(char *uri, struct http_param *params, int32_t max_params)
+{
+    int32_t n = 0;
+    char *q = NULL;
+    uint32_t i;
+
+    /* Find '?' separator */
+    for (i = 0; uri[i]; i++) {
+        if (uri[i] == '?') {
+            uri[i] = '\0';
+            q = &uri[i + 1];
+            break;
+        }
+    }
+    if (!q || !*q)
+        return 0;
+
+    while (*q && n < max_params) {
+        params[n].key = q;
+        params[n].value = "";
+
+        /* Find '=' or '&' */
+        while (*q && *q != '=' && *q != '&')
+            q++;
+
+        if (*q == '=') {
+            *q++ = '\0';
+            params[n].value = q;
+            while (*q && *q != '&')
+                q++;
+            if (*q == '&')
+                *q++ = '\0';
+        } else if (*q == '&') {
+            *q++ = '\0';
+        }
+
+        /* URL-decode value in-place */
+        http_url_decode((char *)params[n].value);
+        n++;
+    }
+
+    return n;
+}
+
+/* ---- Slot management ---- */
+
+static struct http_slot *slot_alloc(struct tcp_conn *conn)
+{
+    int32_t i;
+    for (i = 0; i < HTTP_MAX_CONN; i++) {
+        if (slots[i].state == SLOT_FREE) {
+            memset(&slots[i], 0, sizeof(struct http_slot));
+            slots[i].conn = conn;
+            slots[i].state = SLOT_HEADER;
+            return &slots[i];
+        }
+    }
+    return NULL;
+}
+
+static struct http_slot *slot_find(struct tcp_conn *conn)
+{
+    int32_t i;
+    for (i = 0; i < HTTP_MAX_CONN; i++) {
+        if (slots[i].conn == conn && slots[i].state != SLOT_FREE)
+            return &slots[i];
+    }
+    return NULL;
+}
+
+static void slot_free(struct http_slot *s)
+{
+    /* Release large body buffer if this slot was using it */
+    int32_t idx = (int32_t)(s - slots);
+    if (large_body_slot == idx) {
+        large_body_slot = -1;
+        large_body_rx_len = 0;
+    }
+    s->state = SLOT_FREE;
+    s->conn = NULL;
+}
+
+/* ---- Request parsing ---- */
+
+/**
+ * Try to parse a complete HTTP request from slot buffer.
+ * Returns 1 if request is complete, 0 if need more data.
+ * Fills out req on success.
+ */
+static int32_t try_parse(struct http_slot *s, struct http_request *req)
+{
+    char *buf = (char *)s->buf;
+    char *hdr_end;
+    char *p;
+    uint32_t i;
+
+    if (s->state == SLOT_HEADER) {
+        /* Look for end of headers */
+        buf[s->rx_len < HTTP_BUF_SIZE ? s->rx_len : HTTP_BUF_SIZE - 1] = '\0';
+        hdr_end = strstr(buf, HTTP_HDR_END);
+        if (!hdr_end)
+            return 0;
+
+        s->header_len = (uint32_t)(hdr_end - buf) + 4;
+
+        /* Parse method */
+        p = buf;
+        i = 0;
+        while (*p && *p != ' ' && i < sizeof(req->method) - 1)
+            req->method[i++] = *p++;
+        req->method[i] = '\0';
+
+        /* Skip space */
+        while (*p == ' ') p++;
+
+        /* Parse URI */
+        i = 0;
+        while (*p && *p != ' ' && *p != '\r' && i < sizeof(req->uri) - 1)
+            req->uri[i++] = *p++;
+        req->uri[i] = '\0';
+
+        /* Find Content-Length */
+        s->content_len = 0;
+        {
+            const char *cl = "Content-Length:";
+            char *found = strstr(buf, cl);
+            if (!found) {
+                cl = "content-length:";
+                found = strstr(buf, cl);
+            }
+            if (found) {
+                found += 15; /* strlen("Content-Length:") */
+                while (*found == ' ') found++;
+                s->content_len = 0;
+                while (*found >= '0' && *found <= '9') {
+                    s->content_len = s->content_len * 10 + (*found - '0');
+                    found++;
+                }
+            }
+        }
+
+        /* Check if body fits in slot buffer or needs large body buffer */
+        if (s->content_len > HTTP_BUF_SIZE - s->header_len) {
+            /* Body too large for slot buffer */
+            if (large_body_buf && large_body_slot < 0 &&
+                s->content_len <= large_body_bufsize) {
+                /* Use the large body buffer */
+                int32_t slot_idx = (int32_t)(s - slots);
+                large_body_slot = slot_idx;
+                large_body_rx_len = 0;
+
+                /* Copy any body bytes already received into large buffer */
+                if (s->rx_len > s->header_len) {
+                    uint32_t existing = s->rx_len - s->header_len;
+                    if (existing > s->content_len)
+                        existing = s->content_len;
+                    memcpy(large_body_buf, &s->buf[s->header_len], existing);
+                    large_body_rx_len = existing;
+                }
+            } else {
+                /* No large buffer available — clamp to slot */
+                s->content_len = HTTP_BUF_SIZE - s->header_len;
+            }
+        }
+
+        s->state = SLOT_BODY;
+    }
+
+    /* SLOT_BODY: check if we have enough body data */
+    if (s->state == SLOT_BODY) {
+        int32_t slot_idx = (int32_t)(s - slots);
+        uint32_t body_received;
+
+        if (large_body_slot == slot_idx) {
+            /* Using large body buffer */
+            body_received = large_body_rx_len;
+        } else {
+            body_received = 0;
+            if (s->rx_len > s->header_len)
+                body_received = s->rx_len - s->header_len;
+        }
+
+        if (body_received < s->content_len)
+            return 0; /* need more data */
+
+        /* Request complete */
+        if (large_body_slot == slot_idx) {
+            req->body = (char *)large_body_buf;
+            req->body_len = large_body_rx_len;
+            if (large_body_rx_len < large_body_bufsize)
+                large_body_buf[large_body_rx_len] = '\0';
+        } else {
+            req->body = (char *)&s->buf[s->header_len];
+            req->body_len = s->content_len;
+            if (s->header_len + s->content_len < HTTP_BUF_SIZE)
+                s->buf[s->header_len + s->content_len] = '\0';
+        }
+        req->conn = s->conn;
+        req->slot = slot_idx;
+        s->state = SLOT_DONE;
+        return 1;
+    }
+
+    return 0;
+}
+
+/* ---- Response ---- */
+
+static const char *status_text(int32_t code)
+{
+    switch (code) {
+    case 200: return "OK";
+    case 204: return "No Content";
+    case 302: return "Found";
+    case 400: return "Bad Request";
+    case 404: return "Not Found";
+    case 405: return "Method Not Allowed";
+    case 413: return "Payload Too Large";
+    case 500: return "Internal Server Error";
+    default:  return "OK";
+    }
+}
+
+void http_respond(struct http_request *req, int32_t status_code,
+                  const char *content_type, const char *body, uint32_t body_len)
+{
+    char hdr[192];
+    int32_t hlen;
+
+    hlen = snprintf(hdr, sizeof(hdr),
+        "HTTP/1.0 %d %s\r\n"
+        "Content-Type: %s\r\n"
+        "Content-Length: %u\r\n"
+        "Connection: close\r\n"
+        "\r\n",
+        (int)status_code, status_text(status_code),
+        content_type, (unsigned)body_len);
+
+    if (hlen > 0 && req->conn) {
+        tcp_write(req->conn, (const uint8_t *)hdr, (uint32_t)hlen);
+        if (body && body_len > 0)
+            tcp_write(req->conn, (const uint8_t *)body, body_len);
+        tcp_close(req->conn);
+    }
+
+    /* Free the slot */
+    if (req->slot >= 0 && req->slot < HTTP_MAX_CONN)
+        slot_free(&slots[req->slot]);
+}
+
+void http_respond_html(struct http_request *req, int32_t status_code, const char *html)
+{
+    http_respond(req, status_code, "text/html;charset=utf-8",
+                 html, (uint32_t)strlen(html));
+}
+
+void http_respond_json(struct http_request *req, int32_t status_code, const char *json)
+{
+    http_respond(req, status_code, "application/json",
+                 json, (uint32_t)strlen(json));
+}
+
+/* ---- TCP callback ---- */
+
+static void server_tcp_cb(struct tcp_conn *conn, int32_t event,
+                          const uint8_t *data, uint32_t len)
+{
+    struct http_slot *s;
+
+    switch (event) {
+
+    case TCP_CONNECTED:
+        s = slot_alloc(conn);
+        if (!s) {
+            /* No free slots, reject — re-listen since socket was consumed */
+            tcp_close(conn);
+            srv_conn = tcp_listen(srv_port, server_tcp_cb);
+            return;
+        }
+        break;
+
+    case TCP_DATA:
+        s = slot_find(conn);
+        if (!s) {
+            tcp_close(conn);
+            return;
+        }
+        {
+            int32_t slot_idx = (int32_t)(s - slots);
+
+            /* If this slot is using the large body buffer AND headers
+             * are already parsed (SLOT_BODY state), route incoming data
+             * directly into the large buffer instead of the 2KB slot. */
+            if (s->state == SLOT_BODY && large_body_slot == slot_idx) {
+                uint32_t remain = s->content_len - large_body_rx_len;
+                uint32_t copy = (len < remain) ? len : remain;
+                if (copy > 0 && large_body_rx_len + copy <= large_body_bufsize) {
+                    memcpy(&large_body_buf[large_body_rx_len], data, copy);
+                    large_body_rx_len += copy;
+                }
+            } else {
+                /* Normal path: append to slot buffer */
+                if (s->rx_len + len > HTTP_BUF_SIZE)
+                    len = HTTP_BUF_SIZE - s->rx_len;
+                if (len > 0) {
+                    memcpy(&s->buf[s->rx_len], data, len);
+                    s->rx_len += len;
+                }
+            }
+        }
+        /* Try to parse / check completion */
+        {
+            struct http_request req;
+            memset(&req, 0, sizeof(req));
+            if (try_parse(s, &req)) {
+                if (srv_handler)
+                    srv_handler(&req);
+                else
+                    http_respond_html(&req, 404, "No handler");
+            }
+        }
+        break;
+
+    case TCP_CLOSED:
+        s = slot_find(conn);
+        if (s)
+            slot_free(s);
+        /* Listener was consumed on SYN — re-listen for new connections */
+        srv_conn = tcp_listen(srv_port, server_tcp_cb);
+        break;
+
+    default:
+        break;
+    }
+}
+
+/* ---- Public API ---- */
+
+void http_server_start(uint16_t port)
+{
+    int32_t i;
+
+    srv_port = port;
+    for (i = 0; i < HTTP_MAX_CONN; i++)
+        slots[i].state = SLOT_FREE;
+
+    large_body_slot = -1;
+    large_body_rx_len = 0;
+
+    srv_conn = tcp_listen(port, server_tcp_cb);
+
+    snprintf(dbg_buffer, DBG_BUFFER_LENGTH, "http: listening on port %u\r\n",
+             (unsigned)port);
+    DBG_MAIN(dbg_buffer);
+}
+
+void http_server_stop(void)
+{
+    int32_t i;
+
+    if (srv_conn) {
+        tcp_close(srv_conn);
+        srv_conn = NULL;
+    }
+
+    for (i = 0; i < HTTP_MAX_CONN; i++) {
+        if (slots[i].state != SLOT_FREE && slots[i].conn)
+            tcp_close(slots[i].conn);
+        slots[i].state = SLOT_FREE;
+    }
+}
+
+void http_server_set_handler(http_handler_t handler)
+{
+    srv_handler = handler;
+}
+
+void http_server_set_large_body(uint8_t *buf, uint32_t bufsize)
+{
+    large_body_buf = buf;
+    large_body_bufsize = bufsize;
+    large_body_slot = -1;
+    large_body_rx_len = 0;
+}
diff --git a/src/app/net/net_arp.c b/src/app/net/net_arp.c
new file mode 100644
index 0000000..6f13e7b
--- /dev/null
+++ b/src/app/net/net_arp.c
@@ -0,0 +1,297 @@
+/**
+ * @file net_arp.c
+ * @brief ARP — Address Resolution Protocol (RFC 826)
+ *
+ * Handles ARP request/reply exchange and maintains a small cache of
+ * IP→MAC bindings.  For off-subnet destinations the gateway's MAC is
+ * resolved instead.
+ *
+ * ARP packet layout (within LLC/SNAP frame, offset 8):
+ *   [0..1]  Hardware type  (0x0001 = Ethernet)
+ *   [2..3]  Protocol type  (0x0800 = IPv4)
+ *   [4]     Hardware addr len (6)
+ *   [5]     Protocol addr len (4)
+ *   [6..7]  Operation (1=request, 2=reply)
+ *   [8..13] Sender MAC
+ *   [14..17] Sender IP
+ *   [18..23] Target MAC
+ *   [24..27] Target IP
+ */
+
+#include <stdint.h>
+#include <string.h>
+#include "app/net/net_core.h"
+#include "app/net/net_arp.h"
+#include "utils/debug.h"
+
+/* ------------------------------------------------------------------ */
+/* Static state                                                        */
+/* ------------------------------------------------------------------ */
+
+static struct arp_entry   arp_cache[ARP_CACHE_SIZE];
+static struct arp_pending arp_pending[ARP_PENDING_SIZE];
+
+/* ---- ARP packet offsets (relative to start of LLC/SNAP frame) ---- */
+
+#define ARP_OFF         LLC_SNAP_LEN    /* 8 */
+#define ARP_HW_TYPE     (ARP_OFF + 0)
+#define ARP_PROTO_TYPE  (ARP_OFF + 2)
+#define ARP_HW_LEN      (ARP_OFF + 4)
+#define ARP_PROTO_LEN   (ARP_OFF + 5)
+#define ARP_OP          (ARP_OFF + 6)
+#define ARP_SHA         (ARP_OFF + 8)   /* Sender Hardware Address */
+#define ARP_SPA         (ARP_OFF + 14)  /* Sender Protocol Address */
+#define ARP_THA         (ARP_OFF + 18)  /* Target Hardware Address */
+#define ARP_TPA         (ARP_OFF + 24)  /* Target Protocol Address */
+#define ARP_FRAME_LEN   (ARP_OFF + 28)  /* Total frame size */
+
+/* ------------------------------------------------------------------ */
+/* Internal helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Look up an IP in the ARP cache.
+ * @return Pointer to the cache entry, or NULL if not found.
+ */
+static struct arp_entry *cache_lookup(const uint8_t *ip)
+{
+    int i;
+    for (i = 0; i < ARP_CACHE_SIZE; i++) {
+        if (arp_cache[i].valid && memcmp(arp_cache[i].ip, ip, 4) == 0)
+            return &arp_cache[i];
+    }
+    return (struct arp_entry *)0;
+}
+
+/**
+ * Insert or update an entry in the ARP cache.
+ * If the cache is full the oldest entry is evicted.
+ */
+static void cache_update(const uint8_t *ip, const uint8_t *mac)
+{
+    struct arp_entry *e;
+    int i;
+    uint32_t oldest_time;
+    int oldest_idx;
+
+    /* Update existing entry */
+    e = cache_lookup(ip);
+    if (e) {
+        memcpy(e->mac, mac, 6);
+        e->timestamp = net_time_s();
+        return;
+    }
+
+    /* Find a free slot */
+    for (i = 0; i < ARP_CACHE_SIZE; i++) {
+        if (!arp_cache[i].valid) {
+            memcpy(arp_cache[i].ip, ip, 4);
+            memcpy(arp_cache[i].mac, mac, 6);
+            arp_cache[i].timestamp = net_time_s();
+            arp_cache[i].valid = 1;
+            return;
+        }
+    }
+
+    /* Evict the oldest entry */
+    oldest_idx = 0;
+    oldest_time = arp_cache[0].timestamp;
+    for (i = 1; i < ARP_CACHE_SIZE; i++) {
+        if (arp_cache[i].timestamp < oldest_time) {
+            oldest_time = arp_cache[i].timestamp;
+            oldest_idx = i;
+        }
+    }
+    memcpy(arp_cache[oldest_idx].ip, ip, 4);
+    memcpy(arp_cache[oldest_idx].mac, mac, 6);
+    arp_cache[oldest_idx].timestamp = net_time_s();
+    arp_cache[oldest_idx].valid = 1;
+}
+
+/**
+ * Send an ARP request for the given IP address.
+ */
+static void arp_send_request(const uint8_t *target_ip)
+{
+    uint8_t frame[ARP_FRAME_LEN];
+
+    /* LLC/SNAP header for ARP (EtherType 0x0806) */
+    memcpy(frame, LLC_SNAP_ARP, LLC_SNAP_LEN);
+
+    /* ARP header */
+    net_put16(frame, ARP_HW_TYPE,    0x0001);   /* Ethernet */
+    net_put16(frame, ARP_PROTO_TYPE, 0x0800);   /* IPv4 */
+    frame[ARP_HW_LEN]    = 6;
+    frame[ARP_PROTO_LEN] = 4;
+    net_put16(frame, ARP_OP, 1);                /* Request */
+
+    /* Sender = us */
+    memcpy(&frame[ARP_SHA], net_mac, 6);
+    memcpy(&frame[ARP_SPA], net_ip, 4);
+
+    /* Target MAC = zero (unknown) */
+    memset(&frame[ARP_THA], 0, 6);
+    memcpy(&frame[ARP_TPA], target_ip, 4);
+
+    net_send(frame, ARP_FRAME_LEN, net_mac_broadcast, 1);
+}
+
+/**
+ * Send an ARP reply to a specific host.
+ */
+static void arp_send_reply(const uint8_t *dst_mac, const uint8_t *dst_ip)
+{
+    uint8_t frame[ARP_FRAME_LEN];
+
+    memcpy(frame, LLC_SNAP_ARP, LLC_SNAP_LEN);
+
+    net_put16(frame, ARP_HW_TYPE,    0x0001);
+    net_put16(frame, ARP_PROTO_TYPE, 0x0800);
+    frame[ARP_HW_LEN]    = 6;
+    frame[ARP_PROTO_LEN] = 4;
+    net_put16(frame, ARP_OP, 2);                /* Reply */
+
+    memcpy(&frame[ARP_SHA], net_mac, 6);
+    memcpy(&frame[ARP_SPA], net_ip, 4);
+    memcpy(&frame[ARP_THA], dst_mac, 6);
+    memcpy(&frame[ARP_TPA], dst_ip, 4);
+
+    net_send(frame, ARP_FRAME_LEN, dst_mac, 1);
+}
+
+/**
+ * Fire all pending callbacks that were waiting for this IP.
+ */
+static void pending_complete(const uint8_t *ip, const uint8_t *mac)
+{
+    int i;
+    for (i = 0; i < ARP_PENDING_SIZE; i++) {
+        if (arp_pending[i].active && memcmp(arp_pending[i].ip, ip, 4) == 0) {
+            arp_pending[i].active = 0;
+            if (arp_pending[i].callback)
+                arp_pending[i].callback(mac, arp_pending[i].ctx);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                          */
+/* ------------------------------------------------------------------ */
+
+void arp_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac)
+{
+    uint16_t op;
+    const uint8_t *sender_ip;
+    const uint8_t *sender_mac;
+    const uint8_t *target_ip;
+
+    if (len < ARP_FRAME_LEN)
+        return;
+
+    /* Validate hardware/protocol types */
+    if (net_get16(data, ARP_HW_TYPE) != 0x0001)
+        return;
+    if (net_get16(data, ARP_PROTO_TYPE) != 0x0800)
+        return;
+
+    op         = net_get16(data, ARP_OP);
+    sender_mac = &data[ARP_SHA];
+    sender_ip  = &data[ARP_SPA];
+    target_ip  = &data[ARP_TPA];
+
+    /* Always update cache with sender info (RFC 826 merge flag) */
+    cache_update(sender_ip, sender_mac);
+
+    if (op == 1) {
+        /* ARP Request — reply if it's asking for our IP */
+        if (memcmp(target_ip, net_ip, 4) == 0) {
+            arp_send_reply(sender_mac, sender_ip);
+        }
+    } else if (op == 2) {
+        /* ARP Reply — complete any pending resolutions */
+        pending_complete(sender_ip, sender_mac);
+    }
+}
+
+void arp_resolve(const uint8_t *ip, arp_callback_t callback, void *ctx)
+{
+    const uint8_t *resolve_ip;
+    struct arp_entry *e;
+    int i;
+
+    if (!ip || !callback)
+        return;
+
+    /* Broadcast addresses resolve to broadcast MAC immediately */
+    if (memcmp(ip, net_ip_broadcast, 4) == 0) {
+        callback(net_mac_broadcast, ctx);
+        return;
+    }
+
+    /* Off-subnet? Resolve the gateway instead. */
+    if (net_is_local(ip)) {
+        resolve_ip = ip;
+    } else {
+        resolve_ip = net_gateway;
+    }
+
+    /* Check cache first */
+    e = cache_lookup(resolve_ip);
+    if (e) {
+        callback(e->mac, ctx);
+        return;
+    }
+
+    /* Queue a pending request */
+    for (i = 0; i < ARP_PENDING_SIZE; i++) {
+        if (!arp_pending[i].active) {
+            memcpy(arp_pending[i].ip, resolve_ip, 4);
+            arp_pending[i].callback  = callback;
+            arp_pending[i].ctx       = ctx;
+            arp_pending[i].timestamp = net_time_s();
+            arp_pending[i].last_sent = net_time_s();
+            arp_pending[i].retries   = 0;
+            arp_pending[i].active    = 1;
+
+            /* Send the first request */
+            arp_send_request(resolve_ip);
+            return;
+        }
+    }
+
+    /* Queue full — call back with NULL (failure) */
+    DBG_MAIN("[arp] pending queue full\r\n");
+    callback((const uint8_t *)0, ctx);
+}
+
+void arp_timer(void)
+{
+    uint32_t now = net_time_s();
+    int i;
+
+    for (i = 0; i < ARP_PENDING_SIZE; i++) {
+        if (!arp_pending[i].active)
+            continue;
+
+        /* Expired? */
+        if (now - arp_pending[i].timestamp >= ARP_TIMEOUT_S) {
+            arp_pending[i].active = 0;
+            if (arp_pending[i].callback)
+                arp_pending[i].callback((const uint8_t *)0, arp_pending[i].ctx);
+            continue;
+        }
+
+        /* Time to retransmit? */
+        if (now - arp_pending[i].last_sent >= ARP_RETRY_INTERVAL) {
+            arp_pending[i].last_sent = now;
+            arp_pending[i].retries++;
+            arp_send_request(arp_pending[i].ip);
+        }
+    }
+}
+
+void arp_reset(void)
+{
+    memset(arp_cache,   0, sizeof(arp_cache));
+    memset(arp_pending, 0, sizeof(arp_pending));
+}
diff --git a/src/app/net/net_core.c b/src/app/net/net_core.c
new file mode 100644
index 0000000..a4869bd
--- /dev/null
+++ b/src/app/net/net_core.c
@@ -0,0 +1,163 @@
+/**
+ * @file net_core.c
+ * @brief Network core — packet dispatch, IP utilities, shared state
+ *
+ * This is the central nervous system of the network stack.  Incoming 802.11
+ * frames (LLC/SNAP encapsulated) arrive via net_rx() and are dispatched by
+ * EtherType.  Outgoing frames go through net_send() → rt2501_send().
+ */
+
+#include <stdint.h>
+#include <string.h>
+#include "app/net/net_core.h"
+#include "app/net/net_arp.h"
+#include "app/net/net_ip.h"
+#include "app/net/net_tcp.h"
+#include "app/net/net_udp.h"
+#include "app/net/net_dns.h"
+#include "usb/rt2501usb.h"
+#include "utils/debug.h"
+
+/* ------------------------------------------------------------------ */
+/* Global network state                                                */
+/* ------------------------------------------------------------------ */
+
+uint8_t net_ip[4];
+uint8_t net_mask[4];
+uint8_t net_gateway[4];
+uint8_t net_dns_server[4];
+uint8_t net_mac[6];
+
+const uint8_t net_ip_zero[4]       = { 0, 0, 0, 0 };
+const uint8_t net_mac_broadcast[6] = { 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF };
+const uint8_t net_ip_broadcast[4]  = { 255, 255, 255, 255 };
+
+/* ------------------------------------------------------------------ */
+/* Initialisation                                                      */
+/* ------------------------------------------------------------------ */
+
+void net_init(void)
+{
+    memset(net_ip,      0, 4);
+    memset(net_mask,    0, 4);
+    memset(net_gateway, 0, 4);
+    memset(net_dns_server, 0, 4);
+
+    /* Copy the hardware MAC from the WiFi driver */
+    memcpy(net_mac, rt2501_mac, 6);
+
+    arp_reset();
+    tcp_reset();
+    udp_reset();
+    dns_reset();
+
+    DBG_MAIN("[net] init done\r\n");
+}
+
+/* ------------------------------------------------------------------ */
+/* Packet send                                                         */
+/* ------------------------------------------------------------------ */
+
+int32_t net_send(const uint8_t *data, uint32_t len,
+                 const uint8_t *dst_mac, int32_t lowrate)
+{
+    return rt2501_send(data, len, dst_mac, lowrate, 0 /* non-blocking */);
+}
+
+/* ------------------------------------------------------------------ */
+/* IP checksum (RFC 1071)                                              */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Standard Internet checksum — one's complement sum of 16-bit words.
+ *
+ * @param data  Buffer to checksum
+ * @param len   Length in bytes (may be odd)
+ * @param init  Initial accumulator (e.g. pseudo-header partial sum)
+ * @return      Checksum in network byte order, ready to write into header
+ */
+uint16_t net_checksum(const uint8_t *data, uint32_t len, uint32_t init)
+{
+    uint32_t sum = init;
+    uint32_t i;
+
+    /* Sum 16-bit words */
+    for (i = 0; i + 1 < len; i += 2) {
+        sum += ((uint32_t)data[i] << 8) | data[i + 1];
+    }
+
+    /* Handle trailing odd byte */
+    if (i < len) {
+        sum += (uint32_t)data[i] << 8;
+    }
+
+    /* Fold 32-bit carry into 16 bits */
+    while (sum >> 16) {
+        sum = (sum & 0xFFFF) + (sum >> 16);
+    }
+
+    /* One's complement */
+    return (uint16_t)(~sum & 0xFFFF);
+}
+
+/* ------------------------------------------------------------------ */
+/* Subnet check                                                        */
+/* ------------------------------------------------------------------ */
+
+int32_t net_is_local(const uint8_t *ip)
+{
+    int i;
+    for (i = 0; i < 4; i++) {
+        if ((ip[i] & net_mask[i]) != (net_ip[i] & net_mask[i]))
+            return 0;
+    }
+    return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Receive dispatch                                                    */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Process a received LLC/SNAP frame.
+ *
+ * Frame layout:
+ *   [0..7]   LLC/SNAP header  (AA AA 03 00 00 00 ET ET)
+ *   [8..]    Payload (IP, ARP, etc.)
+ *
+ * EtherType is at bytes 6–7 of the LLC/SNAP header.
+ */
+void net_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac)
+{
+    uint16_t ethertype;
+
+    if (len < LLC_SNAP_LEN)
+        return;
+
+    ethertype = net_get16(data, LLC_ETHERTYPE_HI);
+
+    switch (ethertype) {
+    case 0x0806:
+        /* ARP */
+        arp_rx(data, len, src_mac);
+        break;
+    case 0x0800:
+        /* IPv4 */
+        ip_rx(data, len, src_mac);
+        break;
+    default:
+        /* Unknown EtherType — silently drop */
+        break;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Periodic timer                                                      */
+/* ------------------------------------------------------------------ */
+
+void net_timer(void)
+{
+    arp_timer();
+    tcp_timer();
+    dns_timer();
+}
diff --git a/src/app/net/net_dhcp.c b/src/app/net/net_dhcp.c
new file mode 100644
index 0000000..0e0067d
--- /dev/null
+++ b/src/app/net/net_dhcp.c
@@ -0,0 +1,488 @@
+/**
+ * @file net_dhcp.c
+ * @brief DHCP client and server (RFC 2131)
+ *
+ * Client: DISCOVER → OFFER → REQUEST → ACK
+ * Server: Listens on port 67, assigns IPs based on client MAC.
+ *
+ * DHCP message layout (within UDP payload):
+ *   [0]       op      (1=BOOTREQUEST, 2=BOOTREPLY)
+ *   [1]       htype   (1=Ethernet)
+ *   [2]       hlen    (6)
+ *   [3]       hops    (0)
+ *   [4..7]    xid     (transaction ID)
+ *   [8..9]    secs    (0)
+ *   [10..11]  flags   (0x8000 = broadcast)
+ *   [12..15]  ciaddr  (client IP, if known)
+ *   [16..19]  yiaddr  (your IP, from server)
+ *   [20..23]  siaddr  (server IP)
+ *   [24..27]  giaddr  (relay agent IP)
+ *   [28..43]  chaddr  (client hardware address, padded to 16)
+ *   [44..107] sname   (server host name, 64 bytes)
+ *   [108..235] file   (boot file name, 128 bytes)
+ *   [236..239] magic cookie (99.130.83.99)
+ *   [240..]   options
+ */
+
+#include <stdint.h>
+#include <string.h>
+#include "app/net/net_core.h"
+#include "app/net/net_ip.h"
+#include "app/net/net_udp.h"
+#include "app/net/net_dhcp.h"
+#include "utils/debug.h"
+
+/* ---- DHCP field offsets (within UDP payload) ---- */
+
+#define DHCP_OP         0
+#define DHCP_HTYPE      1
+#define DHCP_HLEN       2
+#define DHCP_HOPS       3
+#define DHCP_XID        4
+#define DHCP_SECS       8
+#define DHCP_FLAGS      10
+#define DHCP_CIADDR     12
+#define DHCP_YIADDR     16
+#define DHCP_SIADDR     20
+#define DHCP_GIADDR     24
+#define DHCP_CHADDR     28
+#define DHCP_SNAME      44
+#define DHCP_FILE       108
+#define DHCP_COOKIE     236
+#define DHCP_OPTIONS    240
+#define DHCP_MIN_LEN    240     /* Without options */
+
+/* Magic cookie */
+static const uint8_t dhcp_cookie[4] = { 99, 130, 83, 99 };
+
+/* Client hostname */
+static const char dhcp_hostname[] = "Nabaztg";
+
+/* Client transaction ID */
+static uint32_t dhcp_xid = 0;
+
+/* Client state */
+#define DHCP_CLIENT_IDLE       0
+#define DHCP_CLIENT_DISCOVERING 1
+#define DHCP_CLIENT_REQUESTING  2
+#define DHCP_CLIENT_BOUND       3
+
+static int32_t dhcp_client_state = DHCP_CLIENT_IDLE;
+
+/* Offered IP (saved between OFFER and ACK) */
+static uint8_t dhcp_offered_ip[4];
+static uint8_t dhcp_server_ip[4];
+
+/* Server state */
+static int32_t dhcp_server_active = 0;
+
+/* ------------------------------------------------------------------ */
+/* Option helpers                                                      */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Append a DHCP option to the buffer at *off.
+ * Returns the new offset.
+ */
+static uint32_t opt_put(uint8_t *buf, uint32_t off, uint8_t code,
+                        const uint8_t *data, uint8_t len)
+{
+    buf[off++] = code;
+    buf[off++] = len;
+    memcpy(&buf[off], data, len);
+    return off + len;
+}
+
+static uint32_t opt_put_byte(uint8_t *buf, uint32_t off, uint8_t code,
+                             uint8_t val)
+{
+    buf[off++] = code;
+    buf[off++] = 1;
+    buf[off++] = val;
+    return off;
+}
+
+static uint32_t opt_put32(uint8_t *buf, uint32_t off, uint8_t code,
+                          uint32_t val)
+{
+    buf[off++] = code;
+    buf[off++] = 4;
+    buf[off++] = (val >> 24) & 0xFF;
+    buf[off++] = (val >> 16) & 0xFF;
+    buf[off++] = (val >> 8) & 0xFF;
+    buf[off++] = val & 0xFF;
+    return off;
+}
+
+/**
+ * Find a DHCP option in the options area.
+ * Returns pointer to option data (past code+len) or NULL.
+ * Sets *opt_len to the data length.
+ */
+static const uint8_t *opt_find(const uint8_t *options, uint32_t options_len,
+                               uint8_t code, uint8_t *opt_len)
+{
+    uint32_t i = 0;
+
+    while (i < options_len) {
+        uint8_t c = options[i];
+
+        if (c == DHCP_OPT_END)
+            break;
+
+        if (c == 0) { /* Pad */
+            i++;
+            continue;
+        }
+
+        if (i + 1 >= options_len)
+            break;
+
+        {
+            uint8_t l = options[i + 1];
+            if (c == code) {
+                if (opt_len) *opt_len = l;
+                return &options[i + 2];
+            }
+            i += 2 + l;
+        }
+    }
+    return (const uint8_t *)0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Client: build and send messages                                     */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Build the common DHCP header fields.
+ */
+static void dhcp_build_header(uint8_t *msg, uint8_t op)
+{
+    memset(msg, 0, DHCP_MIN_LEN + 64); /* Clear header + some option space */
+
+    msg[DHCP_OP]    = op;
+    msg[DHCP_HTYPE] = 1;   /* Ethernet */
+    msg[DHCP_HLEN]  = 6;
+    msg[DHCP_HOPS]  = 0;
+
+    net_put32(msg, DHCP_XID, dhcp_xid);
+    net_put16(msg, DHCP_FLAGS, 0x8000); /* Broadcast flag */
+
+    /* Client hardware address */
+    memcpy(&msg[DHCP_CHADDR], net_mac, 6);
+
+    /* Magic cookie */
+    memcpy(&msg[DHCP_COOKIE], dhcp_cookie, 4);
+}
+
+static void dhcp_send_discover(void)
+{
+    uint8_t msg[576]; /* Minimum DHCP message size */
+    uint32_t off;
+
+    dhcp_build_header(msg, 1); /* BOOTREQUEST */
+
+    off = DHCP_OPTIONS;
+
+    /* Option 53: DHCP Message Type = DISCOVER */
+    off = opt_put_byte(msg, off, DHCP_OPT_MSGTYPE, DHCP_DISCOVER);
+
+    /* Option 61: Client Identifier (type 1 = Ethernet + MAC) */
+    {
+        uint8_t cid[7];
+        cid[0] = 1; /* Ethernet */
+        memcpy(&cid[1], net_mac, 6);
+        off = opt_put(msg, off, DHCP_OPT_CLIENTID, cid, 7);
+    }
+
+    /* Option 12: Hostname */
+    off = opt_put(msg, off, DHCP_OPT_HOSTNAME,
+                  (const uint8_t *)dhcp_hostname, (uint8_t)strlen(dhcp_hostname));
+
+    /* Option 55: Parameter Request List */
+    {
+        uint8_t req[] = { DHCP_OPT_SUBNET, DHCP_OPT_ROUTER, DHCP_OPT_DNS };
+        off = opt_put(msg, off, DHCP_OPT_REQLIST, req, sizeof(req));
+    }
+
+    /* End */
+    msg[off++] = DHCP_OPT_END;
+
+    /* Pad to minimum */
+    while (off < 300)
+        msg[off++] = 0;
+
+    udp_send(net_ip_broadcast, DHCP_SERVER_PORT, DHCP_CLIENT_PORT,
+             msg, off, net_mac_broadcast);
+
+    dhcp_client_state = DHCP_CLIENT_DISCOVERING;
+    DBG_MAIN("[dhcp] DISCOVER sent\r\n");
+}
+
+static void dhcp_send_request(void)
+{
+    uint8_t msg[576];
+    uint32_t off;
+
+    dhcp_build_header(msg, 1); /* BOOTREQUEST */
+
+    off = DHCP_OPTIONS;
+
+    /* Option 53: DHCP Message Type = REQUEST */
+    off = opt_put_byte(msg, off, DHCP_OPT_MSGTYPE, DHCP_REQUEST);
+
+    /* Option 50: Requested IP Address (reuse option code 50 inline) */
+    msg[off++] = 50;
+    msg[off++] = 4;
+    memcpy(&msg[off], dhcp_offered_ip, 4);
+    off += 4;
+
+    /* Option 54: Server Identifier */
+    msg[off++] = 54;
+    msg[off++] = 4;
+    memcpy(&msg[off], dhcp_server_ip, 4);
+    off += 4;
+
+    /* Option 61: Client Identifier */
+    {
+        uint8_t cid[7];
+        cid[0] = 1;
+        memcpy(&cid[1], net_mac, 6);
+        off = opt_put(msg, off, DHCP_OPT_CLIENTID, cid, 7);
+    }
+
+    /* Option 12: Hostname */
+    off = opt_put(msg, off, DHCP_OPT_HOSTNAME,
+                  (const uint8_t *)dhcp_hostname, (uint8_t)strlen(dhcp_hostname));
+
+    /* End */
+    msg[off++] = DHCP_OPT_END;
+
+    while (off < 300)
+        msg[off++] = 0;
+
+    udp_send(net_ip_broadcast, DHCP_SERVER_PORT, DHCP_CLIENT_PORT,
+             msg, off, net_mac_broadcast);
+
+    dhcp_client_state = DHCP_CLIENT_REQUESTING;
+    DBG_MAIN("[dhcp] REQUEST sent\r\n");
+}
+
+/* ------------------------------------------------------------------ */
+/* Client: receive callback (UDP port 68)                              */
+/* ------------------------------------------------------------------ */
+
+static void dhcp_client_rx(const uint8_t *data, uint32_t len,
+                           const uint8_t *src_ip, uint16_t src_port,
+                           const uint8_t *src_mac)
+{
+    uint8_t msg_type;
+    const uint8_t *opt;
+    uint8_t opt_len_val;
+    uint32_t options_len;
+
+    (void)src_ip;
+    (void)src_port;
+    (void)src_mac;
+
+    if (len < DHCP_OPTIONS)
+        return;
+
+    /* Verify magic cookie */
+    if (memcmp(&data[DHCP_COOKIE], dhcp_cookie, 4) != 0)
+        return;
+
+    /* Must be BOOTREPLY */
+    if (data[DHCP_OP] != 2)
+        return;
+
+    /* Verify transaction ID */
+    if (net_get32(data, DHCP_XID) != dhcp_xid)
+        return;
+
+    options_len = len - DHCP_OPTIONS;
+
+    /* Get message type */
+    opt = opt_find(&data[DHCP_OPTIONS], options_len, DHCP_OPT_MSGTYPE, &opt_len_val);
+    if (!opt || opt_len_val < 1)
+        return;
+    msg_type = opt[0];
+
+    if (msg_type == DHCP_OFFER && dhcp_client_state == DHCP_CLIENT_DISCOVERING) {
+        /* Save offered IP and server IP */
+        memcpy(dhcp_offered_ip, &data[DHCP_YIADDR], 4);
+        memcpy(dhcp_server_ip, &data[DHCP_SIADDR], 4);
+
+        /* If SIADDR is zero, try option 54 (Server Identifier) */
+        if (memcmp(dhcp_server_ip, net_ip_zero, 4) == 0) {
+            opt = opt_find(&data[DHCP_OPTIONS], options_len, 54, &opt_len_val);
+            if (opt && opt_len_val >= 4)
+                memcpy(dhcp_server_ip, opt, 4);
+        }
+
+        DBG_MAIN("[dhcp] OFFER received\r\n");
+        dhcp_send_request();
+
+    } else if (msg_type == DHCP_ACK && dhcp_client_state == DHCP_CLIENT_REQUESTING) {
+        /* Apply configuration */
+        memcpy(net_ip, &data[DHCP_YIADDR], 4);
+
+        /* Subnet mask (option 1) */
+        opt = opt_find(&data[DHCP_OPTIONS], options_len, DHCP_OPT_SUBNET, &opt_len_val);
+        if (opt && opt_len_val >= 4)
+            memcpy(net_mask, opt, 4);
+
+        /* Router/gateway (option 3) */
+        opt = opt_find(&data[DHCP_OPTIONS], options_len, DHCP_OPT_ROUTER, &opt_len_val);
+        if (opt && opt_len_val >= 4)
+            memcpy(net_gateway, opt, 4);
+
+        /* DNS (option 6) */
+        opt = opt_find(&data[DHCP_OPTIONS], options_len, DHCP_OPT_DNS, &opt_len_val);
+        if (opt && opt_len_val >= 4)
+            memcpy(net_dns_server, opt, 4);
+
+        dhcp_client_state = DHCP_CLIENT_BOUND;
+        DBG_MAIN("[dhcp] ACK received, IP configured\r\n");
+
+    } else if (msg_type == DHCP_NAK) {
+        /* Reset and try again */
+        dhcp_client_state = DHCP_CLIENT_IDLE;
+        memset(net_ip, 0, 4);
+        DBG_MAIN("[dhcp] NAK received\r\n");
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Server: receive callback (UDP port 67)                              */
+/* ------------------------------------------------------------------ */
+
+static void dhcp_server_rx(const uint8_t *data, uint32_t len,
+                           const uint8_t *src_ip, uint16_t src_port,
+                           const uint8_t *src_mac)
+{
+    uint8_t msg_type;
+    const uint8_t *opt;
+    uint8_t opt_len_val;
+    uint32_t options_len;
+    uint8_t reply[576];
+    uint32_t off;
+    uint8_t assigned_ip[4];
+    uint32_t client_xid;
+
+    (void)src_ip;
+    (void)src_port;
+
+    if (!dhcp_server_active)
+        return;
+
+    if (len < DHCP_OPTIONS)
+        return;
+
+    if (memcmp(&data[DHCP_COOKIE], dhcp_cookie, 4) != 0)
+        return;
+
+    if (data[DHCP_OP] != 1) /* Must be BOOTREQUEST */
+        return;
+
+    options_len = len - DHCP_OPTIONS;
+    opt = opt_find(&data[DHCP_OPTIONS], options_len, DHCP_OPT_MSGTYPE, &opt_len_val);
+    if (!opt || opt_len_val < 1)
+        return;
+    msg_type = opt[0];
+
+    client_xid = net_get32(data, DHCP_XID);
+
+    /* Compute assigned IP: (our_ip & mask) | ((client_mac[5] & 0x7f) + 100) */
+    {
+        uint8_t host_part = (src_mac[5] & 0x7F) + 100;
+        int i;
+        for (i = 0; i < 4; i++)
+            assigned_ip[i] = net_ip[i] & net_mask[i];
+        assigned_ip[3] |= host_part;
+    }
+
+    if (msg_type == DHCP_DISCOVER || msg_type == DHCP_REQUEST) {
+        uint8_t reply_type = (msg_type == DHCP_DISCOVER) ? DHCP_OFFER : DHCP_ACK;
+
+        dhcp_build_header(reply, 2); /* BOOTREPLY */
+        net_put32(reply, DHCP_XID, client_xid);
+
+        /* yiaddr = assigned IP */
+        memcpy(&reply[DHCP_YIADDR], assigned_ip, 4);
+
+        /* siaddr = our IP */
+        memcpy(&reply[DHCP_SIADDR], net_ip, 4);
+
+        /* Copy client MAC into chaddr */
+        memcpy(&reply[DHCP_CHADDR], src_mac, 6);
+
+        off = DHCP_OPTIONS;
+
+        /* Option 53: Message Type */
+        off = opt_put_byte(reply, off, DHCP_OPT_MSGTYPE, reply_type);
+
+        /* Option 54: Server Identifier */
+        off = opt_put(reply, off, 54, net_ip, 4);
+
+        /* Option 51: Lease Time */
+        off = opt_put32(reply, off, DHCP_OPT_LEASE, DHCP_LEASE_TIME);
+
+        /* Option 1: Subnet Mask */
+        off = opt_put(reply, off, DHCP_OPT_SUBNET, net_mask, 4);
+
+        /* Option 3: Router */
+        off = opt_put(reply, off, DHCP_OPT_ROUTER, net_ip, 4);
+
+        /* Option 6: DNS */
+        off = opt_put(reply, off, DHCP_OPT_DNS, net_ip, 4);
+
+        reply[off++] = DHCP_OPT_END;
+
+        while (off < 300)
+            reply[off++] = 0;
+
+        udp_send(net_ip_broadcast, DHCP_CLIENT_PORT, DHCP_SERVER_PORT,
+                 reply, off, net_mac_broadcast);
+
+        if (reply_type == DHCP_OFFER)
+            DBG_MAIN("[dhcp-srv] OFFER sent\r\n");
+        else
+            DBG_MAIN("[dhcp-srv] ACK sent\r\n");
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                          */
+/* ------------------------------------------------------------------ */
+
+void dhcp_client_start(void)
+{
+    /* Generate transaction ID from MAC + timer */
+    dhcp_xid = ((uint32_t)net_mac[4] << 24) |
+               ((uint32_t)net_mac[5] << 16) |
+               (net_time_ms() & 0xFFFF);
+
+    dhcp_client_state = DHCP_CLIENT_IDLE;
+    memset(dhcp_offered_ip, 0, 4);
+    memset(dhcp_server_ip, 0, 4);
+
+    udp_bind(DHCP_CLIENT_PORT, dhcp_client_rx);
+    dhcp_send_discover();
+}
+
+void dhcp_server_start(void)
+{
+    dhcp_server_active = 1;
+    udp_bind(DHCP_SERVER_PORT, dhcp_server_rx);
+    DBG_MAIN("[dhcp-srv] started\r\n");
+}
+
+void dhcp_stop(void)
+{
+    udp_unbind(DHCP_CLIENT_PORT);
+    udp_unbind(DHCP_SERVER_PORT);
+    dhcp_client_state = DHCP_CLIENT_IDLE;
+    dhcp_server_active = 0;
+}
diff --git a/src/app/net/net_dns.c b/src/app/net/net_dns.c
new file mode 100644
index 0000000..1269238
--- /dev/null
+++ b/src/app/net/net_dns.c
@@ -0,0 +1,479 @@
+/**
+ * @file net_dns.c
+ * @brief DNS client — A record resolution (RFC 1035)
+ *
+ * Sends UDP queries to the configured DNS server (net_dns[]) on port 53.
+ * Maintains a small cache and a queue of pending requests with timeout
+ * and retry logic.
+ *
+ * DNS message layout (within UDP payload):
+ *   [0..1]   ID
+ *   [2..3]   Flags (0x0100 = standard query, recursion desired)
+ *   [4..5]   QDCOUNT (1)
+ *   [6..7]   ANCOUNT
+ *   [8..9]   NSCOUNT (0)
+ *   [10..11]  ARCOUNT (0)
+ *   [12..]   Question section:
+ *              length-prefixed labels (e.g. \x03www\x06google\x03com\x00)
+ *              [+0..1] QTYPE  = 1 (A record)
+ *              [+2..3] QCLASS = 1 (IN)
+ *   Answer section:
+ *              NAME (may use compression pointer 0xC0 0x0C)
+ *              [+0..1] TYPE
+ *              [+2..3] CLASS
+ *              [+4..7] TTL
+ *              [+8..9] RDLENGTH
+ *              [+10..] RDATA (4 bytes for A record)
+ */
+
+#include <stdint.h>
+#include <string.h>
+#include "app/net/net_core.h"
+#include "app/net/net_udp.h"
+#include "app/net/net_dns.h"
+#include "utils/debug.h"
+
+/* ------------------------------------------------------------------ */
+/* Static state                                                        */
+/* ------------------------------------------------------------------ */
+
+struct dns_cache_entry {
+    char     domain[DNS_MAX_DOMAIN];
+    uint8_t  ip[4];
+    uint32_t timestamp;
+    int32_t  valid;
+};
+
+struct dns_pending_entry {
+    uint16_t       id;
+    char           domain[DNS_MAX_DOMAIN];
+    dns_callback_t callback;
+    void          *ctx;
+    uint32_t       timestamp;   /* When the request was first sent */
+    uint32_t       last_sent;   /* Last retransmit time */
+    int32_t        active;
+};
+
+static struct dns_cache_entry   dns_cache[DNS_CACHE_SIZE] __attribute__((section(".extram")));
+static struct dns_pending_entry dns_pending[DNS_PENDING_SIZE] __attribute__((section(".extram")));
+static uint16_t dns_next_id = 1;
+
+/* Flag: have we bound the UDP listener? */
+static int32_t dns_bound = 0;
+
+/* ------------------------------------------------------------------ */
+/* Helpers                                                             */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Safe string length with a maximum bound.
+ */
+static uint32_t slen(const char *s, uint32_t max)
+{
+    uint32_t n = 0;
+    while (n < max && s[n])
+        n++;
+    return n;
+}
+
+/**
+ * Copy a NUL-terminated string with a maximum length.
+ */
+static void scopy(char *dst, const char *src, uint32_t max)
+{
+    uint32_t i;
+    for (i = 0; i < max - 1 && src[i]; i++)
+        dst[i] = src[i];
+    dst[i] = '\0';
+}
+
+/**
+ * Case-insensitive domain comparison.
+ */
+static int domain_eq(const char *a, const char *b)
+{
+    while (*a && *b) {
+        char ca = *a, cb = *b;
+        if (ca >= 'A' && ca <= 'Z') ca += 32;
+        if (cb >= 'A' && cb <= 'Z') cb += 32;
+        if (ca != cb) return 0;
+        a++;
+        b++;
+    }
+    return (*a == *b);
+}
+
+/**
+ * Look up a domain in the cache.
+ */
+static struct dns_cache_entry *cache_lookup(const char *domain)
+{
+    int i;
+    for (i = 0; i < DNS_CACHE_SIZE; i++) {
+        if (dns_cache[i].valid && domain_eq(dns_cache[i].domain, domain))
+            return &dns_cache[i];
+    }
+    return (struct dns_cache_entry *)0;
+}
+
+/**
+ * Insert into cache (evict oldest if full).
+ */
+static void cache_insert(const char *domain, const uint8_t *ip)
+{
+    int i;
+    uint32_t oldest_time;
+    int oldest_idx;
+
+    /* Update existing */
+    for (i = 0; i < DNS_CACHE_SIZE; i++) {
+        if (dns_cache[i].valid && domain_eq(dns_cache[i].domain, domain)) {
+            memcpy(dns_cache[i].ip, ip, 4);
+            dns_cache[i].timestamp = net_time_s();
+            return;
+        }
+    }
+
+    /* Find free */
+    for (i = 0; i < DNS_CACHE_SIZE; i++) {
+        if (!dns_cache[i].valid) {
+            scopy(dns_cache[i].domain, domain, DNS_MAX_DOMAIN);
+            memcpy(dns_cache[i].ip, ip, 4);
+            dns_cache[i].timestamp = net_time_s();
+            dns_cache[i].valid = 1;
+            return;
+        }
+    }
+
+    /* Evict oldest */
+    oldest_idx = 0;
+    oldest_time = dns_cache[0].timestamp;
+    for (i = 1; i < DNS_CACHE_SIZE; i++) {
+        if (dns_cache[i].timestamp < oldest_time) {
+            oldest_time = dns_cache[i].timestamp;
+            oldest_idx = i;
+        }
+    }
+    scopy(dns_cache[oldest_idx].domain, domain, DNS_MAX_DOMAIN);
+    memcpy(dns_cache[oldest_idx].ip, ip, 4);
+    dns_cache[oldest_idx].timestamp = net_time_s();
+    dns_cache[oldest_idx].valid = 1;
+}
+
+/**
+ * Encode a domain name into DNS wire format (label-length encoding).
+ * E.g. "www.example.com" → \x03www\x07example\x03com\x00
+ *
+ * @return Number of bytes written, or 0 on error.
+ */
+static uint32_t dns_encode_name(uint8_t *buf, uint32_t bufsize,
+                                const char *domain)
+{
+    uint32_t pos = 0;
+    const char *p = domain;
+
+    while (*p) {
+        const char *dot = p;
+        uint32_t label_len;
+
+        /* Find next dot or end */
+        while (*dot && *dot != '.')
+            dot++;
+
+        label_len = (uint32_t)(dot - p);
+        if (label_len == 0 || label_len > 63)
+            return 0;
+        if (pos + 1 + label_len >= bufsize)
+            return 0;
+
+        buf[pos++] = (uint8_t)label_len;
+        memcpy(&buf[pos], p, label_len);
+        pos += label_len;
+
+        p = dot;
+        if (*p == '.')
+            p++;
+    }
+
+    if (pos + 1 >= bufsize)
+        return 0;
+
+    buf[pos++] = 0; /* Terminating zero-length label */
+    return pos;
+}
+
+/**
+ * Build and send a DNS query for the given domain.
+ */
+static void dns_send_query(const char *domain, uint16_t id)
+{
+    uint8_t msg[512];
+    uint32_t off;
+    uint32_t name_len;
+
+    memset(msg, 0, 12); /* Header */
+
+    /* ID */
+    net_put16(msg, 0, id);
+
+    /* Flags: standard query, recursion desired */
+    net_put16(msg, 2, 0x0100);
+
+    /* QDCOUNT = 1 */
+    net_put16(msg, 4, 1);
+
+    /* ANCOUNT, NSCOUNT, ARCOUNT = 0 (already zeroed) */
+
+    off = 12;
+
+    /* Encode domain name */
+    name_len = dns_encode_name(&msg[off], sizeof(msg) - off - 4, domain);
+    if (name_len == 0)
+        return;
+    off += name_len;
+
+    /* QTYPE = A (1) */
+    net_put16(msg, off, 1);
+    off += 2;
+
+    /* QCLASS = IN (1) */
+    net_put16(msg, off, 1);
+    off += 2;
+
+    /* Send via UDP to net_dns_server:53 */
+    udp_send(net_dns_server, DNS_SERVER_PORT, DNS_LOCAL_PORT, msg, off,
+             (const uint8_t *)0 /* ARP resolve */);
+}
+
+/* ------------------------------------------------------------------ */
+/* Bind the UDP listener on demand                                     */
+/* ------------------------------------------------------------------ */
+
+/* Forward declare */
+static void dns_udp_rx(const uint8_t *data, uint32_t len,
+                       const uint8_t *src_ip, uint16_t src_port,
+                       const uint8_t *src_mac);
+
+static void dns_ensure_bound(void)
+{
+    if (!dns_bound) {
+        udp_bind(DNS_LOCAL_PORT, dns_udp_rx);
+        dns_bound = 1;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                          */
+/* ------------------------------------------------------------------ */
+
+void dns_resolve(const char *domain, dns_callback_t callback, void *ctx)
+{
+    struct dns_cache_entry *ce;
+    int i;
+    uint16_t id;
+
+    if (!domain || !callback)
+        return;
+
+    /* Check cache */
+    ce = cache_lookup(domain);
+    if (ce) {
+        callback(ce->ip, ctx);
+        return;
+    }
+
+    dns_ensure_bound();
+
+    /* Queue pending request */
+    for (i = 0; i < DNS_PENDING_SIZE; i++) {
+        if (!dns_pending[i].active) {
+            id = dns_next_id++;
+            if (dns_next_id == 0) dns_next_id = 1;
+
+            dns_pending[i].id        = id;
+            scopy(dns_pending[i].domain, domain, DNS_MAX_DOMAIN);
+            dns_pending[i].callback  = callback;
+            dns_pending[i].ctx       = ctx;
+            dns_pending[i].timestamp = net_time_s();
+            dns_pending[i].last_sent = net_time_s();
+            dns_pending[i].active    = 1;
+
+            dns_send_query(domain, id);
+            return;
+        }
+    }
+
+    /* Queue full */
+    DBG_MAIN("[dns] pending queue full\r\n");
+    callback((const uint8_t *)0, ctx);
+}
+
+/* ------------------------------------------------------------------ */
+/* Receive handler                                                     */
+/* ------------------------------------------------------------------ */
+
+void dns_rx(const uint8_t *data, uint32_t len,
+            const uint8_t *src_ip, uint16_t src_port,
+            const uint8_t *src_mac)
+{
+    uint16_t id;
+    uint16_t flags;
+    uint16_t qdcount, ancount;
+    uint32_t off;
+    int i;
+    struct dns_pending_entry *pe = (struct dns_pending_entry *)0;
+
+    (void)src_ip;
+    (void)src_port;
+    (void)src_mac;
+
+    if (len < 12)
+        return;
+
+    id      = net_get16(data, 0);
+    flags   = net_get16(data, 2);
+    qdcount = net_get16(data, 4);
+    ancount = net_get16(data, 6);
+
+    /* Must be a response (QR bit set) */
+    if (!(flags & 0x8000))
+        return;
+
+    /* Check for errors in RCODE (lower 4 bits of flags) */
+    if (flags & 0x000F) {
+        /* Error response — notify failure */
+        for (i = 0; i < DNS_PENDING_SIZE; i++) {
+            if (dns_pending[i].active && dns_pending[i].id == id) {
+                dns_pending[i].active = 0;
+                if (dns_pending[i].callback)
+                    dns_pending[i].callback((const uint8_t *)0,
+                                            dns_pending[i].ctx);
+                return;
+            }
+        }
+        return;
+    }
+
+    /* Find matching pending request */
+    for (i = 0; i < DNS_PENDING_SIZE; i++) {
+        if (dns_pending[i].active && dns_pending[i].id == id) {
+            pe = &dns_pending[i];
+            break;
+        }
+    }
+    if (!pe)
+        return;
+
+    /* Skip question section */
+    off = 12;
+    for (i = 0; i < (int)qdcount; i++) {
+        /* Skip name */
+        while (off < len) {
+            uint8_t lbl = data[off];
+            if (lbl == 0) { off++; break; }
+            if ((lbl & 0xC0) == 0xC0) { off += 2; break; }
+            off += 1 + lbl;
+        }
+        off += 4; /* QTYPE + QCLASS */
+    }
+
+    /* Parse answer section — look for first A record */
+    for (i = 0; i < (int)ancount; i++) {
+        uint16_t rtype, rclass, rdlength;
+
+        if (off >= len)
+            break;
+
+        /* Skip name (may be compression pointer) */
+        {
+            uint8_t lbl = data[off];
+            if ((lbl & 0xC0) == 0xC0) {
+                off += 2; /* Compression pointer */
+            } else {
+                while (off < len) {
+                    lbl = data[off];
+                    if (lbl == 0) { off++; break; }
+                    if ((lbl & 0xC0) == 0xC0) { off += 2; break; }
+                    off += 1 + lbl;
+                }
+            }
+        }
+
+        if (off + 10 > len)
+            break;
+
+        rtype    = net_get16(data, off);      off += 2;
+        rclass   = net_get16(data, off);      off += 2;
+        /* TTL */                              off += 4;
+        rdlength = net_get16(data, off);      off += 2;
+
+        if (rtype == 1 && rclass == 1 && rdlength == 4 && off + 4 <= len) {
+            /* A record found! */
+            cache_insert(pe->domain, &data[off]);
+
+            pe->active = 0;
+            if (pe->callback)
+                pe->callback(&data[off], pe->ctx);
+            return;
+        }
+
+        off += rdlength;
+    }
+
+    /* No A record found — fail */
+    pe->active = 0;
+    if (pe->callback)
+        pe->callback((const uint8_t *)0, pe->ctx);
+}
+
+/**
+ * Internal UDP receive wrapper that calls dns_rx with the right signature.
+ */
+static void dns_udp_rx(const uint8_t *data, uint32_t len,
+                       const uint8_t *src_ip, uint16_t src_port,
+                       const uint8_t *src_mac)
+{
+    dns_rx(data, len, src_ip, src_port, src_mac);
+}
+
+/* ------------------------------------------------------------------ */
+/* Timer                                                               */
+/* ------------------------------------------------------------------ */
+
+void dns_timer(void)
+{
+    uint32_t now = net_time_s();
+    int i;
+
+    for (i = 0; i < DNS_PENDING_SIZE; i++) {
+        if (!dns_pending[i].active)
+            continue;
+
+        /* Total timeout */
+        if (now - dns_pending[i].timestamp >= DNS_TIMEOUT_S) {
+            dns_pending[i].active = 0;
+            DBG_MAIN("[dns] timeout\r\n");
+            if (dns_pending[i].callback)
+                dns_pending[i].callback((const uint8_t *)0, dns_pending[i].ctx);
+            continue;
+        }
+
+        /* Retransmit */
+        if (now - dns_pending[i].last_sent >= DNS_RETRY_S) {
+            dns_pending[i].last_sent = now;
+            dns_send_query(dns_pending[i].domain, dns_pending[i].id);
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Reset                                                               */
+/* ------------------------------------------------------------------ */
+
+void dns_reset(void)
+{
+    memset(dns_cache,   0, sizeof(dns_cache));
+    memset(dns_pending, 0, sizeof(dns_pending));
+    dns_next_id = 1;
+    dns_bound = 0;
+}
diff --git a/src/app/net/net_ip.c b/src/app/net/net_ip.c
new file mode 100644
index 0000000..1d116fb
--- /dev/null
+++ b/src/app/net/net_ip.c
@@ -0,0 +1,159 @@
+/**
+ * @file net_ip.c
+ * @brief IPv4 layer — header construction, checksum, dispatch
+ *
+ * Builds outgoing LLC/SNAP + IPv4 headers and parses incoming IP packets
+ * for dispatch to TCP and UDP handlers.
+ *
+ * Frame layout (outgoing):
+ *   [0..7]    LLC/SNAP header  (AA AA 03 00 00 00 08 00)
+ *   [8..27]   IPv4 header (20 bytes, no options)
+ *   [28..]    Transport payload (TCP/UDP)
+ */
+
+#include <stdint.h>
+#include <string.h>
+#include "app/net/net_core.h"
+#include "app/net/net_ip.h"
+#include "app/net/net_tcp.h"
+#include "app/net/net_udp.h"
+#include "utils/debug.h"
+
+/* Auto-incrementing identification field */
+static uint16_t ip_id_counter = 1;
+
+/* ------------------------------------------------------------------ */
+/* Header construction                                                 */
+/* ------------------------------------------------------------------ */
+
+uint32_t ip_build(uint8_t *buf, const uint8_t *src_ip, const uint8_t *dst_ip,
+                  uint8_t protocol, uint16_t payload_len)
+{
+    uint16_t total_len = IP_HEADER_LEN + payload_len;
+
+    /* ---- LLC/SNAP header (8 bytes) ---- */
+    memcpy(buf, LLC_SNAP_IP, LLC_SNAP_LEN);
+
+    /* ---- IPv4 header at offset 8 ---- */
+
+    /* Version (4) + IHL (5 = 20 bytes) */
+    buf[IP_OFFSET + 0] = 0x45;
+
+    /* DSCP / ECN */
+    buf[IP_OFFSET + 1] = 0x00;
+
+    /* Total length (IP header + payload) */
+    net_put16(buf, IP_OFFSET + 2, total_len);
+
+    /* Identification */
+    net_put16(buf, IP_OFFSET + 4, ip_id_counter++);
+
+    /* Flags (Don't Fragment) + Fragment Offset = 0 */
+    net_put16(buf, IP_OFFSET + 6, 0x4000);
+
+    /* TTL */
+    buf[IP_OFFSET + 8] = 64;
+
+    /* Protocol */
+    buf[IP_OFFSET + 9] = protocol;
+
+    /* Header checksum — zero for now, filled by ip_finalize() */
+    net_put16(buf, IP_OFFSET + 10, 0x0000);
+
+    /* Source IP */
+    memcpy(&buf[IP_OFFSET + 12], src_ip, 4);
+
+    /* Destination IP */
+    memcpy(&buf[IP_OFFSET + 16], dst_ip, 4);
+
+    /* Return total header length: LLC/SNAP(8) + IP(20) = 28 */
+    return LLC_SNAP_LEN + IP_HEADER_LEN;
+}
+
+/* ------------------------------------------------------------------ */
+/* Checksum finalisation                                               */
+/* ------------------------------------------------------------------ */
+
+void ip_finalize(uint8_t *buf)
+{
+    uint16_t cksum;
+
+    /* Zero the checksum field before computing */
+    net_put16(buf, IP_OFFSET + 10, 0x0000);
+
+    /* Compute over the 20-byte IP header */
+    cksum = net_checksum(&buf[IP_OFFSET], IP_HEADER_LEN, 0);
+
+    /* Write it back */
+    net_put16(buf, IP_OFFSET + 10, cksum);
+}
+
+/* ------------------------------------------------------------------ */
+/* Receive dispatch                                                    */
+/* ------------------------------------------------------------------ */
+
+void ip_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac)
+{
+    uint8_t  version_ihl;
+    uint8_t  ihl;
+    uint16_t total_len;
+    uint8_t  protocol;
+    uint16_t cksum;
+
+    /* Need at least LLC/SNAP + minimal IP header */
+    if (len < IP_OFFSET + IP_HEADER_LEN)
+        return;
+
+    /* Version must be 4, IHL >= 5 */
+    version_ihl = data[IP_OFFSET + 0];
+    if ((version_ihl >> 4) != 4)
+        return;
+
+    ihl = (version_ihl & 0x0F) * 4;
+    if (ihl < IP_HEADER_LEN)
+        return;
+
+    /* Reject IP options — we only handle 20-byte headers */
+    if (ihl != IP_HEADER_LEN)
+        return;
+
+    /* Total length sanity check */
+    total_len = net_get16(data, IP_OFFSET + 2);
+    if (IP_OFFSET + total_len > len)
+        return;
+
+    /* Verify IP header checksum */
+    cksum = net_checksum(&data[IP_OFFSET], ihl, 0);
+    if (cksum != 0)
+        return;
+
+    /* Check destination: must be our IP, broadcast, or 0.0.0.0 (DHCP) */
+    {
+        const uint8_t *dst_ip = &data[IP_OFFSET + 16];
+        if (memcmp(dst_ip, net_ip, 4) != 0 &&
+            memcmp(dst_ip, net_ip_broadcast, 4) != 0 &&
+            memcmp(dst_ip, net_ip_zero, 4) != 0) {
+            /* Also accept subnet broadcast */
+            uint8_t subnet_bcast[4];
+            int i;
+            for (i = 0; i < 4; i++)
+                subnet_bcast[i] = net_ip[i] | ~net_mask[i];
+            if (memcmp(dst_ip, subnet_bcast, 4) != 0)
+                return;
+        }
+    }
+
+    /* Dispatch by protocol */
+    protocol = data[IP_OFFSET + 9];
+    switch (protocol) {
+    case IP_PROTO_TCP:
+        tcp_rx(data, len, src_mac);
+        break;
+    case IP_PROTO_UDP:
+        udp_rx(data, len, src_mac);
+        break;
+    default:
+        /* Unsupported protocol — drop */
+        break;
+    }
+}
diff --git a/src/app/net/net_tcp.c b/src/app/net/net_tcp.c
new file mode 100644
index 0000000..24056ab
--- /dev/null
+++ b/src/app/net/net_tcp.c
@@ -0,0 +1,654 @@
+/**
+ * @file net_tcp.c
+ * @brief TCP — Transmission Control Protocol (simplified, RFC 793 subset)
+ *
+ * This is a stop-and-wait TCP suitable for embedded use:
+ *   - One unacknowledged segment at a time
+ *   - Fixed window (2048 bytes)
+ *   - No out-of-order reassembly
+ *   - MSS = 1024
+ *
+ * TCP segment layout within LLC/SNAP+IP frame:
+ *   [0..7]    LLC/SNAP
+ *   [8..27]   IP header (20 bytes)
+ *   [28..47]  TCP header (20 bytes minimum):
+ *     [28..29] Source port
+ *     [30..31] Destination port
+ *     [32..35] Sequence number
+ *     [36..39] Acknowledgment number
+ *     [40]     Data offset (upper 4 bits, in 32-bit words) + reserved
+ *     [41]     Flags (FIN=0x01 SYN=0x02 RST=0x04 PSH=0x08 ACK=0x10)
+ *     [42..43] Window
+ *     [44..45] Checksum
+ *     [46..47] Urgent pointer
+ *   [48..]    Options / data
+ */
+
+#include <stdint.h>
+#include <string.h>
+#include "app/net/net_core.h"
+#include "app/net/net_ip.h"
+#include "app/net/net_tcp.h"
+#include "app/net/net_arp.h"
+#include "utils/debug.h"
+
+/* ------------------------------------------------------------------ */
+/* Connection pool                                                     */
+/* ------------------------------------------------------------------ */
+
+static struct tcp_conn tcp_conns[NET_TCP_MAX_CONN] __attribute__((section(".extram")));
+
+/* Ephemeral port counter */
+static uint16_t tcp_ephemeral_counter = 0;
+
+/* ------------------------------------------------------------------ */
+/* TCP header offsets (relative to frame start)                         */
+/* ------------------------------------------------------------------ */
+
+#define TCP_OFF         (LLC_SNAP_LEN + IP_HEADER_LEN)  /* 28 */
+#define TCP_SRC_PORT    (TCP_OFF + 0)
+#define TCP_DST_PORT    (TCP_OFF + 2)
+#define TCP_SEQ         (TCP_OFF + 4)
+#define TCP_ACK_NUM     (TCP_OFF + 8)
+#define TCP_DATA_OFF_FLAGS (TCP_OFF + 12) /* upper nibble = offset, lower byte+1 = flags */
+#define TCP_FLAGS       (TCP_OFF + 13)
+#define TCP_WINDOW_OFF  (TCP_OFF + 14)
+#define TCP_CHECKSUM    (TCP_OFF + 16)
+#define TCP_URGENT      (TCP_OFF + 18)
+#define TCP_HEADER_LEN  20
+#define TCP_MIN_FRAME   (TCP_OFF + TCP_HEADER_LEN) /* 48 */
+
+/* ------------------------------------------------------------------ */
+/* Internal helpers                                                    */
+/* ------------------------------------------------------------------ */
+
+/** Find a free connection slot. */
+static struct tcp_conn *conn_alloc(void)
+{
+    int i;
+    for (i = 0; i < NET_TCP_MAX_CONN; i++) {
+        if (!tcp_conns[i].enabled)
+            return &tcp_conns[i];
+    }
+    return (struct tcp_conn *)0;
+}
+
+/** Find a connection matching an incoming segment. */
+static struct tcp_conn *conn_find(const uint8_t *src_ip, uint16_t src_port,
+                                  uint16_t dst_port)
+{
+    int i;
+    for (i = 0; i < NET_TCP_MAX_CONN; i++) {
+        if (!tcp_conns[i].enabled)
+            continue;
+
+        /* Listening socket: match only local port */
+        if (tcp_conns[i].state == TCP_STATE_LISTEN) {
+            if (tcp_conns[i].local_port == dst_port)
+                return &tcp_conns[i];
+            continue;
+        }
+
+        /* Active connection: match both ends */
+        if (tcp_conns[i].local_port == dst_port &&
+            tcp_conns[i].dst_port == src_port &&
+            memcmp(tcp_conns[i].dst_ip, src_ip, 4) == 0) {
+            return &tcp_conns[i];
+        }
+    }
+    return (struct tcp_conn *)0;
+}
+
+/**
+ * Compute TCP pseudo-header checksum accumulator.
+ */
+static uint32_t tcp_pseudo_sum(const uint8_t *src_ip, const uint8_t *dst_ip,
+                               uint16_t tcp_len)
+{
+    uint32_t sum = 0;
+    sum += ((uint32_t)src_ip[0] << 8) | src_ip[1];
+    sum += ((uint32_t)src_ip[2] << 8) | src_ip[3];
+    sum += ((uint32_t)dst_ip[0] << 8) | dst_ip[1];
+    sum += ((uint32_t)dst_ip[2] << 8) | dst_ip[3];
+    sum += IP_PROTO_TCP;
+    sum += tcp_len;
+    return sum;
+}
+
+/**
+ * Build and send a TCP segment.
+ *
+ * @param conn       Connection (supplies IPs, ports, seq/ack, MAC)
+ * @param flags      TCP flags
+ * @param data       Payload (may be NULL)
+ * @param data_len   Payload length
+ * @param save       If non-zero, save a copy for retransmission
+ */
+static void tcp_send_segment(struct tcp_conn *conn, uint8_t flags,
+                              const uint8_t *data, uint32_t data_len,
+                              int save)
+{
+    /* Static to avoid 1076-byte stack frame — only one send at a time */
+    static uint8_t frame[LLC_SNAP_LEN + IP_HEADER_LEN + TCP_HEADER_LEN + 4 + TCP_MSS];
+    uint32_t tcp_hdr_len;
+    uint32_t tcp_total_len;
+    uint32_t frame_len;
+    uint16_t cksum;
+    uint32_t pseudo;
+
+    /* TCP header length: 20 base + 4 for MSS option on SYN */
+    if (flags & TCP_FLAG_SYN)
+        tcp_hdr_len = 24; /* 20 + MSS option (4 bytes) */
+    else
+        tcp_hdr_len = 20;
+
+    tcp_total_len = tcp_hdr_len + data_len;
+
+    /* Build LLC/SNAP + IP header */
+    ip_build(frame, conn->local_ip, conn->dst_ip, IP_PROTO_TCP, tcp_total_len);
+
+    /* TCP header */
+    net_put16(frame, TCP_SRC_PORT, conn->local_port);
+    net_put16(frame, TCP_DST_PORT, conn->dst_port);
+    net_put32(frame, TCP_SEQ, conn->seq);
+    net_put32(frame, TCP_ACK_NUM, conn->ack);
+
+    /* Data offset (in 32-bit words) in upper nibble, reserved bits = 0 */
+    frame[TCP_DATA_OFF_FLAGS] = (uint8_t)((tcp_hdr_len / 4) << 4);
+    frame[TCP_FLAGS] = flags;
+
+    net_put16(frame, TCP_WINDOW_OFF, TCP_WINDOW);
+    net_put16(frame, TCP_CHECKSUM, 0);
+    net_put16(frame, TCP_URGENT, 0);
+
+    /* MSS option on SYN */
+    if (flags & TCP_FLAG_SYN) {
+        frame[TCP_OFF + 20] = 2;    /* Kind: MSS */
+        frame[TCP_OFF + 21] = 4;    /* Length */
+        net_put16(frame, TCP_OFF + 22, TCP_MSS);
+    }
+
+    /* Copy payload */
+    if (data && data_len > 0) {
+        memcpy(&frame[TCP_OFF + tcp_hdr_len], data, data_len);
+    }
+
+    /* TCP checksum over pseudo-header + entire TCP segment */
+    pseudo = tcp_pseudo_sum(conn->local_ip, conn->dst_ip, tcp_total_len);
+    cksum = net_checksum(&frame[TCP_OFF], tcp_total_len, pseudo);
+    net_put16(frame, TCP_CHECKSUM, cksum);
+
+    /* Finalize IP header checksum */
+    ip_finalize(frame);
+
+    frame_len = TCP_OFF + tcp_total_len;
+
+    /* Save for retransmission if requested */
+    if (save) {
+        if (frame_len <= TCP_RETRANSMIT_BUF) {
+            memcpy(conn->last_sent, frame, frame_len);
+            conn->last_sent_len = frame_len;
+        }
+        conn->last_sent_time = net_time_s();
+        conn->retry_count = 0;
+    }
+
+    net_send(frame, frame_len, conn->mac, 0);
+}
+
+/**
+ * Send a RST to a remote host (not associated with any connection).
+ */
+static void tcp_send_rst(const uint8_t *dst_ip, const uint8_t *dst_mac,
+                          uint16_t src_port, uint16_t dst_port,
+                          uint32_t seq, uint32_t ack)
+{
+    uint8_t frame[TCP_MIN_FRAME];
+    uint32_t pseudo;
+    uint16_t cksum;
+
+    ip_build(frame, net_ip, dst_ip, IP_PROTO_TCP, TCP_HEADER_LEN);
+
+    net_put16(frame, TCP_SRC_PORT, src_port);
+    net_put16(frame, TCP_DST_PORT, dst_port);
+    net_put32(frame, TCP_SEQ, seq);
+    net_put32(frame, TCP_ACK_NUM, ack);
+    frame[TCP_DATA_OFF_FLAGS] = (5 << 4); /* 20 bytes */
+    frame[TCP_FLAGS] = TCP_FLAG_RST | TCP_FLAG_ACK;
+    net_put16(frame, TCP_WINDOW_OFF, 0);
+    net_put16(frame, TCP_CHECKSUM, 0);
+    net_put16(frame, TCP_URGENT, 0);
+
+    pseudo = tcp_pseudo_sum(net_ip, dst_ip, TCP_HEADER_LEN);
+    cksum = net_checksum(&frame[TCP_OFF], TCP_HEADER_LEN, pseudo);
+    net_put16(frame, TCP_CHECKSUM, cksum);
+
+    ip_finalize(frame);
+    net_send(frame, TCP_MIN_FRAME, dst_mac, 0);
+}
+
+/**
+ * Close a connection internally and notify the callback.
+ */
+static void conn_close_notify(struct tcp_conn *conn)
+{
+    conn->state   = TCP_STATE_CLOSED;
+    conn->enabled = 0;
+    if (conn->callback)
+        conn->callback(conn, TCP_CLOSED, (const uint8_t *)0, 0);
+}
+
+/* ------------------------------------------------------------------ */
+/* ARP callback for outbound connect                                   */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Context passed through ARP resolution during tcp_connect().
+ * We stash the connection pointer index so the callback can find it.
+ */
+struct tcp_connect_ctx {
+    int32_t conn_index;
+    int32_t active;
+};
+
+#define TCP_CONNECT_CTX_SIZE 4
+static struct tcp_connect_ctx tcp_connect_ctxs[TCP_CONNECT_CTX_SIZE];
+
+static void tcp_connect_arp_cb(const uint8_t *mac, void *ctx)
+{
+    struct tcp_connect_ctx *tc = (struct tcp_connect_ctx *)ctx;
+    struct tcp_conn *conn;
+
+    if (!tc->active)
+        return;
+
+    tc->active = 0;
+
+    if (tc->conn_index < 0 || tc->conn_index >= NET_TCP_MAX_CONN)
+        return;
+
+    conn = &tcp_conns[tc->conn_index];
+
+    if (!conn->enabled || conn->state != TCP_STATE_SYN_SENT)
+        return;
+
+    if (!mac) {
+        /* ARP failed */
+        DBG_MAIN("[tcp] ARP failed for connect\r\n");
+        conn_close_notify(conn);
+        return;
+    }
+
+    /* Store resolved MAC and send SYN */
+    memcpy(conn->mac, mac, 6);
+    tcp_send_segment(conn, TCP_FLAG_SYN, (const uint8_t *)0, 0, 1);
+
+    /* SYN consumes one sequence number */
+    conn->seq++;
+}
+
+/* ------------------------------------------------------------------ */
+/* Public API                                                          */
+/* ------------------------------------------------------------------ */
+
+struct tcp_conn *tcp_connect(const uint8_t *dst_ip, uint16_t dst_port,
+                             uint16_t local_port, tcp_callback_t callback)
+{
+    struct tcp_conn *conn;
+    int i;
+
+    conn = conn_alloc();
+    if (!conn) {
+        DBG_MAIN("[tcp] no free connection slots\r\n");
+        return (struct tcp_conn *)0;
+    }
+
+    memset(conn, 0, sizeof(*conn));
+
+    /* Assign ephemeral port if 0 */
+    if (local_port == 0) {
+        local_port = 1024 + (tcp_ephemeral_counter % 16384);
+        tcp_ephemeral_counter++;
+    }
+
+    conn->state      = TCP_STATE_SYN_SENT;
+    memcpy(conn->dst_ip, dst_ip, 4);
+    memcpy(conn->local_ip, net_ip, 4);
+    conn->dst_port   = dst_port;
+    conn->local_port = local_port;
+    conn->seq        = (uint32_t)(net_time_ms() ^ (uint32_t)local_port);
+    conn->ack        = 0;
+    conn->callback   = callback;
+    conn->enabled    = 1;
+    conn->lock_send  = 1; /* Locked until connection established */
+    conn->close_pending = 0;
+
+    /* Resolve MAC via ARP, then send SYN in callback */
+    for (i = 0; i < TCP_CONNECT_CTX_SIZE; i++) {
+        if (!tcp_connect_ctxs[i].active) {
+            tcp_connect_ctxs[i].conn_index = (int32_t)(conn - tcp_conns);
+            tcp_connect_ctxs[i].active = 1;
+            arp_resolve(dst_ip, tcp_connect_arp_cb, &tcp_connect_ctxs[i]);
+            return conn;
+        }
+    }
+
+    /* No connect context available — release and fail */
+    conn->enabled = 0;
+    DBG_MAIN("[tcp] connect ctx pool full\r\n");
+    return (struct tcp_conn *)0;
+}
+
+struct tcp_conn *tcp_listen(uint16_t local_port, tcp_callback_t callback)
+{
+    struct tcp_conn *conn;
+
+    conn = conn_alloc();
+    if (!conn) {
+        DBG_MAIN("[tcp] no free connection slots for listen\r\n");
+        return (struct tcp_conn *)0;
+    }
+
+    memset(conn, 0, sizeof(*conn));
+    conn->state      = TCP_STATE_LISTEN;
+    memcpy(conn->local_ip, net_ip, 4);
+    conn->local_port = local_port;
+    conn->seq        = (uint32_t)(net_time_ms() ^ (uint32_t)local_port);
+    conn->callback   = callback;
+    conn->enabled    = 1;
+
+    return conn;
+}
+
+int32_t tcp_write(struct tcp_conn *conn, const uint8_t *data, uint32_t len)
+{
+    if (!conn || !conn->enabled)
+        return -1;
+
+    if (conn->state != TCP_STATE_ESTABLISHED)
+        return -1;
+
+    if (conn->lock_send) {
+        /* Previous segment not yet ACKed — caller should retry on TCP_WRITABLE */
+        return 0;
+    }
+
+    if (len > TCP_MSS)
+        len = TCP_MSS;
+
+    /* Mark as locked until this segment is ACKed */
+    conn->lock_send = 1;
+
+    tcp_send_segment(conn, TCP_FLAG_ACK | TCP_FLAG_PSH, data, len, 1);
+    conn->seq += len;
+
+    return (int32_t)len;
+}
+
+void tcp_close(struct tcp_conn *conn)
+{
+    if (!conn || !conn->enabled)
+        return;
+
+    if (conn->state == TCP_STATE_LISTEN) {
+        conn->state   = TCP_STATE_CLOSED;
+        conn->enabled = 0;
+        return;
+    }
+
+    if (conn->state == TCP_STATE_ESTABLISHED) {
+        if (conn->lock_send) {
+            /* Wait for pending ACK, then close */
+            conn->close_pending = 1;
+        } else {
+            /* Send FIN+ACK */
+            tcp_send_segment(conn, TCP_FLAG_FIN | TCP_FLAG_ACK,
+                             (const uint8_t *)0, 0, 1);
+            conn->seq++;
+            conn->state = TCP_STATE_FIN_WAIT;
+        }
+        return;
+    }
+
+    /* SYN_SENT or FIN_WAIT — just kill it */
+    conn_close_notify(conn);
+}
+
+/* ------------------------------------------------------------------ */
+/* Receive state machine                                               */
+/* ------------------------------------------------------------------ */
+
+void tcp_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac)
+{
+    uint16_t src_port, dst_port;
+    uint32_t seq_num, ack_num;
+    uint8_t  flags, data_off_byte;
+    uint32_t tcp_hdr_len;
+    uint32_t tcp_data_len;
+    const uint8_t *src_ip;
+    const uint8_t *payload;
+    struct tcp_conn *conn;
+    uint16_t ip_total_len;
+
+    if (len < TCP_MIN_FRAME)
+        return;
+
+    src_port = net_get16(data, TCP_SRC_PORT);
+    dst_port = net_get16(data, TCP_DST_PORT);
+    seq_num  = net_get32(data, TCP_SEQ);
+    ack_num  = net_get32(data, TCP_ACK_NUM);
+
+    data_off_byte = data[TCP_DATA_OFF_FLAGS];
+    tcp_hdr_len = (uint32_t)((data_off_byte >> 4) & 0x0F) * 4;
+    if (tcp_hdr_len < 20)
+        return;
+
+    flags = data[TCP_FLAGS];
+    src_ip = &data[IP_OFFSET + 12];
+
+    /* Compute payload length from IP total length */
+    ip_total_len = net_get16(data, IP_OFFSET + 2);
+    if (ip_total_len < IP_HEADER_LEN + tcp_hdr_len)
+        tcp_data_len = 0;
+    else
+        tcp_data_len = ip_total_len - IP_HEADER_LEN - tcp_hdr_len;
+
+    payload = &data[TCP_OFF + tcp_hdr_len];
+
+    /* Verify TCP checksum */
+    {
+        uint32_t tcp_segment_len = ip_total_len - IP_HEADER_LEN;
+        uint32_t pseudo = tcp_pseudo_sum(src_ip, &data[IP_OFFSET + 16],
+                                         tcp_segment_len);
+        uint16_t cksum = net_checksum(&data[TCP_OFF], tcp_segment_len, pseudo);
+        if (cksum != 0)
+            return;
+    }
+
+    /* Find matching connection */
+    conn = conn_find(src_ip, src_port, dst_port);
+
+    /* ---- RST handling ---- */
+    if (flags & TCP_FLAG_RST) {
+        if (conn && conn->state != TCP_STATE_LISTEN) {
+            conn_close_notify(conn);
+        }
+        return;
+    }
+
+    /* ---- No matching connection ---- */
+    if (!conn) {
+        /* Send RST for unexpected segments (not RST themselves) */
+        if (!(flags & TCP_FLAG_RST)) {
+            tcp_send_rst(src_ip, src_mac, dst_port, src_port,
+                         ack_num, seq_num + tcp_data_len +
+                         ((flags & TCP_FLAG_SYN) ? 1 : 0));
+        }
+        return;
+    }
+
+    /* ---- LISTEN state: handle incoming SYN ---- */
+    if (conn->state == TCP_STATE_LISTEN) {
+        if (!(flags & TCP_FLAG_SYN))
+            return;
+
+        /* Transition to ESTABLISHED (simplified: skip SYN_RCVD) */
+        memcpy(conn->dst_ip, src_ip, 4);
+        conn->dst_port = src_port;
+        memcpy(conn->mac, src_mac, 6);
+        conn->ack = seq_num + 1;
+
+        /* Send SYN+ACK */
+        tcp_send_segment(conn, TCP_FLAG_SYN | TCP_FLAG_ACK,
+                         (const uint8_t *)0, 0, 1);
+        conn->seq++; /* SYN consumes one byte */
+        conn->state = TCP_STATE_ESTABLISHED;
+        conn->lock_send = 0;
+
+        if (conn->callback)
+            conn->callback(conn, TCP_CONNECTED, (const uint8_t *)0, 0);
+        return;
+    }
+
+    /* ---- SYN_SENT state: expecting SYN+ACK ---- */
+    if (conn->state == TCP_STATE_SYN_SENT) {
+        if ((flags & (TCP_FLAG_SYN | TCP_FLAG_ACK)) !=
+            (TCP_FLAG_SYN | TCP_FLAG_ACK))
+            return;
+
+        /* Validate ACK */
+        if (ack_num != conn->seq)
+            return;
+
+        conn->ack = seq_num + 1;
+        conn->state = TCP_STATE_ESTABLISHED;
+        conn->lock_send = 0;
+        conn->last_sent_len = 0; /* Clear retransmit buffer */
+
+        /* Send ACK */
+        tcp_send_segment(conn, TCP_FLAG_ACK,
+                         (const uint8_t *)0, 0, 0);
+
+        if (conn->callback)
+            conn->callback(conn, TCP_CONNECTED, (const uint8_t *)0, 0);
+        return;
+    }
+
+    /* ---- ESTABLISHED state ---- */
+    if (conn->state == TCP_STATE_ESTABLISHED) {
+        /* Process ACK */
+        if (flags & TCP_FLAG_ACK) {
+            /* Check if this ACKs our last sent data */
+            if (conn->lock_send && ack_num == conn->seq) {
+                conn->lock_send = 0;
+                conn->last_sent_len = 0;
+
+                /* Check for deferred close */
+                if (conn->close_pending) {
+                    conn->close_pending = 0;
+                    tcp_send_segment(conn, TCP_FLAG_FIN | TCP_FLAG_ACK,
+                                     (const uint8_t *)0, 0, 1);
+                    conn->seq++;
+                    conn->state = TCP_STATE_FIN_WAIT;
+                    return;
+                }
+
+                /* Notify writable */
+                if (conn->callback)
+                    conn->callback(conn, TCP_WRITABLE, (const uint8_t *)0, 0);
+            }
+        }
+
+        /* Process incoming data */
+        if (tcp_data_len > 0 && seq_num == conn->ack) {
+            conn->ack += tcp_data_len;
+
+            /* Send ACK for the received data */
+            tcp_send_segment(conn, TCP_FLAG_ACK,
+                             (const uint8_t *)0, 0, 0);
+
+            if (conn->callback)
+                conn->callback(conn, TCP_DATA, payload, tcp_data_len);
+        }
+
+        /* FIN received */
+        if (flags & TCP_FLAG_FIN) {
+            conn->ack = seq_num + tcp_data_len + 1;
+            tcp_send_segment(conn, TCP_FLAG_FIN | TCP_FLAG_ACK,
+                             (const uint8_t *)0, 0, 0);
+            conn->seq++;
+            conn_close_notify(conn);
+        }
+        return;
+    }
+
+    /* ---- FIN_WAIT state: expecting ACK of our FIN ---- */
+    if (conn->state == TCP_STATE_FIN_WAIT) {
+        if (flags & TCP_FLAG_ACK) {
+            if (ack_num == conn->seq) {
+                /* Our FIN has been ACKed */
+                if (flags & TCP_FLAG_FIN) {
+                    /* Simultaneous close: ACK the remote FIN */
+                    conn->ack = seq_num + 1;
+                    tcp_send_segment(conn, TCP_FLAG_ACK,
+                                     (const uint8_t *)0, 0, 0);
+                }
+                conn_close_notify(conn);
+            }
+        } else if (flags & TCP_FLAG_FIN) {
+            /* Remote FIN without ACKing ours yet */
+            conn->ack = seq_num + 1;
+            tcp_send_segment(conn, TCP_FLAG_ACK,
+                             (const uint8_t *)0, 0, 0);
+        }
+        return;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Timer                                                               */
+/* ------------------------------------------------------------------ */
+
+void tcp_timer(void)
+{
+    uint32_t now = net_time_s();
+    int i;
+
+    for (i = 0; i < NET_TCP_MAX_CONN; i++) {
+        struct tcp_conn *conn = &tcp_conns[i];
+
+        if (!conn->enabled)
+            continue;
+
+        /* Only retransmit if we have something saved */
+        if (conn->last_sent_len == 0)
+            continue;
+
+        /* Check if it's time to retransmit */
+        if (now - conn->last_sent_time < TCP_RETRANSMIT_S)
+            continue;
+
+        conn->retry_count++;
+
+        if (conn->retry_count > TCP_MAX_RETRIES) {
+            DBG_MAIN("[tcp] max retries exceeded, closing\r\n");
+            conn_close_notify(conn);
+            continue;
+        }
+
+        /* Retransmit the saved segment */
+        conn->last_sent_time = now;
+        net_send(conn->last_sent, conn->last_sent_len, conn->mac, 0);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Reset                                                               */
+/* ------------------------------------------------------------------ */
+
+void tcp_reset(void)
+{
+    memset(tcp_conns, 0, sizeof(tcp_conns));
+    memset(tcp_connect_ctxs, 0, sizeof(tcp_connect_ctxs));
+    tcp_ephemeral_counter = 0;
+}
diff --git a/src/app/net/net_udp.c b/src/app/net/net_udp.c
new file mode 100644
index 0000000..e0bd2fd
--- /dev/null
+++ b/src/app/net/net_udp.c
@@ -0,0 +1,260 @@
+/**
+ * @file net_udp.c
+ * @brief UDP — User Datagram Protocol (RFC 768)
+ *
+ * Simple port-based demultiplexer with up to 4 bound listeners, plus
+ * a send function that handles ARP resolution when needed.
+ *
+ * UDP packet layout within LLC/SNAP+IP frame:
+ *   [0..7]    LLC/SNAP header
+ *   [8..27]   IP header (20 bytes)
+ *   [28..35]  UDP header (8 bytes):
+ *     [28..29] Source port
+ *     [30..31] Destination port
+ *     [32..33] Length (header + data)
+ *     [34..35] Checksum (optional, 0 = none)
+ *   [36..]    Payload
+ */
+
+#include <stdint.h>
+#include <string.h>
+#include "app/net/net_core.h"
+#include "app/net/net_ip.h"
+#include "app/net/net_udp.h"
+#include "app/net/net_arp.h"
+#include "utils/debug.h"
+
+/* ------------------------------------------------------------------ */
+/* Listener table                                                      */
+/* ------------------------------------------------------------------ */
+
+struct udp_listener {
+    uint16_t       port;
+    udp_callback_t callback;
+    int32_t        active;
+};
+
+static struct udp_listener udp_listeners[NET_UDP_MAX_LISTENERS];
+
+/* ------------------------------------------------------------------ */
+/* UDP header offsets (relative to frame start)                         */
+/* ------------------------------------------------------------------ */
+
+#define UDP_OFF         (LLC_SNAP_LEN + IP_HEADER_LEN)  /* 28 */
+#define UDP_SRC_PORT    (UDP_OFF + 0)
+#define UDP_DST_PORT    (UDP_OFF + 2)
+#define UDP_LENGTH      (UDP_OFF + 4)
+#define UDP_CHECKSUM    (UDP_OFF + 6)
+#define UDP_HEADER_LEN  8
+#define UDP_DATA_OFF    (UDP_OFF + UDP_HEADER_LEN)  /* 36 */
+
+/* ------------------------------------------------------------------ */
+/* Port binding                                                        */
+/* ------------------------------------------------------------------ */
+
+int32_t udp_bind(uint16_t port, udp_callback_t callback)
+{
+    int i;
+
+    /* Check for duplicate */
+    for (i = 0; i < NET_UDP_MAX_LISTENERS; i++) {
+        if (udp_listeners[i].active && udp_listeners[i].port == port) {
+            udp_listeners[i].callback = callback;
+            return 0;
+        }
+    }
+
+    /* Find free slot */
+    for (i = 0; i < NET_UDP_MAX_LISTENERS; i++) {
+        if (!udp_listeners[i].active) {
+            udp_listeners[i].port     = port;
+            udp_listeners[i].callback = callback;
+            udp_listeners[i].active   = 1;
+            return 0;
+        }
+    }
+
+    DBG_MAIN("[udp] bind: table full\r\n");
+    return -1;
+}
+
+void udp_unbind(uint16_t port)
+{
+    int i;
+    for (i = 0; i < NET_UDP_MAX_LISTENERS; i++) {
+        if (udp_listeners[i].active && udp_listeners[i].port == port) {
+            udp_listeners[i].active = 0;
+            return;
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Receive                                                             */
+/* ------------------------------------------------------------------ */
+
+void udp_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac)
+{
+    uint16_t src_port, dst_port, udp_len;
+    uint32_t payload_len;
+    const uint8_t *src_ip;
+    int i;
+
+    /* Minimum size: LLC/SNAP + IP + UDP header */
+    if (len < UDP_DATA_OFF)
+        return;
+
+    src_port = net_get16(data, UDP_SRC_PORT);
+    dst_port = net_get16(data, UDP_DST_PORT);
+    udp_len  = net_get16(data, UDP_LENGTH);
+
+    /* Sanity check UDP length */
+    if (udp_len < UDP_HEADER_LEN)
+        return;
+    if (UDP_OFF + udp_len > len)
+        return;
+
+    payload_len = udp_len - UDP_HEADER_LEN;
+    src_ip = &data[IP_OFFSET + 12]; /* IP source address */
+
+    /* Dispatch to registered listener */
+    for (i = 0; i < NET_UDP_MAX_LISTENERS; i++) {
+        if (udp_listeners[i].active && udp_listeners[i].port == dst_port) {
+            udp_listeners[i].callback(&data[UDP_DATA_OFF], payload_len,
+                                      src_ip, src_port, src_mac);
+            return;
+        }
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Send — context for deferred ARP resolution                          */
+/* ------------------------------------------------------------------ */
+
+/**
+ * Context structure saved when we need to ARP-resolve before sending.
+ * Since we have no malloc, we use a small static pool.
+ */
+#define UDP_SEND_QUEUE_SIZE 4
+#define UDP_SEND_MAX_DATA   512
+
+struct udp_send_ctx {
+    uint8_t  dst_ip[4];
+    uint16_t dst_port;
+    uint16_t src_port;
+    uint8_t  data[UDP_SEND_MAX_DATA];
+    uint32_t len;
+    int32_t  active;
+};
+
+static struct udp_send_ctx udp_send_queue[UDP_SEND_QUEUE_SIZE] __attribute__((section(".extram")));
+
+/**
+ * Internal: build and transmit a UDP packet to a known MAC.
+ */
+static void udp_send_raw(const uint8_t *dst_ip, uint16_t dst_port,
+                          uint16_t src_port, const uint8_t *payload,
+                          uint32_t payload_len, const uint8_t *dst_mac)
+{
+    /* Static to avoid 1536-byte stack frame — only one send at a time */
+    static uint8_t frame[LLC_SNAP_LEN + IP_HEADER_LEN + UDP_HEADER_LEN + 1500];
+    uint32_t hdr_len;
+    uint16_t udp_len;
+    uint32_t total_len;
+    uint32_t pseudo_sum;
+
+    if (payload_len > 1472) /* max UDP payload in a single frame */
+        payload_len = 1472;
+
+    udp_len = UDP_HEADER_LEN + (uint16_t)payload_len;
+    hdr_len = ip_build(frame, net_ip, dst_ip, IP_PROTO_UDP, udp_len);
+    (void)hdr_len;
+
+    /* UDP header */
+    net_put16(frame, UDP_SRC_PORT, src_port);
+    net_put16(frame, UDP_DST_PORT, dst_port);
+    net_put16(frame, UDP_LENGTH,   udp_len);
+    net_put16(frame, UDP_CHECKSUM, 0);  /* optional: 0 = no checksum */
+
+    /* Payload */
+    memcpy(&frame[UDP_DATA_OFF], payload, payload_len);
+
+    /* Compute UDP checksum using pseudo-header */
+    pseudo_sum = 0;
+    pseudo_sum += ((uint32_t)net_ip[0] << 8) | net_ip[1];
+    pseudo_sum += ((uint32_t)net_ip[2] << 8) | net_ip[3];
+    pseudo_sum += ((uint32_t)dst_ip[0] << 8) | dst_ip[1];
+    pseudo_sum += ((uint32_t)dst_ip[2] << 8) | dst_ip[3];
+    pseudo_sum += IP_PROTO_UDP;
+    pseudo_sum += udp_len;
+
+    {
+        uint16_t cksum = net_checksum(&frame[UDP_OFF], udp_len, pseudo_sum);
+        if (cksum == 0)
+            cksum = 0xFFFF; /* RFC 768: transmitted as all ones if computed as zero */
+        net_put16(frame, UDP_CHECKSUM, cksum);
+    }
+
+    /* Finalize IP header checksum */
+    ip_finalize(frame);
+
+    total_len = UDP_DATA_OFF + payload_len;
+    net_send(frame, total_len, dst_mac, 0);
+}
+
+/**
+ * ARP resolution callback for deferred UDP sends.
+ */
+static void udp_arp_callback(const uint8_t *mac, void *ctx)
+{
+    struct udp_send_ctx *sc = (struct udp_send_ctx *)ctx;
+
+    if (mac && sc->active) {
+        udp_send_raw(sc->dst_ip, sc->dst_port, sc->src_port,
+                     sc->data, sc->len, mac);
+    }
+
+    sc->active = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Public send                                                         */
+/* ------------------------------------------------------------------ */
+
+void udp_send(const uint8_t *dst_ip, uint16_t dst_port, uint16_t src_port,
+              const uint8_t *data, uint32_t len, const uint8_t *dst_mac)
+{
+    if (dst_mac) {
+        /* MAC already known — send immediately */
+        udp_send_raw(dst_ip, dst_port, src_port, data, len, dst_mac);
+    } else {
+        /* Need ARP resolution — queue the packet */
+        int i;
+        for (i = 0; i < UDP_SEND_QUEUE_SIZE; i++) {
+            if (!udp_send_queue[i].active) {
+                memcpy(udp_send_queue[i].dst_ip, dst_ip, 4);
+                udp_send_queue[i].dst_port = dst_port;
+                udp_send_queue[i].src_port = src_port;
+                if (len > UDP_SEND_MAX_DATA)
+                    len = UDP_SEND_MAX_DATA;
+                memcpy(udp_send_queue[i].data, data, len);
+                udp_send_queue[i].len    = len;
+                udp_send_queue[i].active = 1;
+
+                arp_resolve(dst_ip, udp_arp_callback, &udp_send_queue[i]);
+                return;
+            }
+        }
+        DBG_MAIN("[udp] send queue full, dropping packet\r\n");
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Reset                                                               */
+/* ------------------------------------------------------------------ */
+
+void udp_reset(void)
+{
+    memset(udp_listeners,  0, sizeof(udp_listeners));
+    memset(udp_send_queue, 0, sizeof(udp_send_queue));
+}
