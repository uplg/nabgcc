diff --git a/inc/app/http/http_client.h b/inc/app/http/http_client.h
new file mode 100644
index 0000000..951197c
--- /dev/null
+++ b/inc/app/http/http_client.h
@@ -0,0 +1,51 @@
+/**
+ * @file http_client.h
+ * @brief HTTP/1.0 client — GET/POST with DNS resolution
+ *
+ * Single concurrent request. 4096-byte static response buffer.
+ * Supports proxy (from config). 10-second timeout.
+ */
+#ifndef HTTP_CLIENT_H
+#define HTTP_CLIENT_H
+
+#include <stdint.h>
+
+/**
+ * Response callback.
+ * @param status   HTTP status code, or -1 on error/timeout
+ * @param body     Response body (may be NULL on error)
+ * @param body_len Length of body
+ * @param ctx      User context
+ */
+typedef void (*http_response_cb_t)(int32_t status, const uint8_t *body,
+                                   uint32_t body_len, void *ctx);
+
+/**
+ * HTTP GET request.
+ * Parses URL → host:port/path, resolves DNS, connects, sends request.
+ * @param url      Full URL (http://host[:port]/path)
+ * @param callback Called when response is complete or on error
+ * @param ctx      User context passed to callback
+ * @return 0 on success (request started), -1 if busy
+ */
+int32_t http_get(const char *url, http_response_cb_t callback, void *ctx);
+
+/**
+ * HTTP POST request.
+ * @param url       Full URL
+ * @param body      POST body data
+ * @param body_len  Length of body
+ * @param callback  Called when response is complete or on error
+ * @param ctx       User context
+ * @return 0 on success, -1 if busy
+ */
+int32_t http_post(const char *url, const uint8_t *body, uint32_t body_len,
+                  http_response_cb_t callback, void *ctx);
+
+/** Abort a pending request (calls callback with status -1) */
+void http_abort(void);
+
+/** Call periodically from main loop to enforce request timeout */
+void http_client_tick(void);
+
+#endif /* HTTP_CLIENT_H */
