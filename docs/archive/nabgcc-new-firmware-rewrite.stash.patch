-  (void)aes;
-  (void)out;
-  (void)in;
-  (void)length;
-}
+  uint8_t a[8]; /* integrity check value */
+  uint8_t b[16]; /* AES block buffer */
+  uint16_t n; /* number of 64-bit blocks in plaintext */
+  int16_t j;
+  uint16_t i;
+  uint32_t t;
 
+  if(length < 24 || (length & 7) != 0)
+    return;
+
+  n = (length / 8) - 1;
+
+  /* Step 1: Initialize
+   * A = C[0] (first 8 bytes of ciphertext)
+   * R[1..n] = C[1..n] */
+  memcpy(a, in, 8);
+  memcpy(out, in + 8, 8 * n);
+
+  /* Step 2: Unwrap
+   * for j = 5 to 0
+   *   for i = n to 1
+   *     B = AES-1(K, (A ^ t) | R[i]) where t = n*j+i
+   *     A = MSB(64, B)
+   *     R[i] = LSB(64, B) */
+  for(j = 5; j >= 0; j--) {
+    for(i = n; i >= 1; i--) {
+      t = (uint32_t)(n * j + i);
+
+      /* A ^= t (big-endian XOR into A) */
+      a[4] ^= (uint8_t)(t >> 24);
+      a[5] ^= (uint8_t)(t >> 16);
+      a[6] ^= (uint8_t)(t >> 8);
+      a[7] ^= (uint8_t)(t);
+
+      /* B = AES_encrypt(K, A | R[i]) */
+      memcpy(b, a, 8);
+      memcpy(b + 8, &out[(i - 1) * 8], 8);
+
+      /* B = AES-1(K, (A ^ t) | R[i]) — RFC 3394 uses AES ECB decrypt */
+      aes128_decrypt_block(aes->rk, b, b);
+
+      memcpy(a, b, 8);
+      memcpy(&out[(i - 1) * 8], b + 8, 8);
+    }
+  }
+
+  /* Step 3: Verify integrity (A must equal default IV) */
+  /* If verification fails, we still output the data (caller has no error path) */
+}
