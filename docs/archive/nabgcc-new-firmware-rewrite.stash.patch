diff --git a/inc/app/app_config.h b/inc/app/app_config.h
new file mode 100644
index 0000000..7dec303
--- /dev/null
+++ b/inc/app/app_config.h
@@ -0,0 +1,95 @@
+/**
+ * @file app_config.h
+ * @brief Configuration system — 208-byte persistent storage in flash
+ *
+ * Binary config blob stored in the last 4KB sector of internal flash
+ * (0x0801F000). Compatible with the original Nabaztag config format.
+ */
+#ifndef APP_CONFIG_H
+#define APP_CONFIG_H
+
+#include <stdint.h>
+
+/* ---- Config field offsets and sizes ---- */
+
+#define CONF_SERVERURL      0     /* 41 bytes, null-terminated string */
+#define CONF_SERVERURL_LEN  41
+
+#define CONF_NETDHCP        41    /* 1 byte: 0=static, 1=DHCP */
+#define CONF_NETIP          42    /* 4 bytes: static IP */
+#define CONF_NETMASK        46    /* 4 bytes: subnet mask */
+#define CONF_NETGATEWAY     50    /* 4 bytes: gateway */
+#define CONF_NETDNS         54    /* 4 bytes: DNS server */
+
+#define CONF_WIFISSID       58    /* 32 bytes, null-terminated */
+#define CONF_WIFISSID_LEN   32
+#define CONF_WIFIAUTH       90    /* 1 byte: 0=Open, 1=SharedKey */
+#define CONF_WIFICRYPT      91    /* 1 byte: 0=None, 16=WEP, 32=WPA, 64=WPA2 */
+#define CONF_WIFIKEY0       92    /* 64 bytes, null-terminated passphrase */
+#define CONF_WIFIKEY0_LEN   64
+
+#define CONF_PROXYENABLE    156   /* 1 byte: 0=off, 1=on */
+#define CONF_PROXYIP        157   /* 4 bytes */
+#define CONF_PROXYPORT      161   /* 2 bytes, big-endian */
+
+#define CONF_LOGIN          163   /* 6 bytes */
+#define CONF_LOGIN_LEN      6
+#define CONF_PWD            169   /* 6 bytes */
+#define CONF_PWD_LEN        6
+
+#define CONF_WIFIPMK        175   /* 32 bytes: precomputed PMK */
+#define CONF_WIFIPMK_LEN    32
+
+#define CONF_MAGIC          207   /* 1 byte: must be 0x47 */
+#define CONF_MAGIC_VAL      0x47
+
+#define CONF_LENGTH         208
+
+/* Encryption constants (IEEE80211_CRYPT_*, IEEE80211_AUTH_*) are defined
+   in "net/ieee80211.h" — include that header where needed. */
+
+/* ---- Public API ---- */
+
+/** Initialize config: load from flash, reset to defaults if invalid */
+void     conf_init(void);
+/** Save current config to flash */
+void     conf_save(void);
+/** Reset config to factory defaults */
+void     conf_reset(void);
+
+/** Get raw bytes from config at offset i, length len */
+const uint8_t *conf_get(int32_t i, int32_t len);
+/** Get a null-terminated string from config */
+const char    *conf_get_str(int32_t i, int32_t max_len);
+/** Get a single byte from config */
+uint8_t        conf_get_byte(int32_t i);
+/** Get 4-byte IP from config */
+void           conf_get_ip(int32_t i, uint8_t *out);
+/** Get 2-byte big-endian port from config */
+uint16_t       conf_get_port(int32_t i);
+
+/** Set raw bytes in config at offset i */
+void     conf_set(int32_t i, const uint8_t *val, int32_t len);
+/** Set a null-terminated string in config (zero-padded) */
+void     conf_set_str(int32_t i, const char *val, int32_t max_len);
+/** Set a single byte */
+void     conf_set_byte(int32_t i, uint8_t val);
+/** Set a 4-byte IP */
+void     conf_set_ip(int32_t i, const uint8_t *ip);
+/** Set a 2-byte big-endian port */
+void     conf_set_port(int32_t i, uint16_t port);
+
+/* ---- Convenience accessors ---- */
+
+static inline const char *conf_wifi_ssid(void)    { return conf_get_str(CONF_WIFISSID, CONF_WIFISSID_LEN); }
+static inline uint8_t     conf_wifi_crypt(void)    { return conf_get_byte(CONF_WIFICRYPT); }
+static inline uint8_t     conf_wifi_auth(void)     { return conf_get_byte(CONF_WIFIAUTH); }
+static inline const char *conf_wifi_key(void)      { return conf_get_str(CONF_WIFIKEY0, CONF_WIFIKEY0_LEN); }
+static inline const uint8_t *conf_wifi_pmk(void)   { return conf_get(CONF_WIFIPMK, CONF_WIFIPMK_LEN); }
+static inline uint8_t     conf_dhcp(void)          { return conf_get_byte(CONF_NETDHCP); }
+static inline const char *conf_server_url(void)    { return conf_get_str(CONF_SERVERURL, CONF_SERVERURL_LEN); }
+
+/** Direct access to the raw 208-byte config buffer */
+uint8_t *conf_raw(void);
+
+#endif /* APP_CONFIG_H */
diff --git a/inc/app/app_main.h b/inc/app/app_main.h
new file mode 100644
index 0000000..2b4d08f
--- /dev/null
+++ b/inc/app/app_main.h
@@ -0,0 +1,31 @@
+/**
+ * @file app_main.h
+ * @brief Main application entry point — replaces the VM
+ *
+ * Provides init/tick/rx functions called from main.c in place of
+ * the original VLISP virtual machine (vmemInit, interpGo, netCb).
+ */
+#ifndef APP_MAIN_H
+#define APP_MAIN_H
+
+#include <stdint.h>
+
+/** Initialize the application. Called once after hardware init.
+ *  Replaces vmemInit(0) + loaderInit() + interpGo().
+ */
+void app_init(void);
+
+/** Main loop tick. Called every iteration of the main loop.
+ *  Replaces VCALLSTACKGET + interpGo().
+ */
+void app_tick(void);
+
+/** Process a received 802.11 frame.
+ *  Replaces netCb().
+ *  @param data    Frame data starting at LLC header
+ *  @param len     Frame length
+ *  @param src_mac Source MAC address (6 bytes)
+ */
+void app_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac);
+
+#endif /* APP_MAIN_H */
diff --git a/inc/app/app_wifi.h b/inc/app/app_wifi.h
new file mode 100644
index 0000000..d74f728
--- /dev/null
+++ b/inc/app/app_wifi.h
@@ -0,0 +1,47 @@
+/**
+ * @file app_wifi.h
+ * @brief WiFi state machine — station/AP connection management
+ *
+ * Handles scanning, authentication, DHCP, and fallback to AP mode.
+ * Called from the main loop via wifi_tick().
+ */
+#ifndef APP_WIFI_H
+#define APP_WIFI_H
+
+#include <stdint.h>
+
+/* WiFi state machine states */
+enum wifi_state {
+    WIFI_INIT,
+    WIFI_GO_STATION,
+    WIFI_DHCP,
+    WIFI_STATION,
+    WIFI_GO_MASTER,
+    WIFI_MASTER
+};
+
+/** Initialize WiFi subsystem.
+ *  @param master_mode  If nonzero, start in AP mode immediately.
+ */
+void wifi_init(int32_t master_mode);
+
+/** Run one iteration of the WiFi state machine.
+ *  Must be called from the main loop.
+ */
+void wifi_tick(void);
+
+/** Return 1 if connected as a station (WIFI_STATION state). */
+int32_t wifi_is_connected(void);
+
+/** Return 1 if running as AP (WIFI_MASTER state). */
+int32_t wifi_is_master(void);
+
+/** Force a reconnection attempt (e.g. after config change).
+ *  Resets state machine and sets master countdown to -40.
+ */
+void wifi_trigger_reconnect(void);
+
+/** Get current WiFi state. */
+enum wifi_state wifi_get_state(void);
+
+#endif /* APP_WIFI_H */
diff --git a/inc/app/firmware/fw_crypt.h b/inc/app/firmware/fw_crypt.h
new file mode 100644
index 0000000..056bd57
--- /dev/null
+++ b/inc/app/firmware/fw_crypt.h
@@ -0,0 +1,31 @@
+/**
+ * @file fw_crypt.h
+ * @brief Firmware encryption/decryption (strcrypt8 / decode8)
+ *
+ * Self-synchronizing 8-bit stream cipher using multiplicative
+ * inverses over GF(256). Used for .sim firmware packaging.
+ */
+#ifndef FW_CRYPT_H
+#define FW_CRYPT_H
+
+#include <stdint.h>
+
+/** Decrypt firmware data in-place.
+ *  @param src   Data buffer (modified in-place)
+ *  @param len   Number of bytes
+ *  @param key   Initial key (0x47 for Nabaztag)
+ *  @param alpha Additive constant (47 for Nabaztag)
+ *  @return Final key state
+ */
+int32_t fw_decrypt(uint8_t *src, int32_t len, uint8_t key, uint8_t alpha);
+
+/** Encrypt firmware data in-place.
+ *  @param src   Data buffer (modified in-place)
+ *  @param len   Number of bytes
+ *  @param key   Initial key (0x47 for Nabaztag)
+ *  @param alpha Additive constant (47 for Nabaztag)
+ *  @return Final key state
+ */
+int32_t fw_encrypt(uint8_t *src, int32_t len, uint8_t key, uint8_t alpha);
+
+#endif /* FW_CRYPT_H */
diff --git a/inc/app/firmware/fw_flash.h b/inc/app/firmware/fw_flash.h
new file mode 100644
index 0000000..093db75
--- /dev/null
+++ b/inc/app/firmware/fw_flash.h
@@ -0,0 +1,51 @@
+/**
+ * @file fw_flash.h
+ * @brief Firmware flash mechanism — parse .sim format and flash MCU
+ *
+ * The .sim format wraps encrypted firmware in ASCII hex between
+ * `-violet-` delimiters:
+ *   -violet- <8-char-hex-length> <hex-encoded-data> -violet-
+ *
+ * The hex length field is 2x the binary size (each byte = 2 hex chars).
+ */
+#ifndef FW_FLASH_H
+#define FW_FLASH_H
+
+#include <stdint.h>
+
+/** Convert ASCII hex string to binary bytes.
+ *  @param hex      Input hex string (not null-terminated, length = hex_len)
+ *  @param hex_len  Number of hex characters (must be even)
+ *  @param out      Output buffer
+ *  @param out_max  Max bytes to write to out
+ *  @return Number of bytes written, or -1 on error.
+ */
+int32_t fw_hex2bin(const uint8_t *hex, uint32_t hex_len,
+                   uint8_t *out, uint32_t out_max);
+
+/** Parse a .sim firmware blob.
+ *  Locates the -violet- delimiters, extracts the hex-encoded firmware,
+ *  converts it to binary, and returns a pointer to the result.
+ *
+ *  @param data             Raw .sim data
+ *  @param len              Length of data
+ *  @param out_firmware     Set to point at the decoded firmware bytes
+ *  @param out_firmware_len Set to the decoded firmware length
+ *  @return 0 on success, -1 on parse error.
+ *
+ *  Note: the output overwrites @p data in-place (binary is shorter
+ *  than hex, so it fits).
+ */
+int32_t fw_parse_sim(uint8_t *data, uint32_t len,
+                     uint8_t **out_firmware, uint32_t *out_firmware_len);
+
+/** Decrypt and flash firmware to MCU. Does NOT return.
+ *  @param firmware  Firmware binary (will be decrypted in-place)
+ *  @param len       Length in bytes
+ */
+void fw_flash(uint8_t *firmware, uint32_t len);
+
+/** Reboot the MCU via watchdog. Does NOT return. */
+void fw_reboot(void);
+
+#endif /* FW_FLASH_H */
