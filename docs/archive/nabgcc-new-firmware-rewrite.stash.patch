+++ b/src/app/app_main.c
@@ -0,0 +1,100 @@
+/**
+ * @file app_main.c
+ * @brief Main application entry point — replaces the VLISP VM
+ *
+ * Provides app_init(), app_tick(), and app_rx() which are called
+ * from main.c in place of vmemInit/interpGo/netCb.
+ */
+#include <stdint.h>
+#include <string.h>
+
+#include "common.h"
+#include "utils/debug.h"
+#include "usb/rt2501usb.h"
+
+#include "app/app_main.h"
+#include "app/app_config.h"
+#include "app/app_wifi.h"
+#include "app/net/net_core.h"
+#include "app/http/http_api.h"
+#include "app/http/http_client.h"
+
+/* ---- External functions ---- */
+
+extern uint8_t push_button_value(void);
+
+/* ---- Audio VM callback stubs ---- */
+/* These were originally provided by vaudio.c (the VM audio bridge).
+   audio.c calls them from rec_check/play_check. With the VM removed,
+   we provide no-op stubs so the audio HAL links without errors.
+   Audio playback/recording is not used in the current firmware. */
+
+int32_t audioPlayTryFeed(int32_t ask)  { (void)ask; return 0; }
+int32_t audioPlayFetchByte(void)       { return -1; }
+char   *audioRecFeed_begin(int32_t sz) { (void)sz; return (char *)0; }
+void    audioRecFeed_end(void)         { }
+
+/* ---- Private state ---- */
+
+static uint32_t last_timer_s;       /* last second we ran net_timer */
+static int32_t  master_mode;        /* 1 if button held at boot */
+
+/* ---- Implementation ---- */
+
+void app_init(void)
+{
+    DBG_MAIN("app: init"EOL);
+
+    /* 1. Load configuration from flash */
+    conf_init();
+
+    /* 2. Copy RT2501 MAC into the network stack */
+    memcpy(net_mac, rt2501_mac, 6);
+
+#ifdef DEBUG_MAIN
+    sprintf(dbg_buffer, "app: MAC %02x:%02x:%02x:%02x:%02x:%02x"EOL,
+            net_mac[0], net_mac[1], net_mac[2],
+            net_mac[3], net_mac[4], net_mac[5]);
+    DBG_MAIN(dbg_buffer);
+#endif
+
+    /* 3. Check push button — if held, start in AP (master) mode */
+    master_mode = push_button_value() ? 1 : 0;
+    if (master_mode) {
+        DBG_MAIN("app: button held, AP mode"EOL);
+    }
+
+    /* 4. Initialize network subsystem */
+    net_init();
+
+    /* 5. Initialize WiFi state machine */
+    wifi_init(master_mode);
+
+    /* 6. Register HTTP API routes (starts server when WiFi is up) */
+    api_init();
+
+    /* Initialize timer tracking */
+    last_timer_s = counter_timer_s;
+
+    DBG_MAIN("app: ready"EOL);
+}
+
+void app_tick(void)
+{
+    /* Run the WiFi state machine */
+    wifi_tick();
+
+    /* HTTP client timeout enforcement */
+    http_client_tick();
+
+    /* One-second timer: run net_timer for ARP, TCP, DNS, etc. */
+    if (counter_timer_s != last_timer_s) {
+        last_timer_s = counter_timer_s;
+        net_timer();
+    }
+}
+
+void app_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac)
+{
+    net_rx(data, len, src_mac);
+}
diff --git a/src/app/app_wifi.c b/src/app/app_wifi.c
new file mode 100644
index 0000000..4526e36
--- /dev/null
+++ b/src/app/app_wifi.c
@@ -0,0 +1,456 @@
+/**
+ * @file app_wifi.c
+ * @brief WiFi state machine — station/AP connection management
+ *
+ * Manages the full WiFi lifecycle: scan, authenticate, DHCP,
+ * and fallback to AP mode when no configured network is reachable.
+ */
+#include <stdint.h>
+#include <string.h>
+#ifdef DEBUG_MAIN
+#include <stdio.h>
+#endif
+
+#include "common.h"
+#include "utils/debug.h"
+#include "hal/led.h"
+#include "usb/rt2501usb.h"
+#include "net/ieee80211.h"
+
+#include "app/app_wifi.h"
+#include "app/app_config.h"
+#include "app/net/net_core.h"
+#include "app/net/net_dhcp.h"
+#include "app/net/net_dns.h"
+#include "app/http/http_server.h"
+
+/* ---- External functions ---- */
+
+extern void mypassword_to_pmk(const uint8_t *password,
+                              uint8_t *ssid, uint16_t ssidlength,
+                              uint8_t *pmk);
+
+/* ---- Constants ---- */
+
+#define WIFI_MAX_SCAN       16   /* max stored scan results */
+#define WIFI_MAX_RETRIES    2    /* auth retries before trying next AP */
+#define WIFI_DHCP_TIMEOUT   3    /* seconds before DHCP retry */
+#define WIFI_MASTER_SSID    "Nabaztag"
+#define WIFI_MASTER_CHANNEL 6
+
+/* LED colors for connection progress */
+#define LED_COLOR_SCANNING  0x00003F   /* dim blue */
+#define LED_COLOR_CONNECTING 0x003F3F  /* cyan */
+#define LED_COLOR_DHCP      0x003F00   /* green */
+#define LED_COLOR_CONNECTED 0x000000   /* off (connected = quiet) */
+#define LED_COLOR_MASTER    0x3F003F   /* magenta */
+#define LED_COLOR_ERROR     0x3F0000   /* red */
+
+/* ---- Scan result storage ---- */
+
+static struct rt2501_scan_result scan_results[WIFI_MAX_SCAN] __attribute__((section(".extram")));
+static int32_t scan_count;
+
+/* ---- State ---- */
+
+static enum wifi_state state;
+static int32_t want_master;          /* requested mode at init */
+static int32_t wifi_retries;         /* auth retry counter */
+static int32_t scan_index;           /* index into scan_results for next AP to try */
+static uint32_t dhcp_start_time;     /* timestamp when DHCP started (seconds) */
+static int32_t master_countdown;     /* seconds remaining in AP mode (-40 on reconnect) */
+static uint8_t pmk_buf[32];         /* pre-computed PMK for WPA/WPA2 */
+static int32_t scan_done;           /* flag: scan callback completed */
+
+/* ---- Forward declarations ---- */
+
+static void wifi_scan_callback(struct rt2501_scan_result *result, void *userparam);
+static void wifi_start_scan(void);
+static void wifi_try_auth(void);
+static void wifi_set_leds(uint32_t color);
+static int32_t wifi_find_configured_ap(void);
+static void wifi_enter_master(void);
+
+/* ---- LED helper ---- */
+
+static void wifi_set_leds(uint32_t color)
+{
+    uint8_t i;
+    for (i = 0; i < 5; i++)
+        set_led(i, color);
+}
+
+/* ---- Scan callback ---- */
+
+/**
+ * Called by rt2501_scan() for each discovered AP.
+ * Stores results, deduplicates by SSID, keeps sorted by RSSI (descending).
+ */
+static void wifi_scan_callback(struct rt2501_scan_result *result, void *userparam)
+{
+    int32_t i, j;
+    (void)userparam;
+
+    if (!result) {
+        scan_done = 1;
+        return;
+    }
+
+    /* Deduplicate: if SSID already exists, keep the one with stronger RSSI */
+    for (i = 0; i < scan_count; i++) {
+        if (strcmp((char *)scan_results[i].ssid, (char *)result->ssid) == 0) {
+            if (result->rssi > scan_results[i].rssi) {
+                memcpy(&scan_results[i], result, sizeof(struct rt2501_scan_result));
+            }
+            return;
+        }
+    }
+
+    if (scan_count >= WIFI_MAX_SCAN)
+        return;
+
+    /* Insert sorted by RSSI descending */
+    for (i = 0; i < scan_count; i++) {
+        if (result->rssi > scan_results[i].rssi)
+            break;
+    }
+    /* Shift entries down */
+    for (j = scan_count; j > i; j--)
+        memcpy(&scan_results[j], &scan_results[j - 1], sizeof(struct rt2501_scan_result));
+
+    memcpy(&scan_results[i], result, sizeof(struct rt2501_scan_result));
+    scan_count++;
+}
+
+/* ---- Scan trigger ---- */
+
+static void wifi_start_scan(void)
+{
+    scan_count = 0;
+    scan_done = 0;
+    wifi_set_leds(LED_COLOR_SCANNING);
+    DBG_MAIN("wifi: scanning..."EOL);
+    rt2501_scan(NULL, wifi_scan_callback, NULL);
+}
+
+/* ---- Find the configured SSID in scan results ---- */
+
+/**
+ * Search scan_results for an AP matching the configured SSID.
+ * Returns index, or -1 if not found.
+ */
+static int32_t wifi_find_configured_ap(void)
+{
+    const char *ssid = conf_wifi_ssid();
+    int32_t i;
+
+    if (!ssid || ssid[0] == '\0')
+        return -1;
+
+    for (i = 0; i < scan_count; i++) {
+        if (strcmp((char *)scan_results[i].ssid, ssid) == 0)
+            return i;
+    }
+    return -1;
+}
+
+/* ---- Authentication ---- */
+
+/**
+ * Attempt to authenticate with the AP at scan_results[scan_index].
+ * Computes PMK if needed, then calls rt2501_auth().
+ */
+static void wifi_try_auth(void)
+{
+    struct rt2501_scan_result *ap;
+    uint8_t crypt;
+    uint8_t auth;
+    const uint8_t *key;
+
+    if (scan_index < 0 || scan_index >= scan_count) {
+        DBG_MAIN("wifi: no AP to auth"EOL);
+        return;
+    }
+
+    ap = &scan_results[scan_index];
+    crypt = conf_wifi_crypt();
+    auth  = conf_wifi_auth();
+
+    wifi_set_leds(LED_COLOR_CONNECTING);
+
+#ifdef DEBUG_MAIN
+    sprintf(dbg_buffer, "wifi: auth ssid=%s ch=%d crypt=%d"EOL,
+            ap->ssid, ap->channel, crypt);
+    DBG_MAIN(dbg_buffer);
+#endif
+
+    if (crypt == IEEE80211_CRYPT_WPA || crypt == IEEE80211_CRYPT_WPA2) {
+        /* Check if we have a precomputed PMK, otherwise derive it */
+        const uint8_t *stored_pmk = conf_wifi_pmk();
+        int32_t pmk_valid = 0;
+        int32_t k;
+        for (k = 0; k < 32; k++) {
+            if (stored_pmk[k] != 0) {
+                pmk_valid = 1;
+                break;
+            }
+        }
+        if (pmk_valid) {
+            memcpy(pmk_buf, stored_pmk, 32);
+        } else {
+            /* Derive PMK from passphrase */
+            mypassword_to_pmk(
+                (const uint8_t *)conf_wifi_key(),
+                (uint8_t *)ap->ssid,
+                strlen((char *)ap->ssid),
+                pmk_buf);
+        }
+        key = pmk_buf;
+    } else {
+        /* WEP or open: use key directly */
+        key = (const uint8_t *)conf_wifi_key();
+    }
+
+    rt2501_auth(ap->ssid, ap->mac, ap->bssid,
+                ap->channel, ap->rateset,
+                auth, crypt, key);
+}
+
+/* ---- Enter AP (master) mode ---- */
+
+static void wifi_enter_master(void)
+{
+    DBG_MAIN("wifi: entering AP mode"EOL);
+    wifi_set_leds(LED_COLOR_MASTER);
+
+    rt2501_setmode(IEEE80211_M_MASTER,
+                   (const uint8_t *)WIFI_MASTER_SSID,
+                   WIFI_MASTER_CHANNEL);
+
+    /* Configure network for AP mode */
+    memcpy(net_ip,   NET_MASTER_IP,   4);
+    memcpy(net_mask,  NET_MASTER_MASK, 4);
+    memset(net_gateway, 0, 4);
+    memset(net_dns_server,     0, 4);
+
+    state = WIFI_GO_MASTER;
+}
+
+/* ---- Public API ---- */
+
+void wifi_init(int32_t master_mode)
+{
+    state = WIFI_INIT;
+    want_master = master_mode;
+    wifi_retries = 0;
+    scan_index = -1;
+    scan_count = 0;
+    scan_done = 0;
+    dhcp_start_time = 0;
+    master_countdown = 0;
+
+    DBG_MAIN("wifi: init"EOL);
+
+    if (master_mode) {
+        DBG_MAIN("wifi: master mode requested"EOL);
+    }
+}
+
+void wifi_tick(void)
+{
+    int32_t hw_state = rt2501_state();
+
+    switch (state) {
+
+    case WIFI_INIT:
+        /* Wait for the RT2501 hardware to be ready */
+        if (hw_state == RT2501_S_IDLE) {
+            if (want_master) {
+                wifi_enter_master();
+            } else {
+                /* Start scanning for networks */
+                wifi_start_scan();
+                state = WIFI_GO_STATION;
+                wifi_retries = 0;
+                scan_index = -1;
+            }
+        }
+        break;
+
+    case WIFI_GO_STATION:
+        if (hw_state == RT2501_S_IDLE) {
+            /* Scan completed or auth failed — need to (re)try */
+            if (scan_index < 0) {
+                /* First attempt: find configured AP in scan results */
+                scan_index = wifi_find_configured_ap();
+                if (scan_index < 0) {
+                    /* Configured AP not found — try all scan results */
+                    DBG_MAIN("wifi: configured SSID not found"EOL);
+                    wifi_retries++;
+                    if (wifi_retries >= WIFI_MAX_RETRIES) {
+                        /* Fallback to AP mode */
+                        DBG_MAIN("wifi: fallback to AP mode"EOL);
+                        wifi_enter_master();
+                        break;
+                    }
+                    /* Retry scan */
+                    wifi_start_scan();
+                    break;
+                }
+                wifi_retries = 0;
+            }
+
+            /* Try authenticating with the selected AP */
+            wifi_try_auth();
+        } else if (hw_state == RT2501_S_CONNECTED) {
+            /* Successfully associated! Start DHCP */
+            DBG_MAIN("wifi: connected to AP"EOL);
+            wifi_set_leds(LED_COLOR_DHCP);
+
+            if (conf_dhcp()) {
+                /* Clear IP before DHCP */
+                memset(net_ip, 0, 4);
+                dhcp_client_start();
+                dhcp_start_time = counter_timer_s;
+                state = WIFI_DHCP;
+            } else {
+                /* Static IP from config */
+                conf_get_ip(CONF_NETIP, net_ip);
+                conf_get_ip(CONF_NETMASK, net_mask);
+                conf_get_ip(CONF_NETGATEWAY, net_gateway);
+                conf_get_ip(CONF_NETDNS, net_dns_server);
+                state = WIFI_STATION;
+                wifi_set_leds(LED_COLOR_CONNECTED);
+                DBG_MAIN("wifi: static IP configured"EOL);
+                dns_reset();
+                http_server_start(80);
+            }
+        } else if (hw_state == RT2501_S_BROKEN) {
+            /* Hardware error — retry */
+            DBG_MAIN("wifi: hardware broken, retrying"EOL);
+            wifi_set_leds(LED_COLOR_ERROR);
+            wifi_retries++;
+            if (wifi_retries >= WIFI_MAX_RETRIES) {
+                wifi_enter_master();
+            } else {
+                state = WIFI_INIT;
+            }
+        }
+        /* RT2501_S_CONNECTING / RT2501_S_SCAN — just wait */
+        break;
+
+    case WIFI_DHCP:
+        if (net_ip[0] != 0 || net_ip[1] != 0 ||
+            net_ip[2] != 0 || net_ip[3] != 0) {
+            /* Got an IP address */
+#ifdef DEBUG_MAIN
+            sprintf(dbg_buffer, "wifi: DHCP got %d.%d.%d.%d"EOL,
+                    net_ip[0], net_ip[1], net_ip[2], net_ip[3]);
+            DBG_MAIN(dbg_buffer);
+#endif
+            state = WIFI_STATION;
+            wifi_set_leds(LED_COLOR_CONNECTED);
+            dns_reset();
+            http_server_start(80);
+        } else if (counter_timer_s - dhcp_start_time >= WIFI_DHCP_TIMEOUT) {
+            /* DHCP timeout — retry */
+            DBG_MAIN("wifi: DHCP timeout, retrying"EOL);
+            dhcp_client_start();
+            dhcp_start_time = counter_timer_s;
+        }
+
+        /* Check if we lost association while waiting for DHCP */
+        if (hw_state != RT2501_S_CONNECTED) {
+            DBG_MAIN("wifi: lost association during DHCP"EOL);
+            wifi_set_leds(LED_COLOR_ERROR);
+            scan_index = -1;
+            wifi_retries++;
+            if (wifi_retries >= WIFI_MAX_RETRIES) {
+                wifi_enter_master();
+            } else {
+                wifi_start_scan();
+                state = WIFI_GO_STATION;
+            }
+        }
+        break;
+
+    case WIFI_STATION:
+        /* Connected and operational */
+        if (hw_state != RT2501_S_CONNECTED) {
+            /* Lost connection */
+            DBG_MAIN("wifi: disconnected!"EOL);
+            wifi_set_leds(LED_COLOR_ERROR);
+            memset(net_ip, 0, 4);
+            scan_index = -1;
+            wifi_retries = 0;
+            state = WIFI_INIT;
+        }
+        break;
+
+    case WIFI_GO_MASTER:
+        if (hw_state == RT2501_S_MASTER) {
+            DBG_MAIN("wifi: AP mode active"EOL);
+            state = WIFI_MASTER;
+            master_countdown = 300;  /* 5 minutes default, or -40 on reconnect */
+            dhcp_server_start();
+            http_server_start(80);
+        } else if (hw_state == RT2501_S_BROKEN) {
+            DBG_MAIN("wifi: AP mode failed"EOL);
+            wifi_set_leds(LED_COLOR_ERROR);
+            state = WIFI_INIT;
+            want_master = 0;
+        }
+        break;
+
+    case WIFI_MASTER:
+        /* AP mode active — decrement countdown once per tick */
+        if (master_countdown > 0) {
+            master_countdown--;
+        }
+        if (master_countdown == 0 && !want_master) {
+            /* Timer expired — switch back to station mode */
+            DBG_MAIN("wifi: AP timeout, restarting as station"EOL);
+            dhcp_stop();
+            http_server_stop();
+            want_master = 0;
+            wifi_retries = 0;
+            scan_index = -1;
+            state = WIFI_INIT;
+        }
+        break;
+    }
+}
+
+int32_t wifi_is_connected(void)
+{
+    return (state == WIFI_STATION) ? 1 : 0;
+}
+
+int32_t wifi_is_master(void)
+{
+    return (state == WIFI_MASTER) ? 1 : 0;
+}
+
+void wifi_trigger_reconnect(void)
+{
+    DBG_MAIN("wifi: reconnect triggered"EOL);
+
+    /* Stop any active services */
+    if (state == WIFI_MASTER) {
+        dhcp_stop();
+        http_server_stop();
+    }
+
+    memset(net_ip, 0, 4);
+    want_master = 0;
+    wifi_retries = 0;
+    scan_index = -1;
+    scan_count = 0;
+    master_countdown = -40;  /* Signal: do not auto-start AP for ~40 ticks */
+    state = WIFI_INIT;
+}
+
+enum wifi_state wifi_get_state(void)
+{
+    return state;
+}
diff --git a/src/app/firmware/fw_crypt.c b/src/app/firmware/fw_crypt.c
new file mode 100644
index 0000000..5d34d50
--- /dev/null
+++ b/src/app/firmware/fw_crypt.c
@@ -0,0 +1,38 @@
+/**
+ * @file fw_crypt.c
+ * @brief Firmware encryption/decryption — ported from vlog.c
+ */
+#include <stdint.h>
+#include "app/firmware/fw_crypt.h"
+
+/* Multiplicative inverse table: inv8[i] = inverse of (2*i+1) mod 256 */
+static const uint8_t inv8[128] = {
+      1,171,205,183, 57,163,197,239,241, 27, 61,167, 41, 19, 53,223,
+    225,139,173,151, 25,131,165,207,209,251, 29,135,  9,243, 21,191,
+    193,107,141,119,249, 99,133,175,177,219,253,103,233,211,245,159,
+    161, 75,109, 87,217, 67,101,143,145,187,221, 71,201,179,213,127,
+    129, 43, 77, 55,185, 35, 69,111,113,155,189, 39,169,147,181, 95,
+     97, 11, 45, 23,153,  3, 37, 79, 81,123,157,  7,137,115,149, 63,
+     65,235, 13,247,121,227,  5, 47, 49, 91,125,231,105, 83,117, 31,
+     33,203,237,215, 89,195,229, 15, 17, 59, 93,199, 73, 51, 85,255
+};
+
+int32_t fw_decrypt(uint8_t *src, int32_t len, uint8_t key, uint8_t alpha)
+{
+    while (len-- > 0) {
+        uint8_t v = ((*src) - alpha) * key;
+        *(src++) = v;
+        key = v + v + 1;
+    }
+    return key;
+}
+
+int32_t fw_encrypt(uint8_t *src, int32_t len, uint8_t key, uint8_t alpha)
+{
+    while (len-- > 0) {
+        uint8_t v = *src;
+        *(src++) = alpha + (v * inv8[key >> 1]);
+        key = v + v + 1;
+    }
+    return key;
+}
diff --git a/src/app/firmware/fw_flash.c b/src/app/firmware/fw_flash.c
new file mode 100644
index 0000000..55e0649
--- /dev/null
+++ b/src/app/firmware/fw_flash.c
@@ -0,0 +1,193 @@
+/**
+ * @file fw_flash.c
+ * @brief Firmware flash mechanism — parse .sim format and flash MCU
+ */
+#include <stdint.h>
+#include <string.h>
+
+#include "common.h"
+#include "utils/mem.h"
+#include "utils/debug.h"
+#include "app/firmware/fw_flash.h"
+#include "app/firmware/fw_crypt.h"
+
+/* ---- Shared temp buffer for flash_uc (must be 4KB) ----
+ * Reuse the config temp buffer (defined in app_config.c) to save 4KB RAM.
+ * Both are only used during flash operations, never concurrently. */
+
+extern uint8_t conf_flash_temp[4096];
+
+/* ---- .sim format delimiter ---- */
+
+static const char sim_delimiter[] = "-violet-";
+#define SIM_DELIM_LEN  8
+#define SIM_HEXLEN_LEN 8  /* 8 hex chars for the length field */
+
+/* ---- Hex conversion ---- */
+
+/**
+ * Convert a single hex character to its 4-bit value.
+ * Returns -1 on invalid input.
+ */
+static int32_t hex_nibble(uint8_t c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+int32_t fw_hex2bin(const uint8_t *hex, uint32_t hex_len,
+                   uint8_t *out, uint32_t out_max)
+{
+    uint32_t i;
+    uint32_t out_len;
+    int32_t hi, lo;
+
+    if (hex_len & 1)
+        return -1;  /* odd number of hex chars */
+
+    out_len = hex_len / 2;
+    if (out_len > out_max)
+        return -1;
+
+    for (i = 0; i < out_len; i++) {
+        hi = hex_nibble(hex[i * 2]);
+        lo = hex_nibble(hex[i * 2 + 1]);
+        if (hi < 0 || lo < 0)
+            return -1;
+        out[i] = (uint8_t)((hi << 4) | lo);
+    }
+
+    return (int32_t)out_len;
+}
+
+/* ---- .sim parser ---- */
+
+/**
+ * Find a substring in a buffer (not null-terminated).
+ * Returns pointer to first occurrence, or NULL.
+ */
+static const uint8_t *find_bytes(const uint8_t *haystack, uint32_t haystack_len,
+                                  const char *needle, uint32_t needle_len)
+{
+    uint32_t i;
+
+    if (needle_len > haystack_len)
+        return NULL;
+
+    for (i = 0; i <= haystack_len - needle_len; i++) {
+        if (memcmp(&haystack[i], needle, needle_len) == 0)
+            return &haystack[i];
+    }
+    return NULL;
+}
+
+int32_t fw_parse_sim(uint8_t *data, uint32_t len,
+                     uint8_t **out_firmware, uint32_t *out_firmware_len)
+{
+    const uint8_t *first_delim;
+    const uint8_t *second_delim;
+    const uint8_t *hex_len_start;
+    const uint8_t *hex_data_start;
+    uint32_t hex_len_val;
+    uint32_t hex_data_len;
+    uint32_t binary_len;
+    int32_t result;
+    uint32_t i;
+
+    if (!data || !out_firmware || !out_firmware_len)
+        return -1;
+
+    /* Find first -violet- delimiter */
+    first_delim = find_bytes(data, len, sim_delimiter, SIM_DELIM_LEN);
+    if (!first_delim) {
+        DBG_MAIN("fw: no opening -violet-"EOL);
+        return -1;
+    }
+
+    /* After the first delimiter: 8-char hex length */
+    hex_len_start = first_delim + SIM_DELIM_LEN;
+    if (hex_len_start + SIM_HEXLEN_LEN > data + len) {
+        DBG_MAIN("fw: truncated length field"EOL);
+        return -1;
+    }
+
+    /* Parse the hex length (= 2 * binary_size) */
+    hex_len_val = 0;
+    for (i = 0; i < SIM_HEXLEN_LEN; i++) {
+        int32_t nibble = hex_nibble(hex_len_start[i]);
+        if (nibble < 0) {
+            DBG_MAIN("fw: invalid hex in length"EOL);
+            return -1;
+        }
+        hex_len_val = (hex_len_val << 4) | (uint32_t)nibble;
+    }
+
+    /* hex_len_val is the number of hex characters of firmware data */
+    hex_data_start = hex_len_start + SIM_HEXLEN_LEN;
+    hex_data_len = hex_len_val;
+
+    if (hex_data_start + hex_data_len > data + len) {
+        DBG_MAIN("fw: hex data exceeds buffer"EOL);
+        return -1;
+    }
+
+    /* Verify closing -violet- delimiter */
+    second_delim = hex_data_start + hex_data_len;
+    if (second_delim + SIM_DELIM_LEN > data + len) {
+        DBG_MAIN("fw: no closing delimiter"EOL);
+        return -1;
+    }
+    if (memcmp(second_delim, sim_delimiter, SIM_DELIM_LEN) != 0) {
+        DBG_MAIN("fw: closing delimiter mismatch"EOL);
+        return -1;
+    }
+
+    /* Convert hex to binary in-place (binary fits, it's half the size) */
+    binary_len = hex_data_len / 2;
+    result = fw_hex2bin(hex_data_start, hex_data_len, data, binary_len);
+    if (result < 0) {
+        DBG_MAIN("fw: hex decode failed"EOL);
+        return -1;
+    }
+
+    *out_firmware = data;
+    *out_firmware_len = binary_len;
+
+#ifdef DEBUG_MAIN
+    sprintf(dbg_buffer, "fw: parsed %lu bytes"EOL, (unsigned long)binary_len);
+    DBG_MAIN(dbg_buffer);
+#endif
+
+    return 0;
+}
+
+/* ---- Flash and reboot ---- */
+
+void fw_flash(uint8_t *firmware, uint32_t len)
+{
+    DBG_MAIN("fw: decrypting..."EOL);
+
+    /* Decrypt firmware in-place using Nabaztag key=0x47, alpha=47 */
+    fw_decrypt(firmware, (int32_t)len, 0x47, 47);
+
+    DBG_MAIN("fw: flashing..."EOL);
+
+    /* Disable interrupts before flash write */
+    __disable_interrupt();
+
+    /* flash_uc never returns — it writes firmware and resets */
+    flash_uc(firmware, (int32_t)len, conf_flash_temp);
+
+    /* Should never reach here */
+    while (1);
+}
+
+void fw_reboot(void)
+{
+    DBG_MAIN("fw: rebooting..."EOL);
+    reset_uc();
+    /* Never returns */
+    while (1);
+}
diff --git a/src/app/http/http_api.c b/src/app/http/http_api.c
new file mode 100644
index 0000000..983656f
--- /dev/null
+++ b/src/app/http/http_api.c
@@ -0,0 +1,808 @@
+/**
+ * @file http_api.c
+ * @brief REST API + route handler for the config HTTP server
+ *
+ * Handles all routes: config pages, JSON API, firmware upload,
+ * legacy form-based config (single-char query params).
+ */
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "app/http/http_api.h"
+#include "app/http/http_server.h"
+#include "app/http/http_pages.h"
+#include "app/app_config.h"
+#include "app/net/net_core.h"
+#include "app/firmware/fw_crypt.h"
+#include "app/firmware/fw_flash.h"
+#include "usb/rt2501usb.h"
+#include "utils/mem.h"
+#include "utils/debug.h"
+
+/* ---- External functions ---- */
+
+extern void mypassword_to_pmk(const uint8_t *password,
+                              uint8_t *ssid, uint16_t ssidlength,
+                              uint8_t *pmk);
+
+/* ---- Shared response buffer (static, ExtRAM region) ---- */
+
+static char resp_buf[2048] __attribute__((section(".extram")));
+
+/* ---- Large body receive buffer for firmware uploads (ExtRAM) ---- */
+
+static uint8_t fw_recv_buf[256 * 1024] __attribute__((section(".extram")));
+
+/* ---- Scan results cache ---- */
+
+#define MAX_SCAN_RESULTS 16
+
+struct scan_entry {
+    char    ssid[33];
+    int16_t rssi;
+    uint8_t channel;
+    uint8_t encryption;
+};
+
+static struct scan_entry scan_cache[MAX_SCAN_RESULTS] __attribute__((section(".extram")));
+static int32_t scan_count;
+static int32_t scan_in_progress;
+
+static void scan_cb(struct rt2501_scan_result *result, void *param)
+{
+    (void)param;
+    if (scan_count >= MAX_SCAN_RESULTS)
+        return;
+
+    struct scan_entry *e = &scan_cache[scan_count];
+    strncpy(e->ssid, (const char *)result->ssid, 32);
+    e->ssid[32] = '\0';
+    e->rssi = result->rssi;
+    e->channel = result->channel;
+    e->encryption = result->encryption;
+    scan_count++;
+}
+
+static void start_scan(void)
+{
+    if (scan_in_progress)
+        return;
+    scan_count = 0;
+    scan_in_progress = 1;
+    rt2501_scan(NULL, scan_cb, NULL);
+    /* scan_in_progress cleared by scan_done_cb or after timeout;
+     * rt2501_scan is async — leave flag set until scan completes */
+}
+
+/* ---- IP parsing helper ---- */
+
+static int32_t parse_ip(const char *str, uint8_t *out)
+{
+    uint32_t a, b, c, d;
+    int n;
+
+    if (!str || !*str)
+        return -1;
+
+    n = 0;
+    a = b = c = d = 0;
+
+    /* Manual parse: a.b.c.d */
+    {
+        const char *p = str;
+        a = 0;
+        while (*p >= '0' && *p <= '9') { a = a * 10 + (*p - '0'); p++; }
+        if (*p != '.') return -1; p++;
+        b = 0;
+        while (*p >= '0' && *p <= '9') { b = b * 10 + (*p - '0'); p++; }
+        if (*p != '.') return -1; p++;
+        c = 0;
+        while (*p >= '0' && *p <= '9') { c = c * 10 + (*p - '0'); p++; }
+        if (*p != '.') return -1; p++;
+        d = 0;
+        while (*p >= '0' && *p <= '9') { d = d * 10 + (*p - '0'); p++; }
+    }
+
+    if (a > 255 || b > 255 || c > 255 || d > 255)
+        return -1;
+
+    out[0] = (uint8_t)a;
+    out[1] = (uint8_t)b;
+    out[2] = (uint8_t)c;
+    out[3] = (uint8_t)d;
+    return 0;
+}
+
+/* ---- Parse proxy string "ip:port" ---- */
+
+static void parse_proxy(const char *str)
+{
+    uint8_t ip[4];
+    uint16_t port = 8080;
+    const char *colon;
+    char ip_part[16];
+    int32_t len;
+
+    if (!str || !*str) {
+        conf_set_byte(CONF_PROXYENABLE, 0);
+        return;
+    }
+
+    colon = str;
+    while (*colon && *colon != ':')
+        colon++;
+
+    len = (int32_t)(colon - str);
+    if (len <= 0 || len >= (int32_t)sizeof(ip_part)) {
+        conf_set_byte(CONF_PROXYENABLE, 0);
+        return;
+    }
+
+    memcpy(ip_part, str, len);
+    ip_part[len] = '\0';
+
+    if (parse_ip(ip_part, ip) < 0) {
+        conf_set_byte(CONF_PROXYENABLE, 0);
+        return;
+    }
+
+    if (*colon == ':') {
+        colon++;
+        port = 0;
+        while (*colon >= '0' && *colon <= '9') {
+            port = port * 10 + (*colon - '0');
+            colon++;
+        }
+    }
+
+    conf_set_byte(CONF_PROXYENABLE, 1);
+    conf_set_ip(CONF_PROXYIP, ip);
+    conf_set_port(CONF_PROXYPORT, port);
+}
+
+/* ---- Atoi helper ---- */
+
+static int32_t simple_atoi(const char *s)
+{
+    int32_t v = 0;
+    int32_t neg = 0;
+
+    if (!s) return 0;
+    if (*s == '-') { neg = 1; s++; }
+    while (*s >= '0' && *s <= '9') {
+        v = v * 10 + (*s - '0');
+        s++;
+    }
+    return neg ? -v : v;
+}
+
+/* ---- JSON string escape helper ---- */
+
+/**
+ * Write a JSON-safe escaped copy of src into dst.
+ * Returns number of bytes written (not including NUL).
+ * Escapes: \ " and control chars (< 0x20).
+ */
+static int32_t json_escape(char *dst, int32_t dstsize, const char *src)
+{
+    int32_t w = 0;
+    while (*src && w < dstsize - 1) {
+        char c = *src++;
+        if (c == '"' || c == '\\') {
+            if (w + 2 > dstsize - 1) break;
+            dst[w++] = '\\';
+            dst[w++] = c;
+        } else if ((uint8_t)c < 0x20) {
+            /* Skip control characters */
+        } else {
+            dst[w++] = c;
+        }
+    }
+    dst[w] = '\0';
+    return w;
+}
+
+/* ---- Find JSON string value (very minimal) ---- */
+
+static const char *json_find_str(const char *json, const char *key,
+                                 char *out, int32_t outlen)
+{
+    char pattern[48];
+    const char *p;
+    int32_t i;
+
+    snprintf(pattern, sizeof(pattern), "\"%s\"", key);
+    p = strstr(json, pattern);
+    if (!p) return NULL;
+
+    p += strlen(pattern);
+    while (*p == ' ' || *p == ':') p++;
+    if (*p != '"') return NULL;
+    p++;
+
+    i = 0;
+    while (*p && *p != '"' && i < outlen - 1) {
+        out[i++] = *p++;
+    }
+    out[i] = '\0';
+    return out;
+}
+
+/* ---- Apply form config (legacy single-char query params) ---- */
+
+static void apply_form_config(struct http_param *params, int32_t nparams)
+{
+    int32_t i;
+    const char *ssid_manual = NULL;
+    const char *ssid_dropdown = NULL;
+    const char *wifikey = NULL;
+    int32_t auth_changed = 0;
+    int32_t crypt_val = -1;
+    uint8_t old_crypt, old_auth;
+    const char *old_ssid;
+    const char *old_key;
+    uint8_t ip[4];
+
+    old_crypt = conf_get_byte(CONF_WIFICRYPT);
+    old_auth = conf_get_byte(CONF_WIFIAUTH);
+    old_ssid = conf_wifi_ssid();
+    old_key = conf_wifi_key();
+
+    for (i = 0; i < nparams; i++) {
+        const char *k = params[i].key;
+        const char *v = params[i].value;
+
+        if (!k || !k[0]) continue;
+
+        switch (k[0]) {
+        case 'a': /* Server URL */
+            conf_set_str(CONF_SERVERURL, v, CONF_SERVERURL_LEN);
+            break;
+        case 'f': /* DHCP */
+            conf_set_byte(CONF_NETDHCP, (uint8_t)simple_atoi(v));
+            break;
+        case 'g': /* Static IP */
+            if (parse_ip(v, ip) == 0)
+                conf_set_ip(CONF_NETIP, ip);
+            break;
+        case 'h': /* Netmask */
+            if (parse_ip(v, ip) == 0)
+                conf_set_ip(CONF_NETMASK, ip);
+            break;
+        case 'i': /* Gateway */
+            if (parse_ip(v, ip) == 0)
+                conf_set_ip(CONF_NETGATEWAY, ip);
+            break;
+        case 'j': /* DNS */
+            if (parse_ip(v, ip) == 0)
+                conf_set_ip(CONF_NETDNS, ip);
+            break;
+        case 'k': /* SSID manual */
+            ssid_manual = v;
+            break;
+        case 'w': /* SSID dropdown */
+            ssid_dropdown = v;
+            break;
+        case 'l': /* WiFi auth */
+            {
+                int32_t av = simple_atoi(v);
+                uint8_t auth_v, crypt_v;
+                if (av == 0) {
+                    auth_v = IEEE80211_AUTH_OPEN;
+                    crypt_v = IEEE80211_CRYPT_NONE;
+                } else if (av == 1) {
+                    auth_v = IEEE80211_AUTH_SHARED;
+                    crypt_v = IEEE80211_CRYPT_WEP;
+                } else {
+                    auth_v = IEEE80211_AUTH_OPEN;
+                    crypt_v = IEEE80211_CRYPT_WPA2;
+                }
+                conf_set_byte(CONF_WIFIAUTH, auth_v);
+                conf_set_byte(CONF_WIFICRYPT, crypt_v);
+                auth_changed = 1;
+            }
+            break;
+        case 'm': /* WiFi crypt (explicit) */
+            crypt_val = simple_atoi(v);
+            conf_set_byte(CONF_WIFICRYPT, (uint8_t)crypt_val);
+            break;
+        case 'n': /* WiFi key */
+            wifikey = v;
+            break;
+        case 'p': /* Proxy */
+            parse_proxy(v);
+            break;
+        case 'z': /* Submit marker — ignore */
+            break;
+        default:
+            break;
+        }
+    }
+
+    /* Determine SSID: dropdown takes priority over manual if non-empty */
+    {
+        const char *ssid = NULL;
+        if (ssid_dropdown && ssid_dropdown[0])
+            ssid = ssid_dropdown;
+        else if (ssid_manual && ssid_manual[0])
+            ssid = ssid_manual;
+
+        if (ssid)
+            conf_set_str(CONF_WIFISSID, ssid, CONF_WIFISSID_LEN);
+    }
+
+    /* Set WiFi key */
+    if (wifikey && wifikey[0]) {
+        conf_set_str(CONF_WIFIKEY0, wifikey, CONF_WIFIKEY0_LEN);
+    }
+
+    /* Recompute PMK if WPA/WPA2 and key or SSID changed */
+    {
+        uint8_t cur_crypt = conf_get_byte(CONF_WIFICRYPT);
+        if (cur_crypt >= IEEE80211_CRYPT_WPA) {
+            const char *cur_ssid = conf_wifi_ssid();
+            const char *cur_key = conf_wifi_key();
+            int32_t need_pmk = 0;
+
+            if (wifikey && wifikey[0])
+                need_pmk = 1;
+            if (auth_changed && cur_crypt != old_crypt)
+                need_pmk = 1;
+            /* Always recompute if key is set */
+            if (cur_key[0] && need_pmk) {
+                uint8_t pmk[32];
+                mypassword_to_pmk((const uint8_t *)cur_key,
+                                  (uint8_t *)cur_ssid,
+                                  (uint16_t)strlen(cur_ssid), pmk);
+                conf_set(CONF_WIFIPMK, pmk, CONF_WIFIPMK_LEN);
+                DBG_MAIN("http: PMK recomputed\r\n");
+            }
+        }
+    }
+
+    conf_save();
+    DBG_MAIN("http: config saved\r\n");
+}
+
+/* ---- JSON API: apply config from JSON body ---- */
+
+static void apply_json_config(const char *body)
+{
+    char val[64];
+    uint8_t ip[4];
+
+    if (json_find_str(body, "server", val, sizeof(val)))
+        conf_set_str(CONF_SERVERURL, val, CONF_SERVERURL_LEN);
+
+    if (json_find_str(body, "ssid", val, sizeof(val)))
+        conf_set_str(CONF_WIFISSID, val, CONF_WIFISSID_LEN);
+
+    if (json_find_str(body, "key", val, sizeof(val)))
+        conf_set_str(CONF_WIFIKEY0, val, CONF_WIFIKEY0_LEN);
+
+    if (json_find_str(body, "crypt", val, sizeof(val)))
+        conf_set_byte(CONF_WIFICRYPT, (uint8_t)simple_atoi(val));
+
+    if (json_find_str(body, "auth", val, sizeof(val)))
+        conf_set_byte(CONF_WIFIAUTH, (uint8_t)simple_atoi(val));
+
+    if (json_find_str(body, "dhcp", val, sizeof(val)))
+        conf_set_byte(CONF_NETDHCP, (uint8_t)simple_atoi(val));
+
+    if (json_find_str(body, "ip", val, sizeof(val))) {
+        if (parse_ip(val, ip) == 0)
+            conf_set_ip(CONF_NETIP, ip);
+    }
+    if (json_find_str(body, "mask", val, sizeof(val))) {
+        if (parse_ip(val, ip) == 0)
+            conf_set_ip(CONF_NETMASK, ip);
+    }
+    if (json_find_str(body, "gw", val, sizeof(val))) {
+        if (parse_ip(val, ip) == 0)
+            conf_set_ip(CONF_NETGATEWAY, ip);
+    }
+    if (json_find_str(body, "dns", val, sizeof(val))) {
+        if (parse_ip(val, ip) == 0)
+            conf_set_ip(CONF_NETDNS, ip);
+    }
+    if (json_find_str(body, "proxy", val, sizeof(val)))
+        parse_proxy(val);
+
+    /* Recompute PMK if needed */
+    {
+        uint8_t cur_crypt = conf_get_byte(CONF_WIFICRYPT);
+        if (cur_crypt >= IEEE80211_CRYPT_WPA) {
+            const char *cur_ssid = conf_wifi_ssid();
+            const char *cur_key = conf_wifi_key();
+            if (cur_key[0] && cur_ssid[0]) {
+                uint8_t pmk[32];
+                mypassword_to_pmk((const uint8_t *)cur_key,
+                                  (uint8_t *)cur_ssid,
+                                  (uint16_t)strlen(cur_ssid), pmk);
+                conf_set(CONF_WIFIPMK, pmk, CONF_WIFIPMK_LEN);
+            }
+        }
+    }
+
+    conf_save();
+}
+
+/* ---- Route: GET /api/status ---- */
+
+static void handle_api_status(struct http_request *req)
+{
+    int32_t len;
+    int32_t state = rt2501_state();
+    int32_t rssi = rt2501_rssi_average();
+    uint8_t ip[4];
+    char ssid_esc[66];
+
+    conf_get_ip(CONF_NETIP, ip);
+    json_escape(ssid_esc, sizeof(ssid_esc), conf_wifi_ssid());
+
+    len = snprintf(resp_buf, sizeof(resp_buf),
+        "{\"wifi\":%d,\"rssi\":%d,"
+        "\"ip\":\"%u.%u.%u.%u\","
+        "\"ssid\":\"%s\","
+        "\"mac\":\"%02X:%02X:%02X:%02X:%02X:%02X\","
+        "\"ver\":\"2.0.0\","
+        "\"uptime\":%u}",
+        (int)state, (int)rssi,
+        ip[0], ip[1], ip[2], ip[3],
+        ssid_esc,
+        net_mac[0], net_mac[1], net_mac[2],
+        net_mac[3], net_mac[4], net_mac[5],
+        (unsigned)net_time_s());
+
+    http_respond_json(req, 200, resp_buf);
+}
+
+/* ---- Route: GET /api/scan ---- */
+
+static void handle_api_scan(struct http_request *req)
+{
+    int32_t i, off;
+
+    start_scan();
+
+    off = 0;
+    resp_buf[off++] = '[';
+
+    for (i = 0; i < scan_count && off < (int32_t)sizeof(resp_buf) - 80; i++) {
+        char ssid_esc[66];
+        if (i > 0)
+            resp_buf[off++] = ',';
+
+        json_escape(ssid_esc, sizeof(ssid_esc), scan_cache[i].ssid);
+        off += snprintf(resp_buf + off, sizeof(resp_buf) - off,
+            "{\"s\":\"%s\",\"r\":%d,\"c\":%u,\"e\":%u}",
+            ssid_esc,
+            (int)scan_cache[i].rssi,
+            (unsigned)scan_cache[i].channel,
+            (unsigned)scan_cache[i].encryption);
+    }
+
+    resp_buf[off++] = ']';
+    resp_buf[off] = '\0';
+
+    http_respond_json(req, 200, resp_buf);
+}
+
+/* ---- Route: GET /api/config ---- */
+
+static void handle_api_config_get(struct http_request *req)
+{
+    int32_t len;
+    uint8_t ip[4], mask[4], gw[4], dns[4], pip[4];
+    char ssid_esc[66], server_esc[84];
+
+    conf_get_ip(CONF_NETIP, ip);
+    conf_get_ip(CONF_NETMASK, mask);
+    conf_get_ip(CONF_NETGATEWAY, gw);
+    conf_get_ip(CONF_NETDNS, dns);
+    conf_get_ip(CONF_PROXYIP, pip);
+
+    json_escape(ssid_esc, sizeof(ssid_esc), conf_wifi_ssid());
+    json_escape(server_esc, sizeof(server_esc), conf_server_url());
+
+    len = snprintf(resp_buf, sizeof(resp_buf),
+        "{\"ssid\":\"%s\",\"dhcp\":%u,"
+        "\"ip\":\"%u.%u.%u.%u\","
+        "\"mask\":\"%u.%u.%u.%u\","
+        "\"gw\":\"%u.%u.%u.%u\","
+        "\"dns\":\"%u.%u.%u.%u\","
+        "\"server\":\"%s\","
+        "\"proxy\":%u,"
+        "\"proxy_ip\":\"%u.%u.%u.%u\","
+        "\"proxy_port\":%u,"
+        "\"crypt\":%u,\"auth\":%u}",
+        ssid_esc,
+        (unsigned)conf_dhcp(),
+        ip[0], ip[1], ip[2], ip[3],
+        mask[0], mask[1], mask[2], mask[3],
+        gw[0], gw[1], gw[2], gw[3],
+        dns[0], dns[1], dns[2], dns[3],
+        server_esc,
+        (unsigned)conf_get_byte(CONF_PROXYENABLE),
+        pip[0], pip[1], pip[2], pip[3],
+        (unsigned)conf_get_port(CONF_PROXYPORT),
+        (unsigned)conf_wifi_crypt(),
+        (unsigned)conf_wifi_auth());
+
+    http_respond_json(req, 200, resp_buf);
+}
+
+/* ---- Route: POST /api/config ---- */
+
+static void handle_api_config_post(struct http_request *req)
+{
+    if (req->body && req->body_len > 0) {
+        /* Null-terminate body for string ops */
+        apply_json_config(req->body);
+    }
+    http_respond_json(req, 200, "{\"ok\":true}");
+}
+
+/* ---- Route: POST /api/firmware ---- */
+
+static void handle_api_firmware(struct http_request *req)
+{
+    uint8_t *fw_data;
+    uint32_t fw_len;
+
+    if (!req->body || req->body_len < 24) {
+        http_respond_json(req, 400, "{\"error\":\"no data\"}");
+        return;
+    }
+
+    /* Parse .sim format: find -violet- delimiters, hex-decode in-place */
+    if (fw_parse_sim((uint8_t *)req->body, req->body_len,
+                     &fw_data, &fw_len) < 0) {
+        http_respond_json(req, 400, "{\"error\":\"invalid .sim format\"}");
+        return;
+    }
+
+    if (fw_len < 64 || fw_len > 128 * 1024) {
+        http_respond_json(req, 400, "{\"error\":\"invalid firmware size\"}");
+        return;
+    }
+
+    /* Respond before flashing (flash_uc never returns) */
+    http_respond_json(req, 200, "{\"ok\":true,\"msg\":\"flashing\"}");
+    DBG_MAIN("http: firmware flashing\r\n");
+
+    /* Decrypt and flash — this never returns */
+    fw_flash(fw_data, fw_len);
+}
+
+/* ---- Route: POST /api/reboot ---- */
+
+static void handle_api_reboot(struct http_request *req)
+{
+    http_respond_json(req, 200, "{\"ok\":true}");
+    reset_uc();
+}
+
+/* ---- Legacy: GET /b.htm — apply form config, show done page ---- */
+
+static void handle_b_htm(struct http_request *req)
+{
+    struct http_param params[HTTP_MAX_PARAMS];
+    int32_t n;
+    char uri_copy[128];
+
+    /* Copy URI for parsing (http_parse_query modifies in-place) */
+    strncpy(uri_copy, req->uri, sizeof(uri_copy) - 1);
+    uri_copy[sizeof(uri_copy) - 1] = '\0';
+
+    n = http_parse_query(uri_copy, params, HTTP_MAX_PARAMS);
+    if (n > 0)
+        apply_form_config(params, n);
+
+    http_respond_html(req, 200, page_done);
+}
+
+/* ---- Legacy: POST /c — firmware upload ---- */
+
+static void handle_legacy_firmware(struct http_request *req)
+{
+    /* The body may be multipart — skip past the multipart header
+     * to find the actual firmware data (.sim content). */
+    uint8_t *fw_data = (uint8_t *)req->body;
+    int32_t fw_len = (int32_t)req->body_len;
+    uint8_t *parsed_fw;
+    uint32_t parsed_fw_len;
+
+    if (fw_len < 4) {
+        http_respond_html(req, 400, page_error);
+        return;
+    }
+
+    /* Look for \r\n\r\n after multipart header */
+    {
+        const char *end = strstr((const char *)fw_data, "\r\n\r\n");
+        if (end) {
+            end += 4;
+            fw_len -= (int32_t)(end - (const char *)fw_data);
+            fw_data = (uint8_t *)end;
+        }
+    }
+
+    if (fw_len < 24) {
+        http_respond_html(req, 400, page_error);
+        return;
+    }
+
+    /* Parse .sim format */
+    if (fw_parse_sim(fw_data, (uint32_t)fw_len,
+                     &parsed_fw, &parsed_fw_len) < 0) {
+        http_respond_html(req, 400, page_error);
+        DBG_MAIN("http: legacy fw .sim parse failed\r\n");
+        return;
+    }
+
+    if (parsed_fw_len < 64 || parsed_fw_len > 128 * 1024) {
+        http_respond_html(req, 400, page_error);
+        return;
+    }
+
+    http_respond_html(req, 200, page_done);
+    DBG_MAIN("http: legacy firmware flashing\r\n");
+
+    /* Decrypt and flash — never returns */
+    fw_flash(parsed_fw, parsed_fw_len);
+}
+
+/* ---- Legacy: GET /d.htm — reboot ---- */
+
+static void handle_d_htm(struct http_request *req)
+{
+    http_respond_html(req, 200,
+        "<!DOCTYPE html><html><body><h2>Rebooting...</h2></body></html>");
+    reset_uc();
+}
+
+/* ---- Legacy: GET /r.htm — factory reset ---- */
+
+static void handle_r_htm(struct http_request *req)
+{
+    conf_reset();
+    http_respond_html(req, 200,
+        "<!DOCTYPE html><html><body>"
+        "<h2>Factory Reset</h2><p>Device reset to defaults. Rebooting...</p>"
+        "</body></html>");
+    reset_uc();
+}
+
+/* ---- String comparison helpers ---- */
+
+static int32_t streq(const char *a, const char *b)
+{
+    return strcmp(a, b) == 0;
+}
+
+static int32_t starts_with(const char *s, const char *prefix)
+{
+    while (*prefix) {
+        if (*s++ != *prefix++)
+            return 0;
+    }
+    return 1;
+}
+
+/* ---- Main request handler ---- */
+
+static void api_handler(struct http_request *req)
+{
+    int32_t is_get = streq(req->method, "GET");
+    int32_t is_post = streq(req->method, "POST");
+    char *uri = req->uri;
+
+    /* Strip query string for route matching (don't modify req->uri yet) */
+    char path[128];
+    {
+        int32_t i;
+        for (i = 0; i < (int32_t)sizeof(path) - 1 && uri[i] && uri[i] != '?'; i++)
+            path[i] = uri[i];
+        path[i] = '\0';
+    }
+
+    snprintf(dbg_buffer, DBG_BUFFER_LENGTH, "http: %s %s\r\n",
+             req->method, path);
+    DBG_MAIN(dbg_buffer);
+
+    /* ---- Route dispatch ---- */
+
+    if (is_get && (streq(path, "/") || streq(path, "/a.htm"))) {
+        /* Serve config index page with template substitution */
+        int32_t len = http_page_render_index(resp_buf, sizeof(resp_buf));
+        http_respond_html(req, 200, resp_buf);
+        return;
+    }
+
+    if (is_get && streq(path, "/api/status")) {
+        handle_api_status(req);
+        return;
+    }
+
+    if (is_get && streq(path, "/api/scan")) {
+        handle_api_scan(req);
+        return;
+    }
+
+    if (is_get && streq(path, "/api/config")) {
+        handle_api_config_get(req);
+        return;
+    }
+
+    if (is_post && streq(path, "/api/config")) {
+        handle_api_config_post(req);
+        return;
+    }
+
+    if (is_post && streq(path, "/api/firmware")) {
+        handle_api_firmware(req);
+        return;
+    }
+
+    if (is_post && streq(path, "/api/reboot")) {
+        handle_api_reboot(req);
+        return;
+    }
+
+    if (is_get && starts_with(path, "/b.htm")) {
+        handle_b_htm(req);
+        return;
+    }
+
+    if (is_post && streq(path, "/c")) {
+        handle_legacy_firmware(req);
+        return;
+    }
+
+    if (is_get && streq(path, "/d.htm")) {
+        handle_d_htm(req);
+        return;
+    }
+
+    if (is_get && streq(path, "/u.htm")) {
+        http_respond_html(req, 200, page_firmware);
+        return;
+    }
+
+    if (is_get && streq(path, "/r.htm")) {
+        handle_r_htm(req);
+        return;
+    }
+
+    if (is_get && streq(path, "/debug.htm")) {
+        http_respond_html(req, 200, page_debug);
+        return;
+    }
+
+    /* 404 */
+    http_respond_html(req, 404,
+        "<!DOCTYPE html><html><body><h2>404</h2></body></html>");
+}
+
+/* ---- Public API ---- */
+
+void api_init(void)
+{
+    scan_count = 0;
+    scan_in_progress = 0;
+
+    /* Register large body buffer for firmware uploads */
+    http_server_set_large_body(fw_recv_buf, sizeof(fw_recv_buf));
+
+    http_server_set_handler(api_handler);
+    /* Note: http_server_start() is called by app_wifi when network is up */
+
+    DBG_MAIN("http: API initialized\r\n");
+}
+
+void api_stop(void)
+{
+    http_server_stop();
+}
diff --git a/src/app/http/http_client.c b/src/app/http/http_client.c
new file mode 100644
index 0000000..0598db0
--- /dev/null
+++ b/src/app/http/http_client.c
@@ -0,0 +1,421 @@
+/**
+ * @file http_client.c
+ * @brief HTTP/1.0 client — GET/POST with DNS resolution, proxy support
+ *
+ * Single concurrent request. 4096-byte static response buffer.
+ * 10-second timeout.
+ */
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "app/http/http_client.h"
+#include "app/net/net_tcp.h"
+#include "app/net/net_dns.h"
+#include "app/net/net_core.h"
+#include "app/app_config.h"
+#include "utils/debug.h"
+
+/* ---- Constants ---- */
+
+#define HC_BUF_SIZE      4096
+#define HC_REQ_SIZE      512
+#define HC_TIMEOUT_MS    10000
+#define HC_USER_AGENT    "Nabaztag/2.0"
+
+/* ---- Client states ---- */
+
+enum {
+    HC_IDLE = 0,
+    HC_DNS,
+    HC_CONNECTING,
+    HC_SENDING,
+    HC_RECV_HEADER,
+    HC_RECV_BODY,
+    HC_DONE
+};
+
+/* ---- Static state (single concurrent request) ---- */
+
+static struct {
+    int32_t           state;
+    http_response_cb_t callback;
+    void             *ctx;
+    struct tcp_conn  *conn;
+
+    /* Request */
+    char   method[8];
+    char   host[64];
+    char   path[128];
+    uint16_t port;
+    const uint8_t *post_body;
+    uint32_t       post_len;
+
+    /* Response buffer */
+    uint8_t  buf[HC_BUF_SIZE];
+    uint32_t rx_len;
+
+    /* Parsed response */
+    int32_t  status;
+    uint32_t header_len;
+    uint32_t content_len;
+    int32_t  chunked;
+
+    /* Timeout */
+    uint32_t start_ms;
+
+    /* Resolved IP */
+    uint8_t  dst_ip[4];
+} hc __attribute__((section(".extram")));
+
+/* ---- Forward declarations ---- */
+
+static void hc_tcp_cb(struct tcp_conn *conn, int32_t event,
+                      const uint8_t *data, uint32_t len);
+static void hc_dns_cb(const uint8_t *ip, void *ctx);
+static void hc_finish(int32_t status);
+static void hc_send_request(void);
+
+/* ---- URL parsing ---- */
+
+/**
+ * Parse URL into host, port, path.
+ * Supports: http://host[:port][/path]
+ * Returns 0 on success.
+ */
+static int32_t parse_url(const char *url)
+{
+    const char *p = url;
+    int32_t i;
+
+    /* Skip "http://" */
+    if (p[0] == 'h' && p[1] == 't' && p[2] == 't' && p[3] == 'p'
+        && p[4] == ':' && p[5] == '/' && p[6] == '/') {
+        p += 7;
+    }
+
+    /* Extract host */
+    i = 0;
+    while (*p && *p != ':' && *p != '/' && i < (int32_t)sizeof(hc.host) - 1)
+        hc.host[i++] = *p++;
+    hc.host[i] = '\0';
+
+    /* Port */
+    hc.port = 80;
+    if (*p == ':') {
+        p++;
+        hc.port = 0;
+        while (*p >= '0' && *p <= '9') {
+            hc.port = hc.port * 10 + (*p - '0');
+            p++;
+        }
+    }
+
+    /* Path */
+    if (*p == '/') {
+        i = 0;
+        while (*p && i < (int32_t)sizeof(hc.path) - 1)
+            hc.path[i++] = *p++;
+        hc.path[i] = '\0';
+    } else {
+        hc.path[0] = '/';
+        hc.path[1] = '\0';
+    }
+
+    return (hc.host[0]) ? 0 : -1;
+}
+
+/* ---- Initiate a request ---- */
+
+static int32_t hc_start(const char *method, const char *url,
+                         const uint8_t *body, uint32_t body_len,
+                         http_response_cb_t callback, void *ctx)
+{
+    if (hc.state != HC_IDLE)
+        return -1;
+
+    memset(&hc, 0, sizeof(hc));
+    strncpy(hc.method, method, sizeof(hc.method) - 1);
+    hc.callback = callback;
+    hc.ctx = ctx;
+    hc.post_body = body;
+    hc.post_len = body_len;
+    hc.start_ms = net_time_ms();
+
+    if (parse_url(url) < 0) {
+        hc_finish(-1);
+        return -1;
+    }
+
+    /* Check proxy */
+    if (conf_get_byte(CONF_PROXYENABLE)) {
+        uint8_t pip[4];
+        conf_get_ip(CONF_PROXYIP, pip);
+        memcpy(hc.dst_ip, pip, 4);
+        hc.port = conf_get_port(CONF_PROXYPORT);
+
+        /* When using proxy, path must be full URL */
+        {
+            char full[256];
+            snprintf(full, sizeof(full), "http://%s:%u%s",
+                     hc.host, (unsigned)80, hc.path);
+            strncpy(hc.path, full, sizeof(hc.path) - 1);
+            hc.path[sizeof(hc.path) - 1] = '\0';
+        }
+
+        hc.state = HC_CONNECTING;
+        hc.conn = tcp_connect(hc.dst_ip, hc.port, 0, hc_tcp_cb);
+        if (!hc.conn) {
+            hc_finish(-1);
+            return -1;
+        }
+        return 0;
+    }
+
+    /* DNS resolve */
+    hc.state = HC_DNS;
+    dns_resolve(hc.host, hc_dns_cb, NULL);
+    return 0;
+}
+
+/* ---- DNS callback ---- */
+
+static void hc_dns_cb(const uint8_t *ip, void *ctx)
+{
+    (void)ctx;
+
+    if (!ip || hc.state != HC_DNS) {
+        DBG_MAIN("http_client: DNS failed\r\n");
+        hc_finish(-1);
+        return;
+    }
+
+    memcpy(hc.dst_ip, ip, 4);
+    hc.state = HC_CONNECTING;
+    hc.conn = tcp_connect(hc.dst_ip, hc.port, 0, hc_tcp_cb);
+    if (!hc.conn) {
+        hc_finish(-1);
+    }
+}
+
+/* ---- Send HTTP request ---- */
+
+static void hc_send_request(void)
+{
+    char req[HC_REQ_SIZE];
+    int32_t len;
+
+    if (hc.post_body && hc.post_len > 0) {
+        len = snprintf(req, sizeof(req),
+            "%s %s HTTP/1.0\r\n"
+            "Host: %s\r\n"
+            "User-Agent: " HC_USER_AGENT "\r\n"
+            "Content-Length: %u\r\n"
+            "Connection: close\r\n"
+            "\r\n",
+            hc.method, hc.path, hc.host,
+            (unsigned)hc.post_len);
+    } else {
+        len = snprintf(req, sizeof(req),
+            "%s %s HTTP/1.0\r\n"
+            "Host: %s\r\n"
+            "User-Agent: " HC_USER_AGENT "\r\n"
+            "Connection: close\r\n"
+            "\r\n",
+            hc.method, hc.path, hc.host);
+    }
+
+    if (len > 0) {
+        tcp_write(hc.conn, (const uint8_t *)req, (uint32_t)len);
+    }
+
+    /* Send POST body if any */
+    if (hc.post_body && hc.post_len > 0) {
+        tcp_write(hc.conn, hc.post_body, hc.post_len);
+    }
+
+    hc.state = HC_RECV_HEADER;
+}
+
+/* ---- Parse status line from response header ---- */
+
+static int32_t parse_status_line(void)
+{
+    /* "HTTP/1.x SSS reason\r\n" */
+    const char *p = (const char *)hc.buf;
+    int32_t code = 0;
+
+    /* Skip to first space */
+    while (*p && *p != ' ') p++;
+    if (!*p) return -1;
+    p++;
+
+    /* Parse 3-digit status */
+    while (*p >= '0' && *p <= '9') {
+        code = code * 10 + (*p - '0');
+        p++;
+    }
+
+    return (code >= 100 && code <= 599) ? code : -1;
+}
+
+/* ---- Find Content-Length in header ---- */
+
+static uint32_t parse_content_length(void)
+{
+    const char *cl = "Content-Length:";
+    const char *buf = (const char *)hc.buf;
+    const char *found = strstr(buf, cl);
+
+    if (!found) {
+        cl = "content-length:";
+        found = strstr(buf, cl);
+    }
+    if (!found)
+        return 0xFFFFFFFF; /* unknown — read until close */
+
+    found += 15;
+    while (*found == ' ') found++;
+
+    {
+        uint32_t val = 0;
+        while (*found >= '0' && *found <= '9') {
+            val = val * 10 + (*found - '0');
+            found++;
+        }
+        return val;
+    }
+}
+
+/* ---- TCP callback ---- */
+
+static void hc_tcp_cb(struct tcp_conn *conn, int32_t event,
+                      const uint8_t *data, uint32_t len)
+{
+    (void)conn;
+
+    switch (event) {
+
+    case TCP_CONNECTED:
+        hc_send_request();
+        break;
+
+    case TCP_DATA:
+        /* Append to buffer */
+        if (hc.rx_len + len > HC_BUF_SIZE)
+            len = HC_BUF_SIZE - hc.rx_len;
+        if (len > 0) {
+            memcpy(&hc.buf[hc.rx_len], data, len);
+            hc.rx_len += len;
+        }
+
+        /* Parse header if still looking for it */
+        if (hc.state == HC_RECV_HEADER) {
+            /* Null-terminate for strstr */
+            hc.buf[hc.rx_len < HC_BUF_SIZE ? hc.rx_len : HC_BUF_SIZE - 1] = '\0';
+            {
+                const char *hdr_end = strstr((const char *)hc.buf, "\r\n\r\n");
+                if (hdr_end) {
+                    hc.header_len = (uint32_t)(hdr_end - (const char *)hc.buf) + 4;
+                    hc.status = parse_status_line();
+                    hc.content_len = parse_content_length();
+                    hc.state = HC_RECV_BODY;
+                }
+            }
+        }
+
+        /* Check if body is complete */
+        if (hc.state == HC_RECV_BODY) {
+            uint32_t body_rx = hc.rx_len - hc.header_len;
+            if (hc.content_len != 0xFFFFFFFF && body_rx >= hc.content_len) {
+                hc_finish(hc.status);
+            }
+        }
+        break;
+
+    case TCP_CLOSED:
+        /* Connection closed — finish with what we have */
+        if (hc.state == HC_RECV_HEADER || hc.state == HC_RECV_BODY) {
+            if (hc.header_len == 0) {
+                /* Never got full header */
+                hc_finish(-1);
+            } else {
+                hc_finish(hc.status);
+            }
+        } else if (hc.state != HC_IDLE && hc.state != HC_DONE) {
+            hc_finish(-1);
+        }
+        break;
+
+    default:
+        break;
+    }
+}
+
+/* ---- Finish request, call user callback ---- */
+
+static void hc_finish(int32_t status)
+{
+    http_response_cb_t cb = hc.callback;
+    void *ctx = hc.ctx;
+    const uint8_t *body = NULL;
+    uint32_t body_len = 0;
+
+    if (hc.header_len > 0 && hc.rx_len > hc.header_len) {
+        body = &hc.buf[hc.header_len];
+        body_len = hc.rx_len - hc.header_len;
+    }
+
+    /* Close connection if still open */
+    if (hc.conn) {
+        tcp_close(hc.conn);
+        hc.conn = NULL;
+    }
+
+    hc.state = HC_IDLE;
+
+    if (cb)
+        cb(status, body, body_len, ctx);
+}
+
+/* ---- Public API ---- */
+
+int32_t http_get(const char *url, http_response_cb_t callback, void *ctx)
+{
+    return hc_start("GET", url, NULL, 0, callback, ctx);
+}
+
+int32_t http_post(const char *url, const uint8_t *body, uint32_t body_len,
+                  http_response_cb_t callback, void *ctx)
+{
+    return hc_start("POST", url, body, body_len, callback, ctx);
+}
+
+void http_abort(void)
+{
+    if (hc.state == HC_IDLE)
+        return;
+
+    /* Clear callback before tcp_close to prevent double-invoke via
+     * TCP_CLOSED → hc_tcp_cb → hc_finish → callback chain */
+    hc.callback = NULL;
+
+    if (hc.conn) {
+        tcp_close(hc.conn);
+        hc.conn = NULL;
+    }
+
+    hc.state = HC_IDLE;
+}
+
+void http_client_tick(void)
+{
+    if (hc.state == HC_IDLE || hc.state == HC_DONE)
+        return;
+
+    /* Enforce timeout */
+    if (net_time_ms() - hc.start_ms >= HC_TIMEOUT_MS) {
+        DBG_MAIN("http_client: timeout\r\n");
+        hc_finish(-2);
+    }
+}
diff --git a/src/app/http/http_pages.c b/src/app/http/http_pages.c
