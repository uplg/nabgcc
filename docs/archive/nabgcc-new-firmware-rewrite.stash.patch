diff --git a/inc/app/http/http_server.h b/inc/app/http/http_server.h
new file mode 100644
index 0000000..eda2f29
--- /dev/null
+++ b/inc/app/http/http_server.h
@@ -0,0 +1,88 @@
+/**
+ * @file http_server.h
+ * @brief HTTP/1.0 server — REST API + config pages
+ *
+ * Listens on a TCP port. Buffers incoming data per connection,
+ * parses HTTP/1.0 requests, dispatches to a registered handler.
+ * Max 2 concurrent connections (very limited RAM).
+ */
+#ifndef HTTP_SERVER_H
+#define HTTP_SERVER_H
+
+#include <stdint.h>
+
+/* Forward declaration — opaque TCP handle */
+struct tcp_conn;
+
+/* ---- Request structure ---- */
+
+struct http_request {
+    char     method[8];       /* "GET", "POST", etc.             */
+    char     uri[128];        /* Request URI (path + query)      */
+    char    *body;            /* Body pointer (inside rx buffer)  */
+    uint32_t body_len;        /* Content-Length / actual body len */
+    struct tcp_conn *conn;    /* Underlying TCP connection        */
+    int32_t  slot;            /* Internal: connection slot index  */
+};
+
+/* ---- Query parameter parsing ---- */
+
+struct http_param {
+    const char *key;
+    const char *value;
+};
+
+#define HTTP_MAX_PARAMS  16
+
+/**
+ * Parse query string parameters from a URI.
+ * Modifies the uri in-place (inserts NULs).
+ * @param uri        URI string (will be modified; query part split)
+ * @param params     Output array
+ * @param max_params Max entries in params
+ * @return Number of params found
+ */
+int32_t http_parse_query(char *uri, struct http_param *params, int32_t max_params);
+
+/* ---- Handler callback ---- */
+
+typedef void (*http_handler_t)(struct http_request *req);
+
+/* ---- Server API ---- */
+
+/** Start HTTP server listening on @p port */
+void http_server_start(uint16_t port);
+
+/** Stop HTTP server, close all connections */
+void http_server_stop(void);
+
+/** Set the request handler callback */
+void http_server_set_handler(http_handler_t handler);
+
+/** Register a large body buffer for POST requests exceeding 2KB.
+ *  When a POST body is too large for the per-connection buffer, the
+ *  server redirects body accumulation into this external buffer.
+ *  Only one large-body upload can be active at a time.
+ *  @param buf      Buffer pointer (should be in ExtRAM)
+ *  @param bufsize  Buffer capacity in bytes
+ */
+void http_server_set_large_body(uint8_t *buf, uint32_t bufsize);
+
+/* ---- Response helpers ---- */
+
+/** Send a full HTTP/1.0 response and close the connection */
+void http_respond(struct http_request *req, int32_t status_code,
+                  const char *content_type, const char *body, uint32_t body_len);
+
+/** Convenience: respond with text/html */
+void http_respond_html(struct http_request *req, int32_t status_code, const char *html);
+
+/** Convenience: respond with application/json */
+void http_respond_json(struct http_request *req, int32_t status_code, const char *json);
+
+/* ---- URL decoding ---- */
+
+/** Decode URL-encoded string in-place. '+' → space, %XX → char. */
+void http_url_decode(char *str);
+
+#endif /* HTTP_SERVER_H */
diff --git a/inc/app/net/net_arp.h b/inc/app/net/net_arp.h
new file mode 100644
index 0000000..325772e
--- /dev/null
+++ b/inc/app/net/net_arp.h
@@ -0,0 +1,63 @@
+/**
+ * @file net_arp.h
+ * @brief ARP — Address Resolution Protocol (RFC 826)
+ *
+ * Maintains a cache of IP→MAC mappings and handles asynchronous resolution
+ * with a pending-request queue.  All buffers are statically allocated.
+ */
+#ifndef NET_ARP_H
+#define NET_ARP_H
+
+#include <stdint.h>
+
+/* ---- ARP cache ---- */
+
+#define ARP_CACHE_SIZE      8   /**< Maximum cached entries */
+#define ARP_PENDING_SIZE    4   /**< Maximum outstanding requests */
+#define ARP_TIMEOUT_S       10  /**< Seconds before a pending request expires */
+#define ARP_RETRY_INTERVAL  1   /**< Seconds between retransmits */
+
+/** Callback invoked when an ARP resolution completes.
+ *  @param mac  Resolved MAC address (6 bytes), or NULL on timeout.
+ *  @param ctx  User context pointer passed to arp_resolve().
+ */
+typedef void (*arp_callback_t)(const uint8_t *mac, void *ctx);
+
+/** ARP cache entry. */
+struct arp_entry {
+    uint8_t  ip[4];
+    uint8_t  mac[6];
+    uint32_t timestamp;     /**< net_time_s() when entry was created/refreshed */
+    int32_t  valid;         /**< 1 = in use, 0 = free */
+};
+
+/** Pending ARP request. */
+struct arp_pending {
+    uint8_t        ip[4];
+    arp_callback_t callback;
+    void          *ctx;
+    uint32_t       timestamp;   /**< net_time_s() when first sent */
+    uint32_t       last_sent;   /**< net_time_s() when last retransmit */
+    int32_t        retries;
+    int32_t        active;      /**< 1 = in use */
+};
+
+/* ---- Public API ---- */
+
+/** Handle an incoming ARP frame (called from net_rx). */
+void arp_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac);
+
+/** Resolve an IP address to a MAC address.
+ *  If the result is already cached the callback fires immediately.
+ *  Otherwise an ARP request is sent and the callback is queued.
+ *  For off-subnet IPs the gateway is resolved instead.
+ */
+void arp_resolve(const uint8_t *ip, arp_callback_t callback, void *ctx);
+
+/** Periodic timer — retransmit pending requests, expire stale ones. */
+void arp_timer(void);
+
+/** Reset the ARP subsystem (clear cache and pending queue). */
+void arp_reset(void);
+
+#endif /* NET_ARP_H */
diff --git a/inc/app/net/net_core.h b/inc/app/net/net_core.h
new file mode 100644
index 0000000..61b0718
--- /dev/null
+++ b/inc/app/net/net_core.h
@@ -0,0 +1,110 @@
+/**
+ * @file net_core.h
+ * @brief Network core — packet dispatch, IP utilities, shared state
+ *
+ * All packets use LLC/SNAP encapsulation (8-byte header).
+ * The 802.11 driver delivers frames starting at the LLC header.
+ */
+#ifndef NET_CORE_H
+#define NET_CORE_H
+
+#include <stdint.h>
+
+/* ---- LLC/SNAP header (8 bytes) ---- */
+
+#define LLC_SNAP_LEN       8
+#define LLC_SNAP_ARP       "\xaa\xaa\x03\x00\x00\x00\x08\x06"
+#define LLC_SNAP_IP        "\xaa\xaa\x03\x00\x00\x00\x08\x00"
+
+/* Offsets within LLC/SNAP+IP packet */
+#define LLC_ETHERTYPE_HI   6
+#define LLC_ETHERTYPE_LO   7
+
+/* ---- Network state (global) ---- */
+
+extern uint8_t net_ip[4];        /* Our current IP */
+extern uint8_t net_mask[4];      /* Subnet mask */
+extern uint8_t net_gateway[4];   /* Gateway IP */
+extern uint8_t net_dns_server[4]; /* DNS server IP */
+extern uint8_t net_mac[6];       /* Our MAC (from RT2501) */
+
+extern const uint8_t net_ip_zero[4];
+extern const uint8_t net_mac_broadcast[6];
+extern const uint8_t net_ip_broadcast[4];
+
+/* Master-mode defaults */
+#define NET_MASTER_IP       "\xc0\xa8\x00\x01"  /* 192.168.0.1 */
+#define NET_MASTER_MASK     "\xff\xff\xff\x00"  /* 255.255.255.0 */
+
+/* ---- Packet send ---- */
+
+/** Send raw LLC/SNAP frame via RT2501.
+ *  @param data    Frame data (starting at LLC header)
+ *  @param len     Total frame length
+ *  @param dst_mac Destination MAC (6 bytes)
+ *  @param lowrate Use low (1Mbps) rate
+ *  @return 0 on success
+ */
+int32_t net_send(const uint8_t *data, uint32_t len,
+                 const uint8_t *dst_mac, int32_t lowrate);
+
+/* ---- IP checksum ---- */
+
+/** Compute IP/TCP/UDP checksum over a range.
+ *  @param data  Buffer
+ *  @param len   Length in bytes
+ *  @param init  Initial accumulator (0 for fresh, or pseudo-header sum)
+ *  @return Checksum in network byte order (ready to write)
+ */
+uint16_t net_checksum(const uint8_t *data, uint32_t len, uint32_t init);
+
+/** Write 16-bit big-endian value at offset in buffer */
+static inline void net_put16(uint8_t *buf, int32_t off, uint16_t val) {
+    buf[off]     = (val >> 8) & 0xFF;
+    buf[off + 1] = val & 0xFF;
+}
+
+/** Read 16-bit big-endian value from offset in buffer */
+static inline uint16_t net_get16(const uint8_t *buf, int32_t off) {
+    return ((uint16_t)buf[off] << 8) | buf[off + 1];
+}
+
+/** Write 32-bit big-endian value */
+static inline void net_put32(uint8_t *buf, int32_t off, uint32_t val) {
+    buf[off]     = (val >> 24) & 0xFF;
+    buf[off + 1] = (val >> 16) & 0xFF;
+    buf[off + 2] = (val >> 8) & 0xFF;
+    buf[off + 3] = val & 0xFF;
+}
+
+/** Read 32-bit big-endian value */
+static inline uint32_t net_get32(const uint8_t *buf, int32_t off) {
+    return ((uint32_t)buf[off] << 24) | ((uint32_t)buf[off+1] << 16) |
+           ((uint32_t)buf[off+2] << 8) | buf[off+3];
+}
+
+/** Check if IP is on our subnet */
+int32_t net_is_local(const uint8_t *ip);
+
+/* ---- Packet receive callback (called from main loop) ---- */
+
+/** Process a received frame. Called from main.c for each rt2501_receive(). */
+void net_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac);
+
+/* ---- Init / timer ---- */
+
+/** Initialize network subsystem (reset ARP, TCP, UDP, etc.) */
+void net_init(void);
+
+/** Periodic network timer — call every ~1 second */
+void net_timer(void);
+
+/* ---- Time helpers (from vlog.c, kept standalone) ---- */
+
+extern volatile uint32_t counter_timer;    /* ms counter (from timer ISR) */
+extern volatile uint32_t counter_timer_s;  /* seconds counter */
+
+static inline uint32_t net_time_ms(void) { return counter_timer; }
+static inline uint32_t net_time_s(void)  { return counter_timer_s; }
+
+#endif /* NET_CORE_H */
diff --git a/inc/app/net/net_dhcp.h b/inc/app/net/net_dhcp.h
new file mode 100644
index 0000000..3b7bbc4
--- /dev/null
+++ b/inc/app/net/net_dhcp.h
@@ -0,0 +1,54 @@
+/**
+ * @file net_dhcp.h
+ * @brief DHCP client and server (RFC 2131)
+ *
+ * The client runs the standard DISCOVER → OFFER → REQUEST → ACK cycle and
+ * configures net_ip / net_mask / net_gateway / net_dns on success.
+ *
+ * The server hands out addresses derived from the client's MAC:
+ *   assigned_ip = (base_ip & mask) | ((client_mac[5] & 0x7f) + 100)
+ */
+#ifndef NET_DHCP_H
+#define NET_DHCP_H
+
+#include <stdint.h>
+
+/* DHCP message types (option 53) */
+#define DHCP_DISCOVER   1
+#define DHCP_OFFER      2
+#define DHCP_REQUEST    3
+#define DHCP_DECLINE    4
+#define DHCP_ACK        5
+#define DHCP_NAK        6
+#define DHCP_RELEASE    7
+
+/* DHCP ports */
+#define DHCP_SERVER_PORT    67
+#define DHCP_CLIENT_PORT    68
+
+/* DHCP option codes */
+#define DHCP_OPT_SUBNET     1
+#define DHCP_OPT_ROUTER     3
+#define DHCP_OPT_DNS        6
+#define DHCP_OPT_HOSTNAME   12
+#define DHCP_OPT_LEASE      51
+#define DHCP_OPT_MSGTYPE    53
+#define DHCP_OPT_REQLIST    55
+#define DHCP_OPT_CLIENTID   61
+#define DHCP_OPT_END        255
+
+/* Lease time offered by our server (seconds) */
+#define DHCP_LEASE_TIME     86400   /* 24 hours */
+
+/* ---- Public API ---- */
+
+/** Start the DHCP client — sends DISCOVER and listens on port 68. */
+void dhcp_client_start(void);
+
+/** Start the DHCP server — listens on port 67 (master mode). */
+void dhcp_server_start(void);
+
+/** Stop both client and server, unbind UDP ports. */
+void dhcp_stop(void);
+
+#endif /* NET_DHCP_H */
diff --git a/inc/app/net/net_dns.h b/inc/app/net/net_dns.h
new file mode 100644
index 0000000..3612e02
--- /dev/null
+++ b/inc/app/net/net_dns.h
@@ -0,0 +1,52 @@
+/**
+ * @file net_dns.h
+ * @brief DNS client — domain name resolution (A records only)
+ *
+ * Maintains a small cache and a queue of pending requests.
+ * Queries are sent over UDP to net_dns:53 from local port 999.
+ */
+#ifndef NET_DNS_H
+#define NET_DNS_H
+
+#include <stdint.h>
+
+#define DNS_CACHE_SIZE      8
+#define DNS_PENDING_SIZE    4
+#define DNS_MAX_DOMAIN      64  /**< Max domain name length (including NUL) */
+#define DNS_TIMEOUT_S       5   /**< Total timeout per request */
+#define DNS_RETRY_S         1   /**< Seconds between retransmits */
+#define DNS_LOCAL_PORT      999 /**< Source port for queries */
+#define DNS_SERVER_PORT     53
+
+/**
+ * Callback invoked when DNS resolution completes.
+ *
+ * @param ip   Resolved IP (4 bytes), or NULL on failure/timeout.
+ * @param ctx  User context pointer.
+ */
+typedef void (*dns_callback_t)(const uint8_t *ip, void *ctx);
+
+/* ---- Public API ---- */
+
+/**
+ * Resolve a domain name to an IPv4 address.
+ *
+ * The cache is checked first.  On a miss a UDP query is sent to net_dns.
+ * The callback fires asynchronously (or synchronously if cached).
+ */
+void dns_resolve(const char *domain, dns_callback_t callback, void *ctx);
+
+/**
+ * Handle incoming DNS response (called from udp_rx on port 999).
+ */
+void dns_rx(const uint8_t *data, uint32_t len,
+            const uint8_t *src_ip, uint16_t src_port,
+            const uint8_t *src_mac);
+
+/** Periodic timer — retransmit queries, expire timed-out requests. */
+void dns_timer(void);
+
+/** Reset cache and pending queue. */
+void dns_reset(void);
+
+#endif /* NET_DNS_H */
diff --git a/inc/app/net/net_ip.h b/inc/app/net/net_ip.h
new file mode 100644
index 0000000..2fc7b61
--- /dev/null
+++ b/inc/app/net/net_ip.h
@@ -0,0 +1,55 @@
+/**
+ * @file net_ip.h
+ * @brief IPv4 layer — header construction, parsing, dispatch
+ *
+ * Works with LLC/SNAP-encapsulated frames (8-byte LLC header + 20-byte IP
+ * header = 28 bytes of overhead before the transport payload).
+ */
+#ifndef NET_IP_H
+#define NET_IP_H
+
+#include <stdint.h>
+
+/* IP header length (no options) */
+#define IP_HEADER_LEN   20
+
+/* Offset of IP header within an LLC/SNAP frame */
+#define IP_OFFSET       8   /* == LLC_SNAP_LEN */
+
+/* Protocol numbers */
+#define IP_PROTO_ICMP   1
+#define IP_PROTO_TCP    6
+#define IP_PROTO_UDP    17
+
+/* ---- Public API ---- */
+
+/**
+ * Build LLC/SNAP + IP header in @p buf.
+ *
+ * Fills in everything except the IP header checksum (call ip_finalize()
+ * after the payload has been written).  The identification field is
+ * auto-incremented.
+ *
+ * @param buf         Output buffer (must hold at least 28 + payload_len bytes)
+ * @param src_ip      Source IP (4 bytes)
+ * @param dst_ip      Destination IP (4 bytes)
+ * @param protocol    IP protocol number (TCP=6, UDP=17, …)
+ * @param payload_len Length of the transport payload (excluding IP header)
+ * @return Total header length (always 28 = 8 LLC + 20 IP)
+ */
+uint32_t ip_build(uint8_t *buf, const uint8_t *src_ip, const uint8_t *dst_ip,
+                  uint8_t protocol, uint16_t payload_len);
+
+/**
+ * Compute and write the IP header checksum for a frame built by ip_build().
+ * The checksum field (bytes 18–19, i.e. IP offset 10–11) is filled in.
+ */
+void ip_finalize(uint8_t *buf);
+
+/**
+ * Process an incoming IP packet (called from net_rx).
+ * Validates header, then dispatches by protocol (TCP/UDP).
+ */
+void ip_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac);
+
+#endif /* NET_IP_H */
diff --git a/inc/app/net/net_tcp.h b/inc/app/net/net_tcp.h
new file mode 100644
index 0000000..c403049
--- /dev/null
+++ b/inc/app/net/net_tcp.h
@@ -0,0 +1,137 @@
+/**
+ * @file net_tcp.h
+ * @brief TCP — Transmission Control Protocol (simplified, RFC 793 subset)
+ *
+ * Supports up to NET_TCP_MAX_CONN simultaneous connections.  The
+ * implementation is event-driven: a per-connection callback receives
+ * CONNECTED / DATA / WRITABLE / CLOSED events.
+ *
+ * Limitations vs. full TCP:
+ *   - Fixed window (2048), no sliding window or congestion control
+ *   - One unacknowledged segment at a time (stop-and-wait)
+ *   - No out-of-order reassembly
+ *   - No urgent data
+ */
+#ifndef NET_TCP_H
+#define NET_TCP_H
+
+#include <stdint.h>
+
+/* ---- Constants ---- */
+
+#define NET_TCP_MAX_CONN    6
+#define TCP_MSS             1024
+#define TCP_WINDOW          2048
+#define TCP_MAX_RETRIES     10
+#define TCP_RETRANSMIT_S    2       /**< Seconds between retransmissions */
+
+/* TCP connection states */
+#define TCP_STATE_CLOSED    (-1)
+#define TCP_STATE_SYN_SENT  0
+#define TCP_STATE_ESTABLISHED 1
+#define TCP_STATE_LISTEN    2
+#define TCP_STATE_FIN_WAIT  3
+
+/* TCP events delivered to callback */
+#define TCP_CONNECTED       1
+#define TCP_DATA            2
+#define TCP_WRITABLE        3
+#define TCP_CLOSED          4
+
+/* TCP flags */
+#define TCP_FLAG_FIN        0x01
+#define TCP_FLAG_SYN        0x02
+#define TCP_FLAG_RST        0x04
+#define TCP_FLAG_PSH        0x08
+#define TCP_FLAG_ACK        0x10
+
+/* Size of the retransmit buffer (LLC+IP+TCP headers + MSS) */
+#define TCP_RETRANSMIT_BUF  (8 + 20 + 20 + TCP_MSS + 4)
+
+/* ---- Types ---- */
+
+struct tcp_conn;
+
+/**
+ * Per-connection event callback.
+ *
+ * @param conn   The connection that generated the event
+ * @param event  One of TCP_CONNECTED, TCP_DATA, TCP_WRITABLE, TCP_CLOSED
+ * @param data   Payload pointer (only valid for TCP_DATA), else NULL
+ * @param len    Payload length  (only valid for TCP_DATA), else 0
+ */
+typedef void (*tcp_callback_t)(struct tcp_conn *conn, int32_t event,
+                               const uint8_t *data, uint32_t len);
+
+/**
+ * TCP connection control block.
+ *
+ * All fields are internal — application code should only read state,
+ * dst_ip, dst_port, local_port, and the user-data pointer.
+ */
+struct tcp_conn {
+    int32_t         state;
+    uint8_t         dst_ip[4];
+    uint8_t         local_ip[4];
+    uint16_t        dst_port;
+    uint16_t        local_port;
+    uint32_t        seq;            /**< Our next sequence number */
+    uint32_t        ack;            /**< Next expected remote seq */
+    uint8_t         mac[6];         /**< Remote MAC */
+    tcp_callback_t  callback;
+    uint8_t         last_sent[TCP_RETRANSMIT_BUF]; /**< Copy for retransmit */
+    uint32_t        last_sent_len;  /**< Length of buffered segment */
+    uint32_t        last_sent_time; /**< net_time_s() of last (re)transmit */
+    int32_t         retry_count;
+    int32_t         lock_send;      /**< 1 = waiting for ACK before next write */
+    int32_t         enabled;        /**< 1 = slot in use */
+    int32_t         close_pending;  /**< 1 = close after ACK received */
+};
+
+/* ---- Public API ---- */
+
+/**
+ * Open an outbound TCP connection.
+ *
+ * If @p local_port is 0 an ephemeral port is assigned automatically.
+ * Returns a connection pointer on success, NULL if no slot available.
+ */
+struct tcp_conn *tcp_connect(const uint8_t *dst_ip, uint16_t dst_port,
+                             uint16_t local_port, tcp_callback_t callback);
+
+/**
+ * Create a listening (passive-open) socket.
+ * Returns a connection pointer, or NULL if no slot available.
+ */
+struct tcp_conn *tcp_listen(uint16_t local_port, tcp_callback_t callback);
+
+/**
+ * Send data on an established connection.
+ *
+ * At most TCP_MSS bytes are sent per call.  If the previous segment has
+ * not yet been acknowledged the send is queued (lock_send is set and
+ * TCP_WRITABLE will fire later).
+ *
+ * @return Number of bytes accepted (may be 0 if locked), or -1 on error.
+ */
+int32_t tcp_write(struct tcp_conn *conn, const uint8_t *data, uint32_t len);
+
+/**
+ * Close a connection.  If there is unacknowledged data the FIN is
+ * deferred until the ACK arrives.
+ */
+void tcp_close(struct tcp_conn *conn);
+
+/**
+ * Process an incoming TCP segment (called from ip_rx).
+ * @p data starts at LLC/SNAP header.
+ */
+void tcp_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac);
+
+/** Periodic timer — retransmit unacked segments, close timed-out conns. */
+void tcp_timer(void);
+
+/** Force-close all connections and reset state. */
+void tcp_reset(void);
+
+#endif /* NET_TCP_H */
diff --git a/inc/app/net/net_udp.h b/inc/app/net/net_udp.h
new file mode 100644
index 0000000..c79e69c
--- /dev/null
+++ b/inc/app/net/net_udp.h
@@ -0,0 +1,58 @@
+/**
+ * @file net_udp.h
+ * @brief UDP — User Datagram Protocol (RFC 768)
+ *
+ * Provides a simple bind/unbind listener model and a one-shot send function.
+ * Up to NET_UDP_MAX_LISTENERS ports can be bound simultaneously.
+ */
+#ifndef NET_UDP_H
+#define NET_UDP_H
+
+#include <stdint.h>
+
+#define NET_UDP_MAX_LISTENERS   4
+
+/**
+ * Callback invoked when a UDP datagram arrives on a bound port.
+ *
+ * @param data      Payload (past the UDP header)
+ * @param len       Payload length
+ * @param src_ip    Sender IP (4 bytes, network order)
+ * @param src_port  Sender port (host order)
+ * @param src_mac   Sender MAC (6 bytes)
+ */
+typedef void (*udp_callback_t)(const uint8_t *data, uint32_t len,
+                               const uint8_t *src_ip, uint16_t src_port,
+                               const uint8_t *src_mac);
+
+/** Bind a UDP port to a callback. Returns 0 on success, -1 if full. */
+int32_t udp_bind(uint16_t port, udp_callback_t callback);
+
+/** Remove the listener for @p port. */
+void udp_unbind(uint16_t port);
+
+/**
+ * Send a UDP datagram.
+ *
+ * If @p dst_mac is NULL the packet is queued for ARP resolution first.
+ *
+ * @param dst_ip    Destination IP (4 bytes)
+ * @param dst_port  Destination port
+ * @param src_port  Source port
+ * @param data      Payload
+ * @param len       Payload length
+ * @param dst_mac   Destination MAC (6 bytes), or NULL for ARP lookup
+ */
+void udp_send(const uint8_t *dst_ip, uint16_t dst_port, uint16_t src_port,
+              const uint8_t *data, uint32_t len, const uint8_t *dst_mac);
+
+/**
+ * Process an incoming UDP datagram (called from ip_rx).
+ * The @p data pointer starts at the LLC/SNAP header.
+ */
+void udp_rx(const uint8_t *data, uint32_t len, const uint8_t *src_mac);
+
+/** Reset all UDP listeners. */
+void udp_reset(void);
+
+#endif /* NET_UDP_H */
