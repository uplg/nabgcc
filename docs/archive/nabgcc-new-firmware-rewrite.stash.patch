+
+extern const char page_done[];
+extern const char page_firmware[];
+extern const char page_error[];
+extern const char page_debug[];
+
+/* ---- Index page with template substitution ---- */
+
+/**
+ * Render the main config page into buf, performing template substitution
+ * for {{SSID}}, {{IP}}, {{MASK}}, {{GW}}, {{DNS}}, {{SERVER}}, {{MAC}},
+ * {{VER}}, {{DHCP}}, {{CRYPT}}, {{PROXY}}.
+ *
+ * @param buf      Output buffer
+ * @param bufsize  Size of output buffer
